    }
    if str_eq(cmd, "ZEXPIRE") or str_eq(cmd, "ZPEXPIRE") or str_eq(cmd, "ZEXPIREAT") or str_eq(cmd, "ZPEXPIREAT") or str_eq(cmd, "ZTTL") or str_eq(cmd, "ZPTTL") or str_eq(cmd, "ZPERSIST") {
        return 1
    }
    if str_eq(cmd, "CAS") or str_eq(cmd, "CAD") or str_eq(cmd, "DELEX") or str_eq(cmd, "RATELIMIT") or str_eq(cmd, "CL.THROTTLE") or str_eq(cmd, "LOCK") {
        return 1
    }
    if str_eq(cmd, "BF.RESERVE") or str_eq(cmd, "BF.ADD") or str_eq(cmd, "BF.MADD") or str_eq(cmd, "BF.EXISTS") or str_eq(cmd, "BF.MEXISTS") or str_eq(cmd, "BF.CARD") or str_eq(cmd, "BF.INFO") {
