    if str_eq(cmd, "CMS.INITBYDIM") or str_eq(cmd, "CMS.INITBYPROB") or str_eq(cmd, "CMS.INCRBY") or str_eq(cmd, "CMS.QUERY") or str_eq(cmd, "CMS.INFO") {
        return 1
    }
    if str_eq(cmd, "TOPK.RESERVE") or str_eq(cmd, "TOPK.ADD") or str_eq(cmd, "TOPK.INCRBY") or str_eq(cmd, "TOPK.QUERY") or str_eq(cmd, "TOPK.COUNT") or str_eq(cmd, "TOPK.LIST") or str_eq(cmd, "TOPK.INFO") {
        return 1
    }
    if str_eq(cmd, "QUEUE.PUSH") or str_eq(cmd, "QUEUE.POP") or str_eq(cmd, "QUEUE.ACK") or str_eq(cmd, "QUEUE.NACK") or str_eq(cmd, "QUEUE.DLQ") or str_eq(cmd, "QUEUE.STATS") {
        return 1
    }
    if str_eq(cmd, "JSON.SET") or str_eq(cmd, "JSON.GET") or str_eq(cmd, "JSON.MGET") or str_eq(cmd, "JSON.DEL") or str_eq(cmd, "JSON.FORGET") or str_eq(cmd, "JSON.TYPE") or str_eq(cmd, "JSON.NUMINCRBY") or str_eq(cmd, "JSON.STRAPPEND") or str_eq(cmd, "JSON.STRLEN") or str_eq(cmd, "JSON.ARRAPPEND") or str_eq(cmd, "JSON.ARRLEN") or str_eq(cmd, "JSON.OBJKEYS") or str_eq(cmd, "JSON.OBJLEN") {
