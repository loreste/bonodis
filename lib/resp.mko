}

fn is_hot_key_cmd(cmd: string) -> int {
    if str_eq(cmd, "GET") or str_eq(cmd, "SET") or str_eq(cmd, "DEL") or str_eq(cmd, "INCR") {
        return 1
    }
    if str_eq(cmd, "EXISTS") or str_eq(cmd, "HGET") or str_eq(cmd, "HSET") or str_eq(cmd, "MGET") {
        return 1
    }
    if str_eq(cmd, "MSET") or str_eq(cmd, "LPUSH") or str_eq(cmd, "RPUSH") or str_eq(cmd, "SADD") or str_eq(cmd, "ZADD") {
        return 1
    }
    return 0
}

fn is_write_cmd(cmd: string) -> int {
    if str_eq(cmd, "SET") or str_eq(cmd, "SETNX") or str_eq(cmd, "SETEX") or str_eq(cmd, "PSETEX") {
        return 1
    }
    if str_eq(cmd, "GETSET") or str_eq(cmd, "APPEND") or str_eq(cmd, "INCR") or str_eq(cmd, "INCRBY") {
        return 1
    }
    if str_eq(cmd, "DECR") or str_eq(cmd, "DECRBY") or str_eq(cmd, "MSET") or str_eq(cmd, "MSETNX") {
        return 1
    }
    if str_eq(cmd, "DEL") or str_eq(cmd, "UNLINK") or str_eq(cmd, "EXPIRE") or str_eq(cmd, "PEXPIRE") {
        return 1
    }
    if str_eq(cmd, "EXPIREAT") or str_eq(cmd, "PEXPIREAT") or str_eq(cmd, "PERSIST") or str_eq(cmd, "RENAME") {
        return 1
    }
    if str_eq(cmd, "RENAMENX") or str_eq(cmd, "FLUSHDB") or str_eq(cmd, "FLUSHALL") {
        return 1
    }
    if str_eq(cmd, "HSET") or str_eq(cmd, "HMSET") or str_eq(cmd, "HDEL") or str_eq(cmd, "HINCRBY") {
        return 1
    }
    if str_eq(cmd, "LPUSH") or str_eq(cmd, "RPUSH") or str_eq(cmd, "LPOP") or str_eq(cmd, "RPOP") {
        return 1
    }
    if str_eq(cmd, "LSET") or str_eq(cmd, "LTRIM") {
        return 1
    }
    if str_eq(cmd, "SADD") or str_eq(cmd, "SREM") or str_eq(cmd, "SPOP") {
        return 1
    }
    if str_eq(cmd, "SUNIONSTORE") or str_eq(cmd, "SINTERSTORE") or str_eq(cmd, "SDIFFSTORE") {
        return 1
    }
    if str_eq(cmd, "ZADD") or str_eq(cmd, "ZREM") or str_eq(cmd, "ZINCRBY") or str_eq(cmd, "ZPOPMIN") or str_eq(cmd, "ZPOPMAX") {
        return 1
    }
    if str_eq(cmd, "SETBIT") or str_eq(cmd, "GEOADD") or str_eq(cmd, "XADD") {
        return 1
    }
    if str_eq(cmd, "GETDEL") or str_eq(cmd, "GETEX") or str_eq(cmd, "COPY") or str_eq(cmd, "SORT") or str_eq(cmd, "PFADD") or str_eq(cmd, "PFMERGE") {
        return 1
    }
    if str_eq(cmd, "SETRANGE") or str_eq(cmd, "INCRBYFLOAT") or str_eq(cmd, "LREM") or str_eq(cmd, "LINSERT") or str_eq(cmd, "LMOVE") or str_eq(cmd, "SMOVE") or str_eq(cmd, "BITOP") or str_eq(cmd, "ZUNIONSTORE") {
        return 1
    }
    if str_eq(cmd, "RPOPLPUSH") or str_eq(cmd, "MOVE") or str_eq(cmd, "ZREMRANGEBYSCORE") or str_eq(cmd, "XDEL") or str_eq(cmd, "XTRIM") {
        return 1
    }
    if str_eq(cmd, "VADD") or str_eq(cmd, "VREM") or str_eq(cmd, "VATTR") or str_eq(cmd, "BRAIN") {
        return 1
    }
    if str_eq(cmd, "RESTORE") or str_eq(cmd, "HINCRBYFLOAT") or str_eq(cmd, "HSETNX") or str_eq(cmd, "LPUSHX") or str_eq(cmd, "RPUSHX") {
        return 1
    }
    if str_eq(cmd, "ZINTERSTORE") or str_eq(cmd, "ZDIFFSTORE") or str_eq(cmd, "ZREMRANGEBYRANK") or str_eq(cmd, "SWAPDB") {
        return 1
    }
    if str_eq(cmd, "XGROUP") or str_eq(cmd, "XREADGROUP") or str_eq(cmd, "XACK") or str_eq(cmd, "BITFIELD") {
        return 1
    }
    if str_eq(cmd, "XCLAIM") or str_eq(cmd, "XAUTOCLAIM") {
        return 1
    }
    if str_eq(cmd, "EVAL") or str_eq(cmd, "EVALSHA") {
        return 1
    }
    if str_eq(cmd, "RELATE") or str_eq(cmd, "UNRELATE") or str_eq(cmd, "FACT") or str_eq(cmd, "LEASE") or str_eq(cmd, "UNLEASE") {
        return 1
    }
    if str_eq(cmd, "BELIEVE") or str_eq(cmd, "ATTEND") or str_eq(cmd, "BUDGET") or str_eq(cmd, "SPEND") {
        return 1
    }
    if str_eq(cmd, "LMPOP") or str_eq(cmd, "ZMPOP") or str_eq(cmd, "HGETDEL") or str_eq(cmd, "GEOSEARCHSTORE") {
        return 1
    }
    if str_eq(cmd, "BLPOP") or str_eq(cmd, "BRPOP") or str_eq(cmd, "BZPOPMIN") or str_eq(cmd, "BZPOPMAX") {
        return 1
    }
    if str_eq(cmd, "TOUCH") or str_eq(cmd, "PUBLISH") {
        return 1
    }
    if str_eq(cmd, "REACT") {
        return 1
    }
    return 0
}
