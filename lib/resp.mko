}

#[no_alloc]
fn line_end_cr(s: string, p0: int, nl: int) -> int {
    if nl > p0 and str_byte_at(s, nl - 1) == 13 {
        return nl - 1
    }
    return nl
}

fn parse_int_span(s: string, p0: int, p1: int) -> (int, int) {
    if p0 >= p1 {
        return (0, 0)
    }
    let mut i = p0
    let mut neg = 0
    if str_byte_at(s, i) == 45 {
        neg = 1
        i = i + 1
        if i >= p1 {
            return (0, 0)
        }
    }
    let mut acc = 0
    while i < p1 {
        let c = str_byte_at(s, i)
        if c < 48 or c > 57 {
            return (0, 0)
        }
        acc = acc * 10 + (c - 48)
        i = i + 1
    }
    if neg == 1 {
        return (0 - acc, 1)
    }
    return (acc, 1)
}

fn resp_frame_end(s: string, pos: int) -> int {
    let n = str_len(s)
    if pos >= n {
        return n
    }
    let b0 = str_byte_at(s, pos)
    let nl = find_nl(s, pos + 1)
    if nl < 0 {
        return n
    }
    if b0 == 43 or b0 == 45 or b0 == 58 {
        return nl + 1
    }
    let le = line_end_cr(s, pos + 1, nl)
    let cnt, ok = parse_int_span(s, pos + 1, le)
    if b0 == 36 {
        if ok == 0 or cnt < 0 {
            return nl + 1
        }
        let end = nl + 1 + cnt + 2
        if end > n {
            return n
        }
        return end
    }
    if b0 == 42 {
        if ok == 0 or cnt <= 0 {
            return nl + 1
        }
        let mut cur = nl + 1
        let mut i = 0
        while i < cnt and cur < n {
            cur = resp_frame_end(s, cur)
            i = i + 1
        }
        return cur
    }
    return nl + 1
}
