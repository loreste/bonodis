    if str_eq(cmd, "TS.CREATE") or str_eq(cmd, "TS.ADD") or str_eq(cmd, "TS.MADD") or str_eq(cmd, "TS.INCRBY") or str_eq(cmd, "TS.DECRBY") or str_eq(cmd, "TS.GET") or str_eq(cmd, "TS.RANGE") or str_eq(cmd, "TS.REVRANGE") or str_eq(cmd, "TS.INFO") {
