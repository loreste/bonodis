pack bonodis

// RESP2 codec. Commands are arrays of bulk strings (or the inline telnet form).

fn int_of(s: string) -> int {
    if let Ok(n) = parse_int(s) {
        return n
    }
    return 0
}

fn int_ok(s: string) -> (int, int) {
    if let Ok(n) = parse_int(s) {
        return (n, 1)
    }
    return (0, 0)
}

#[no_alloc]
fn find_crlf(buf: string, pos: int) -> int {
    let n = str_len(buf)
    if pos < 0 or pos >= n {
        return -1
    }
    return str_slice_index(buf, pos, n - pos, "\r\n")
}

#[no_alloc]
fn find_nl(s: string, pos: int) -> int {
    let n = str_len(s)
    if pos < 0 or pos >= n {
        return -1
    }
    return str_slice_index(s, pos, n - pos, "\n")
}

fn r_ok() -> string {
    return "+OK\r\n"
}

fn r_pong() -> string {
    return "+PONG\r\n"
}

fn r_queued() -> string {
    return "+QUEUED\r\n"
}

fn r_nil() -> string {
    return "$-1\r\n"
}

fn r_null_arr() -> string {
    return "*-1\r\n"
}

fn r_simple(s: string) -> string {
    return "+" + s + "\r\n"
}

fn r_err(msg: string) -> string {
    return "-" + msg + "\r\n"
}

// Strip CR/LF from client-supplied text before it is interpolated into a
// single-line RESP reply. A bulk containing "\r\n" would otherwise desync
// the reply stream (response splitting) and forge log lines.
fn resp_safe(s: string) -> string {
    if not str_contains(s, "\r") and not str_contains(s, "\n") {
        return s
    }
    let b = str_builder()
    let mut i = 0
    while i < str_len(s) {
        let c = str_byte_at(s, i)
        if c == 13 or c == 10 {
            builder_write(b, "?")
        } else {
            builder_write_byte(b, byte(c))
        }
        i = i + 1
    }
    return builder_string(b)
}

fn r_wrongtype() -> string {
    return "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n"
}

fn r_arity(cmd: string) -> string {
    return "-ERR wrong number of arguments for '" + resp_safe(cmd) + "' command\r\n"
}

fn r_syntax() -> string {
    return "-ERR syntax error\r\n"
}

fn r_notint() -> string {
    return "-ERR value is not an integer or out of range\r\n"
}

fn r_nokey() -> string {
    return "-ERR no such key\r\n"
}

fn r_unknown(cmd: string) -> string {
    return "-ERR unknown command '" + resp_safe(cmd) + "'\r\n"
}

#[no_alloc]
fn small_int_str(n: int) -> string {
    if n == 0 {
        return "0"
    }
    if n == 1 {
        return "1"
    }
    if n == 2 {
        return "2"
    }
    if n == 3 {
        return "3"
    }
    if n == 4 {
        return "4"
    }
    if n == 5 {
        return "5"
    }
    if n == 6 {
        return "6"
    }
    if n == 7 {
        return "7"
    }
    if n == 8 {
        return "8"
    }
    if n == 9 {
        return "9"
    }
    if n == 10 {
        return "10"
    }
    if n == 11 {
        return "11"
    }
    if n == 12 {
        return "12"
    }
    if n == 13 {
        return "13"
    }
    if n == 14 {
        return "14"
    }
    if n == 15 {
        return "15"
    }
    if n == 16 {
        return "16"
    }
    return ""
}

fn fmt_int_fast(n: int) -> string {
    if n >= 0 and n <= 16 {
        return small_int_str(n)
    }
    return format_int(n)
}

fn r_int(n: int) -> string {
    if n == 0 {
        return ":0\r\n"
    }
    if n == 1 {
        return ":1\r\n"
    }
    if n == 2 {
        return ":2\r\n"
    }
    if n == 3 {
        return ":3\r\n"
    }
    if n == 4 {
        return ":4\r\n"
    }
    if n == 0 - 1 {
        return ":-1\r\n"
    }
    if n == 0 - 2 {
        return ":-2\r\n"
    }
    let b = str_builder()
    builder_write(b, ":")
    builder_write(b, fmt_int_fast(n))
    builder_write(b, "\r\n")
    return builder_string(b)
}

fn r_bulk(s: string) -> string {
    let ln = str_len(s)
    if ln == 0 {
        return "$0\r\n\r\n"
    }
    let b = str_builder()
    builder_write(b, "$")
    builder_write(b, fmt_int_fast(ln))
    builder_write(b, "\r\n")
    builder_write(b, s)
    builder_write(b, "\r\n")
    return builder_string(b)
}

fn r_array_bulks(items: []string) -> string {
    let n = len(items)
    if n == 0 {
        return "*0\r\n"
    }
    let b = str_builder()
    builder_write(b, "*")
    builder_write(b, fmt_int_fast(n))
    builder_write(b, "\r\n")
    let mut i = 0
    while i < n {
        let s = items[i]
        let sl = str_len(s)
        if sl == 0 {
            builder_write(b, "$0\r\n\r\n")
        } else {
            builder_write(b, "$")
            builder_write(b, fmt_int_fast(sl))
            builder_write(b, "\r\n")
            builder_write(b, s)
            builder_write(b, "\r\n")
        }
        i = i + 1
    }
    return builder_string(b)
}

fn r_array_opt(items: []string, hit: []int) -> string {
    let n = len(items)
    if n == 0 {
        return "*0\r\n"
    }
    let b = str_builder()
    builder_write(b, "*")
    builder_write(b, fmt_int_fast(n))
    builder_write(b, "\r\n")
    let mut i = 0
    while i < n {
        if i < len(hit) and hit[i] == 0 {
            builder_write(b, "$-1\r\n")
        } else {
            let s = items[i]
            let sl = str_len(s)
            if sl == 0 {
                builder_write(b, "$0\r\n\r\n")
            } else {
                builder_write(b, "$")
                builder_write(b, fmt_int_fast(sl))
                builder_write(b, "\r\n")
                builder_write(b, s)
                builder_write(b, "\r\n")
            }
        }
        i = i + 1
    }
    return builder_string(b)
}

// Returns a []int with 1 for each null-bulk element in a RESP array.
fn resp_nil_mask(resp: string) -> []int {
    let none = make([]int, 0, 0)
    let n = str_len(resp)
    if n == 0 or str_byte_at(resp, 0) != 42 {
        return none
    }
    let cr = find_crlf(resp, 0)
    if cr < 2 {
        return none
    }
    let argc = int_of(resp[1:cr])
    let mut out = make([]int, 0, argc)
    let mut pos = cr + 2
    let mut i = 0
    while i < argc and pos < n {
        if str_byte_at(resp, pos) == 36 {
            let cr2 = find_crlf(resp, pos)
            if cr2 < 0 {
                break
            }
            let ln = int_of(resp[pos + 1:cr2])
            if ln < 0 {
                out = append(out, 1)
                pos = cr2 + 2
            } else {
                out = append(out, 0)
                pos = cr2 + 2 + ln + 2
            }
        } else {
            out = append(out, 0)
            let cr2 = find_crlf(resp, pos)
            if cr2 < 0 {
                break
            }
            pos = cr2 + 2
        }
        i = i + 1
    }
    return out
}

fn r_scan(cursor: string, keys: []string) -> string {
    let b = str_builder()
    builder_write(b, "*2\r\n")
    builder_write(b, r_bulk(cursor))
    builder_write(b, r_array_bulks(keys))
    return builder_string(b)
}

fn encode_array(argv: []string) -> string {
    return r_array_bulks(argv)
}

// Parse one command starting at offset in buf.
// Returns (argv, next_offset, status): 1 complete, 0 need more bytes, -1 protocol error
fn parse_inline_at(buf: string, offset: int) -> ([]string, int, int) {
    let empty: []string = []
    let cr = find_crlf(buf, offset)
    if cr < 0 {
        return (empty, offset, 0)
    }
    let line = buf[offset:cr]
    let parts = str_fields(line)
    if len(parts) == 0 {
        return (empty, cr + 2, -1)
    }
    return (parts, cr + 2, 1)
}

fn parse_resp_array_at(buf: string, offset: int) -> ([]string, int, int) {
    let empty: []string = []
    let cr = find_crlf(buf, offset)
    if cr < 0 {
        return (empty, offset, 0)
    }
    if cr < offset + 2 {
        return (empty, offset, -1)
    }
    let nstr = buf[offset + 1:cr]
    let argc, aok = int_ok(nstr)
    if aok == 0 {
        return (empty, offset, -1)
    }
    if argc < 0 {
        return (empty, offset, -1)
    }
    if argc > 4096 {
        return (empty, offset, -1)
    }
    let mut pos = cr + 2
    let mut argv = make([]string, 0, argc)
    let mut i = 0
    let n = str_len(buf)
    while i < argc {
        if pos >= n {
            return (empty, offset, 0)
        }
        if str_byte_at(buf, pos) != 36 {
            return (empty, offset, -1)
        }
        let cr2 = find_crlf(buf, pos)
        if cr2 < 0 {
            return (empty, offset, 0)
        }
        let lstr = buf[pos + 1:cr2]
        let blen, bok = int_ok(lstr)
        if bok == 0 {
            return (empty, offset, -1)
        }
        pos = cr2 + 2
        if blen == 0 - 1 {
            argv = append(argv, "")
            i = i + 1
            continue
        }
        if blen < 0 {
            return (empty, offset, -1)
        }
        if blen > MAX_BULK {
            return (empty, offset, -1)
        }
        if pos + blen + 2 > n {
            return (empty, offset, 0)
        }
        let bulk = buf[pos:pos + blen]
        pos = pos + blen
        if str_byte_at(buf, pos) != 13 or str_byte_at(buf, pos + 1) != 10 {
            return (empty, offset, -1)
        }
        pos = pos + 2
        argv = append(argv, bulk)
        i = i + 1
    }
    return (argv, pos, 1)
}

fn parse_cmd_at(buf: string, offset: int) -> ([]string, int, int) {
    let empty: []string = []
    let n = str_len(buf)
    if offset < 0 or offset >= n {
        return (empty, offset, 0)
    }
    let c0 = str_byte_at(buf, offset)
    if c0 == 42 {
        return parse_resp_array_at(buf, offset)
    }
    return parse_inline_at(buf, offset)
}

// Parse one command from the head of buf.
// status: 1 complete, 0 need more bytes, -1 protocol error
fn parse_cmd(buf: string) -> ([]string, int, int) {
    return parse_cmd_at(buf, 0)
}

fn parse_inline(buf: string) -> ([]string, int, int) {
    return parse_inline_at(buf, 0)
}

fn parse_resp_array(buf: string) -> ([]string, int, int) {
    return parse_resp_array_at(buf, 0)
}

fn cmd_name(argv: []string) -> string {
    if len(argv) == 0 {
        return ""
    }
    let s = argv[0]
    let n = str_len(s)
    if n == 3 {
        if str_slice_ci_eq(s, 0, 3, "GET") == 1 {
            return "GET"
        }
        if str_slice_ci_eq(s, 0, 3, "SET") == 1 {
            return "SET"
        }
        if str_slice_ci_eq(s, 0, 3, "DEL") == 1 {
            return "DEL"
        }
        if str_slice_ci_eq(s, 0, 3, "TTL") == 1 {
            return "TTL"
        }
    } else if n == 4 {
        if str_slice_ci_eq(s, 0, 4, "PING") == 1 {
            return "PING"
        }
        if str_slice_ci_eq(s, 0, 4, "INCR") == 1 {
            return "INCR"
        }
        if str_slice_ci_eq(s, 0, 4, "DECR") == 1 {
            return "DECR"
        }
        if str_slice_ci_eq(s, 0, 4, "MGET") == 1 {
            return "MGET"
        }
        if str_slice_ci_eq(s, 0, 4, "MSET") == 1 {
            return "MSET"
        }
        if str_slice_ci_eq(s, 0, 4, "HGET") == 1 {
            return "HGET"
        }
        if str_slice_ci_eq(s, 0, 4, "HSET") == 1 {
            return "HSET"
        }
        if str_slice_ci_eq(s, 0, 4, "HDEL") == 1 {
            return "HDEL"
        }
        if str_slice_ci_eq(s, 0, 4, "HLEN") == 1 {
            return "HLEN"
        }
        if str_slice_ci_eq(s, 0, 4, "LPOP") == 1 {
            return "LPOP"
        }
        if str_slice_ci_eq(s, 0, 4, "RPOP") == 1 {
            return "RPOP"
        }
        if str_slice_ci_eq(s, 0, 4, "LLEN") == 1 {
            return "LLEN"
        }
        if str_slice_ci_eq(s, 0, 4, "SADD") == 1 {
            return "SADD"
        }
        if str_slice_ci_eq(s, 0, 4, "SREM") == 1 {
            return "SREM"
        }
        if str_slice_ci_eq(s, 0, 4, "ZADD") == 1 {
            return "ZADD"
        }
        if str_slice_ci_eq(s, 0, 4, "ZREM") == 1 {
            return "ZREM"
        }
        if str_slice_ci_eq(s, 0, 4, "XADD") == 1 {
            return "XADD"
        }
        if str_slice_ci_eq(s, 0, 4, "XLEN") == 1 {
            return "XLEN"
        }
        if str_slice_ci_eq(s, 0, 4, "VADD") == 1 {
            return "VADD"
        }
        if str_slice_ci_eq(s, 0, 4, "VSIM") == 1 {
            return "VSIM"
        }
        if str_slice_ci_eq(s, 0, 4, "PTTL") == 1 {
            return "PTTL"
        }
        if str_slice_ci_eq(s, 0, 4, "TYPE") == 1 {
            return "TYPE"
        }
        if str_slice_ci_eq(s, 0, 4, "EXEC") == 1 {
            return "EXEC"
        }
        if str_slice_ci_eq(s, 0, 4, "AUTH") == 1 {
            return "AUTH"
        }
        if str_slice_ci_eq(s, 0, 4, "QUIT") == 1 {
            return "QUIT"
        }
        if str_slice_ci_eq(s, 0, 4, "SCAN") == 1 {
            return "SCAN"
        }
        if str_slice_ci_eq(s, 0, 4, "INFO") == 1 {
            return "INFO"
        }
        if str_slice_ci_eq(s, 0, 4, "KEYS") == 1 {
            return "KEYS"
        }
        if str_slice_ci_eq(s, 0, 4, "ECHO") == 1 {
            return "ECHO"
        }
    } else if n == 5 {
        if str_slice_ci_eq(s, 0, 5, "LPUSH") == 1 {
            return "LPUSH"
        }
        if str_slice_ci_eq(s, 0, 5, "RPUSH") == 1 {
            return "RPUSH"
        }
        if str_slice_ci_eq(s, 0, 5, "HMGET") == 1 {
            return "HMGET"
        }
        if str_slice_ci_eq(s, 0, 5, "HMSET") == 1 {
            return "HMSET"
        }
        if str_slice_ci_eq(s, 0, 5, "SCARD") == 1 {
            return "SCARD"
        }
        if str_slice_ci_eq(s, 0, 5, "ZCARD") == 1 {
            return "ZCARD"
        }
        if str_slice_ci_eq(s, 0, 5, "ZRANK") == 1 {
            return "ZRANK"
        }
        if str_slice_ci_eq(s, 0, 5, "XREAD") == 1 {
            return "XREAD"
        }
        if str_slice_ci_eq(s, 0, 5, "PFADD") == 1 {
            return "PFADD"
        }
        if str_slice_ci_eq(s, 0, 5, "HELLO") == 1 {
            return "HELLO"
        }
        if str_slice_ci_eq(s, 0, 5, "MULTI") == 1 {
            return "MULTI"
        }
        if str_slice_ci_eq(s, 0, 5, "PSYNC") == 1 {
            return "PSYNC"
        }
    } else if n == 6 {
        if str_slice_ci_eq(s, 0, 6, "EXISTS") == 1 {
            return "EXISTS"
        }
        if str_slice_ci_eq(s, 0, 6, "EXPIRE") == 1 {
            return "EXPIRE"
        }
        if str_slice_ci_eq(s, 0, 6, "APPEND") == 1 {
            return "APPEND"
        }
        if str_slice_ci_eq(s, 0, 6, "SELECT") == 1 {
            return "SELECT"
        }
        if str_slice_ci_eq(s, 0, 6, "STRLEN") == 1 {
            return "STRLEN"
        }
        if str_slice_ci_eq(s, 0, 6, "INCRBY") == 1 {
            return "INCRBY"
        }
        if str_slice_ci_eq(s, 0, 6, "DECRBY") == 1 {
            return "DECRBY"
        }
        if str_slice_ci_eq(s, 0, 6, "GETSET") == 1 {
            return "GETSET"
        }
        if str_slice_ci_eq(s, 0, 6, "SETNX") == 1 {
            return "SETNX"
        }
        if str_slice_ci_eq(s, 0, 6, "SETEX") == 1 {
            return "SETEX"
        }
        if str_slice_ci_eq(s, 0, 6, "UNLINK") == 1 {
            return "UNLINK"
        }
        if str_slice_ci_eq(s, 0, 6, "LRANGE") == 1 {
            return "LRANGE"
        }
        if str_slice_ci_eq(s, 0, 6, "ZRANGE") == 1 {
            return "ZRANGE"
        }
        if str_slice_ci_eq(s, 0, 6, "ZSCORE") == 1 {
            return "ZSCORE"
        }
        if str_slice_ci_eq(s, 0, 6, "XRANGE") == 1 {
            return "XRANGE"
        }
    } else if n == 7 {
        if str_slice_ci_eq(s, 0, 7, "HGETALL") == 1 {
            return "HGETALL"
        }
        if str_slice_ci_eq(s, 0, 7, "HINCRBY") == 1 {
            return "HINCRBY"
        }
        if str_slice_ci_eq(s, 0, 7, "ZINCRBY") == 1 {
            return "ZINCRBY"
        }
        if str_slice_ci_eq(s, 0, 7, "PFCOUNT") == 1 {
            return "PFCOUNT"
        }
    } else if n == 8 {
        if str_slice_ci_eq(s, 0, 8, "SMEMBERS") == 1 {
            return "SMEMBERS"
        }
        if str_slice_ci_eq(s, 0, 8, "BITCOUNT") == 1 {
            return "BITCOUNT"
        }
    } else if n == 9 {
        if str_slice_ci_eq(s, 0, 9, "SISMEMBER") == 1 {
            return "SISMEMBER"
        }
        if str_slice_ci_eq(s, 0, 9, "ZREVRANGE") == 1 {
            return "ZREVRANGE"
        }
    }
    return str_to_upper(s)
}

