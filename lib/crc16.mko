fn crc16_tab(i: int) -> int {
    let x = i & 255
    let hi = (x >> 4) & 15
    let lo = x & 15
    if hi == 0 {
        return crc16_t0(lo)
    }
    if hi == 1 {
        return crc16_t1(lo)
    }
    if hi == 2 {
        return crc16_t2(lo)
    }
    if hi == 3 {
        return crc16_t3(lo)
    }
    if hi == 4 {
        return crc16_t4(lo)
    }
    if hi == 5 {
        return crc16_t5(lo)
    }
    if hi == 6 {
        return crc16_t6(lo)
    }
    if hi == 7 {
        return crc16_t7(lo)
    }
    if hi == 8 {
        return crc16_t8(lo)
    }
    if hi == 9 {
        return crc16_t9(lo)
    }
    if hi == 10 {
        return crc16_t10(lo)
    }
    if hi == 11 {
        return crc16_t11(lo)
    }
    if hi == 12 {
        return crc16_t12(lo)
    }
    if hi == 13 {
        return crc16_t13(lo)
    }
    if hi == 14 {
        return crc16_t14(lo)
    }
    return crc16_t15(lo)
}

fn crc16_range(data: string, start: int, end: int) -> int {
    let mut crc = 0
    let mut i = start
    let n = str_len(data)
    let mut e = end
    if e > n {
        e = n
    }
    if i < 0 {
        i = 0
    }
    while i < e {
        let b = str_byte_at(data, i)
        let idx = ((crc >> 8) ^ b) & 255
        crc = ((crc << 8) ^ crc16_tab(idx)) & 65535
        i = i + 1
    }
    return crc
}

fn crc16(data: string) -> int {
    return crc16_range(data, 0, str_len(data))
}

fn hash_tag_span(key: string) -> (int, int) {
    let n = str_len(key)
    let i = str_index(key, "{")
    if i < 0 {
        return (0, n)
    }
    let j = str_slice_index(key, i + 1, n - (i + 1), "}")
    if j > i + 1 {
        return (i + 1, j)
    }
    return (0, n)
}

fn hash_tag(key: string) -> string {
    let a, b = hash_tag_span(key)
    if a == 0 and b == str_len(key) {
        return key
    }
    return key[a:b]
}

fn key_slot(key: string) -> int {
    let a, b = hash_tag_span(key)
    return crc16_range(key, a, b) & 16383
}

fn key_shard(key: string, shards: int) -> int {
    if shards <= 1 {
        return 0
    }
    let slot = key_slot(key)
    if shards == 16 {
        return slot & 15
    }
    if shards == 8 {
        return slot & 7
    }
    if shards == 4 {
        return slot & 3
    }
    if shards == 2 {
        return slot & 1
    }
    return slot % shards
}
