pack bonodis

// Redis Cluster CRC16 (XMODEM / CCITT-FALSE poly 0x1021, init 0).
// CLUSTER KEYSLOT is crc16(tag) & 16383. Table-driven; hash tags hashed in place.

fn crc16_t0(lo: int) -> int {
    return match lo {
        0 => 0,
        1 => 4129,
        2 => 8258,
        3 => 12387,
        4 => 16516,
        5 => 20645,
        6 => 24774,
        7 => 28903,
        8 => 33032,
        9 => 37161,
        10 => 41290,
        11 => 45419,
        12 => 49548,
        13 => 53677,
        14 => 57806,
        15 => 61935,
        _ => 0,
    }
}

