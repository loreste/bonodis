fn TestProbeEvalParenBomb() {
    let stop = atomic_new(0)
    let port = 19705
    crew t {
        let srv = t.kick(probe_boot(port, stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let mut s = "return "
        let mut i = 0
        while i < 40000 {
            s = s + "("
            i = i + 1
        }
        s = s + "1"
        let r = resp_send(fd, ["EVAL", s, "0"])
        assert(str_has_prefix(r, "-"))
        assert_eq_str(resp_send(fd, ["PING"]), "+PONG\r\n")
        let _ = resp_send(fd, ["QUIT"])
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestProbeGlobDepth() {
    let stop = atomic_new(0)
    let port = 19706
    crew t {
        let srv = t.kick(probe_boot(port, stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let mut big = ""
        let mut i = 0
        while i < 100000 {
            big = big + "a"
            i = i + 1
        }
        let mut pat = ""
        i = 0
        while i < 100000 {
            pat = pat + "?"
            i = i + 1
        }
        assert_eq_str(resp_send(fd, ["SET", big, "v"]), "+OK\r\n")
        // KEYS with 100k ? pattern — server must not crash
        // Pipeline KEYS + PING together, then drain until we see +PONG
        let _ = tcp_write_all(fd, encode_array(["KEYS", pat]) + encode_array(["PING"]))
        let _ = tcp_set_timeout(fd, 5000)
        let mut buf = ""
        let mut found = 0
        while found == 0 {
            let chunk = tcp_read(fd)
            if str_len(chunk) == 0 {
                break
            }
            buf = buf + chunk
            if str_contains(buf, "+PONG\r\n") {
                found = 1
            }
        }
        assert(found == 1)
        let _ = resp_send(fd, ["QUIT"])
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestProbeMgetEmptyString() {
    let stop = atomic_new(0)
    let port = 19707
    crew t {
        let srv = t.kick(probe_boot(port, stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        assert_eq_str(resp_send(fd, ["SET", "pk", ""]), "+OK\r\n")
        let r = resp_send(fd, ["MGET", "pk"])
        assert_eq_str(r, "*1\r\n$0\r\n\r\n")
        let _ = resp_send(fd, ["QUIT"])
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestProbeUnsubExitsSubMode() {
    let stop = atomic_new(0)
    let port = 19708
    crew t {
        let srv = t.kick(probe_boot(port, stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let _ = resp_send(fd, ["SUBSCRIBE", "pc"])
        let _ = resp_send(fd, ["UNSUBSCRIBE"])
        assert_eq_str(resp_send(fd, ["PING"]), "+PONG\r\n")
        assert_eq_str(resp_send(fd, ["SET", "pk2", "v"]), "+OK\r\n")
        let _ = resp_send(fd, ["QUIT"])
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestProbeXrangeBounds() {
    let stop = atomic_new(0)
    let port = 19751
    crew t {
        let srv = t.kick(probe_boot(port, stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        assert_eq_str(resp_send(fd, ["XADD", "xs", "1-1", "f", "a"]), "$3\r\n1-1\r\n")
        assert_eq_str(resp_send(fd, ["XADD", "xs", "1-2", "f", "b"]), "$3\r\n1-2\r\n")
        assert_eq_str(resp_send(fd, ["XADD", "xs", "1-3", "f", "c"]), "$3\r\n1-3\r\n")
        let r = resp_send(fd, ["XRANGE", "xs", "(1-1", "1-2"])
        assert(not str_contains(r, "1-1"))
        assert(str_contains(r, "1-2"))
        assert(not str_contains(r, "1-3"))
        let rev = resp_send(fd, ["XREVRANGE", "xs", "1-3", "1-2", "COUNT", "1"])
        assert(str_contains(rev, "1-3"))
        assert(not str_contains(rev, "1-2"))
        let xr = resp_send(fd, ["XREAD", "COUNT", "2", "STREAMS", "xs", "1-1"])
        assert(str_contains(xr, "1-2"))
        assert(str_contains(xr, "1-3"))
        assert_eq_str(resp_send(fd, ["PING"]), "+PONG\r\n")
        let _ = resp_send(fd, ["QUIT"])
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestProbeSrandmemberCap() {
    let stop = atomic_new(0)
    let port = 19710
    crew t {
        let srv = t.kick(probe_boot(port, stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let _ = resp_send(fd, ["SADD", "ps", "a", "b", "c"])
        // Response is 10000 elements (capped); pipeline PING and drain
        let _ = tcp_write_all(fd, encode_array(["SRANDMEMBER", "ps", "-2000000000"]) + encode_array(["PING"]))
        let _ = tcp_set_timeout(fd, 5000)
        let mut buf = ""
        let mut found = 0
        while found == 0 {
            let chunk = tcp_read(fd)
            if str_len(chunk) == 0 {
                break
            }
            buf = buf + chunk
            if str_contains(buf, "+PONG\r\n") {
                found = 1
            }
        }
        assert(found == 1)
        let _ = resp_send(fd, ["QUIT"])
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}
