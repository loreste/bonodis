// Adversarial live probes. Each Test* boots its own server; run individually
// with `mako test -p lib -r <name>` so a crash in one cannot hide the others.

fn probe_boot(port: int, stop: AtomicInt) -> int {
    return serve("127.0.0.1", port, 4, "", "", 0, 0, stop, 10000, 0, 10000, 0, "")
}

fn TestProbeBareScan() {
    let stop = atomic_new(0)
    let port = 19701
    crew t {
        let srv = t.kick(probe_boot(port, stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let r = resp_send(fd, ["SCAN"])
        assert(str_has_prefix(r, "-"))
        let _ = resp_send(fd, ["QUIT"])
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestProbeEvalNumkeysOverflow() {
    let stop = atomic_new(0)
    let port = 19702
    crew t {
        let srv = t.kick(probe_boot(port, stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let r = resp_send(fd, ["EVAL", "return 1", "9223372036854775807"])
        assert(str_has_prefix(r, "-"))
        assert_eq_str(resp_send(fd, ["PING"]), "+PONG\r\n")
        let _ = resp_send(fd, ["QUIT"])
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

