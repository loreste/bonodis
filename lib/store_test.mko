fn TestMaxmemoryEvict() {
    let mut st = new_store()
    st.maxmem = 20
    let _ = st.apply(0, ["SET", "a", "xxxxxxxxxxxxxxxxxxxx"])
    let _ = st.apply(0, ["SET", "b", "yyyyyyyyyyyyyyyyyyyy"])
    let n = st.cmd_dbsize(0)
    assert(n <= 2)
    assert(st.used <= st.maxmem + 40)
}

