    assert_eq_str(st.apply(0, ["GETBIT", "b", "0"]), ":1\r\n")
    let bc = st.apply(0, ["BITCOUNT", "b"])
    assert_eq_str(bc, ":1\r\n")
}

fn TestGeoAddDist() {
