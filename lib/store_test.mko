    let dump = st.apply(0, ["EXPORT"])
    assert(str_has_prefix(dump, "$"))
    assert(str_contains(dump, "SET"))
}

fn TestVecAddSim() {
    let mut st = new_store()
    assert_eq_str(st.apply(0, ["VADD", "emb", "a", "1", "0"]), ":1\r\n")
    assert_eq_str(st.apply(0, ["VADD", "emb", "b", "0", "1"]), ":1\r\n")
    assert_eq_str(st.apply(0, ["VCARD", "emb"]), ":2\r\n")
    assert_eq_str(st.apply(0, ["VDIM", "emb"]), ":2\r\n")
    assert_eq_str(st.apply(0, ["TYPE", "emb"]), "+vector\r\n")
    let r = st.apply(0, ["VSIM", "emb", "COUNT", "1", "1", "0"])
