fn TestStringGetSet() {
    let mut st = new_store()
    assert_eq_str(st.apply(0, ["SET", "k", "v"]), "+OK\r\n")
    assert_eq_str(st.apply(0, ["GET", "k"]), "$1\r\nv\r\n")
    assert_eq_str(st.apply(0, ["GET", "missing"]), "$-1\r\n")
}

fn TestIncr() {
    let mut st = new_store()
    assert_eq_str(st.apply(0, ["INCR", "n"]), ":1\r\n")
    assert_eq_str(st.apply(0, ["INCRBY", "n", "4"]), ":5\r\n")
    assert_eq_str(st.apply(0, ["DECR", "n"]), ":4\r\n")
}

fn TestSetNxXx() {
    let mut st = new_store()
    assert_eq_str(st.apply(0, ["SET", "k", "1", "NX"]), "+OK\r\n")
    assert_eq_str(st.apply(0, ["SET", "k", "2", "NX"]), "$-1\r\n")
    assert_eq_str(st.apply(0, ["GET", "k"]), "$1\r\n1\r\n")
    assert_eq_str(st.apply(0, ["SET", "k", "3", "XX"]), "+OK\r\n")
    assert_eq_str(st.apply(0, ["GET", "k"]), "$1\r\n3\r\n")
}

fn TestDelExistsType() {
    let mut st = new_store()
    let _ = st.apply(0, ["SET", "a", "1"])
    let _ = st.apply(0, ["SET", "b", "2"])
    assert_eq_str(st.apply(0, ["EXISTS", "a", "b", "c"]), ":2\r\n")
    assert_eq_str(st.apply(0, ["TYPE", "a"]), "+string\r\n")
    assert_eq_str(st.apply(0, ["DEL", "a", "b"]), ":2\r\n")
    assert_eq_str(st.apply(0, ["EXISTS", "a"]), ":0\r\n")
}

fn TestExpireTtl() {
    let mut st = new_store()
    let _ = st.apply(0, ["SET", "k", "v"])
    assert_eq_str(st.apply(0, ["TTL", "k"]), ":-1\r\n")
    assert_eq_str(st.apply(0, ["EXPIRE", "k", "60"]), ":1\r\n")
    let t = st.apply(0, ["TTL", "k"])
    assert(str_has_prefix(t, ":"))
    assert_eq_str(st.apply(0, ["PERSIST", "k"]), ":1\r\n")
    assert_eq_str(st.apply(0, ["TTL", "k"]), ":-1\r\n")
}

fn TestHash() {
    let mut st = new_store()
    assert_eq_str(st.apply(0, ["HSET", "h", "f", "1", "g", "2"]), ":2\r\n")
    assert_eq_str(st.apply(0, ["HGET", "h", "f"]), "$1\r\n1\r\n")
    assert_eq_str(st.apply(0, ["HEXISTS", "h", "g"]), ":1\r\n")
    assert_eq_str(st.apply(0, ["HLEN", "h"]), ":2\r\n")
    assert_eq_str(st.apply(0, ["HINCRBY", "h", "f", "3"]), ":4\r\n")
    assert_eq_str(st.apply(0, ["HDEL", "h", "g"]), ":1\r\n")
    assert_eq_str(st.apply(0, ["HLEN", "h"]), ":1\r\n")
}

fn TestList() {
    let mut st = new_store()
    assert_eq_str(st.apply(0, ["LPUSH", "l", "a", "b"]), ":2\r\n")
    assert_eq_str(st.apply(0, ["RPUSH", "l", "c"]), ":3\r\n")
    assert_eq_str(st.apply(0, ["LLEN", "l"]), ":3\r\n")
    let r = st.apply(0, ["LRANGE", "l", "0", "-1"])
    assert(str_has_prefix(r, "*3\r\n"))
    assert_eq_str(st.apply(0, ["LPOP", "l"]), "$1\r\nb\r\n")
}

fn TestSet() {
    let mut st = new_store()
    assert_eq_str(st.apply(0, ["SADD", "s", "a", "b", "a"]), ":2\r\n")
    assert_eq_str(st.apply(0, ["SCARD", "s"]), ":2\r\n")
    assert_eq_str(st.apply(0, ["SISMEMBER", "s", "a"]), ":1\r\n")
    assert_eq_str(st.apply(0, ["SREM", "s", "a"]), ":1\r\n")
    assert_eq_str(st.apply(0, ["SCARD", "s"]), ":1\r\n")
}

fn TestZset() {
    let mut st = new_store()
    assert_eq_str(st.apply(0, ["ZADD", "z", "2", "b", "1", "a"]), ":2\r\n")
    assert_eq_str(st.apply(0, ["ZCARD", "z"]), ":2\r\n")
    assert_eq_str(st.apply(0, ["ZSCORE", "z", "a"]), "$1\r\n1\r\n")
    let r = st.apply(0, ["ZRANGE", "z", "0", "-1"])
    assert(str_contains(r, "a"))
    assert(str_contains(r, "b"))
    assert_eq_str(st.apply(0, ["ZRANK", "z", "a"]), ":0\r\n")
}

fn TestWrongType() {
    let mut st = new_store()
    let _ = st.apply(0, ["HSET", "h", "f", "1"])
    assert(str_has_prefix(st.apply(0, ["GET", "h"]), "-WRONGTYPE"))
}

fn TestKeysDbsizeFlush() {
    let mut st = new_store()
    let _ = st.apply(0, ["SET", "a", "1"])
    let _ = st.apply(0, ["SET", "b", "2"])
    assert_eq_str(st.apply(0, ["DBSIZE"]), ":2\r\n")
    let ks = st.apply(0, ["KEYS", "*"])
    assert(str_has_prefix(ks, "*2\r\n"))
    assert_eq_str(st.apply(0, ["FLUSHDB"]), "+OK\r\n")
    assert_eq_str(st.apply(0, ["DBSIZE"]), ":0\r\n")
}

fn TestSelectNamespace() {
    let mut st = new_store()
    let _ = st.apply(0, ["SET", "k", "a"])
    let _ = st.apply(1, ["SET", "k", "b"])
    assert_eq_str(st.apply(0, ["GET", "k"]), "$1\r\na\r\n")
    assert_eq_str(st.apply(1, ["GET", "k"]), "$1\r\nb\r\n")
}

fn TestJobEncode() {
    let job = encode_job("9", 0, ["SET", "k", "v"])
    let id, db, argv, ok = parse_job(job)
    assert_eq(ok, 1)
    assert_eq_str(id, "9")
    assert_eq(db, 0)
    assert_eq_str(argv[2], "v")
}

fn TestKeepTtl() {
    let mut st = new_store()
    let _ = st.apply(0, ["SET", "k", "v", "EX", "60"])
    let t1 = st.apply(0, ["TTL", "k"])
    assert(str_has_prefix(t1, ":"))
    let _ = st.apply(0, ["SET", "k", "w", "KEEPTTL"])
    let t2 = st.apply(0, ["TTL", "k"])
    assert(not str_eq(t2, ":-1\r\n"))
    assert_eq_str(st.apply(0, ["GET", "k"]), "$1\r\nw\r\n")
}

fn TestSetbitGetbit() {
    let mut st = new_store()
