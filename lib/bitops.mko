pack bonodis

fn grow_bytes(s: string, n: int) -> string {
    let b = str_builder()
    builder_write(b, s)
    let mut i = str_len(s)
    while i < n {
        builder_write_byte(b, byte(0))
        i = i + 1
    }
    return builder_string(b)
}

fn pow2(n: int) -> int {
    let mut v = 1
    let mut i = 0
    while i < n {
        v = v * 2
        i = i + 1
    }
    return v
}

fn Store_cmd_setbit(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("setbit")
    }
    let off, ook = int_ok(argv[2])
    let bit, bok = int_ok(argv[3])
    if ook == 0 or bok == 0 or off < 0 or bit < 0 or bit > 1 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_STR {
        return r_wrongtype()
    }
    let mut s = ""
    if t == T_STR {
        s = self.strs[ik]
    }
    let bi = off / 8
    let bp = 7 - (off % 8)
    if str_len(s) <= bi {
        s = grow_bytes(s, bi + 1)
    }
    let v = str_byte_at(s, bi)
    let mask = pow2(bp)
    let old = (v / mask) % 2
    let mut nv = v
    if bit == 1 {
        if old == 0 {
            nv = v + mask
        }
    } else {
        if old == 1 {
            nv = v - mask
        }
    }
    let outb = str_builder()
    let mut i = 0
    let n = str_len(s)
    while i < n {
        let mut x = str_byte_at(s, i)
        if i == bi {
            x = nv
        }
        builder_write_byte(outb, byte(x))
        i = i + 1
    }
    self.strs[ik] = builder_string(outb)
    self.types[ik] = T_STR
    let _ = self.maybe_evict(0)
    return r_int(old)
}

fn Store_cmd_getbit(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("getbit")
    }
    let off, ok = int_ok(argv[2])
    if ok == 0 or off < 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let s = self.strs[ik]
    let bi = off / 8
    if bi >= str_len(s) {
        return r_int(0)
    }
    let bp = 7 - (off % 8)
    let v = str_byte_at(s, bi)
    let bit = (v / pow2(bp)) % 2
    return r_int(bit)
}

fn Store_cmd_bitcount(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("bitcount")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let s = self.strs[ik]
    let mut n = 0
    let mut i = 0
    while i < str_len(s) {
        let mut v = str_byte_at(s, i)
        while v > 0 {
            n = n + (v % 2)
            v = v / 2
        }
        i = i + 1
    }
    return r_int(n)
}

fn bitop_bytes(op: string, a: int, b: int) -> int {
    if str_eq(op, "AND") {
        return a & b
    }
    if str_eq(op, "OR") {
        return a | b
    }
    if str_eq(op, "XOR") {
        return a ^ b
    }
    return a
}

fn Store_cmd_bitop(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 {
        return r_arity("bitop")
    }
    let op = str_to_upper(argv[1])
    let dest = argv[2]
    if str_eq(op, "NOT") {
        if len(argv) != 4 {
            return r_arity("bitop")
        }
        let ik = ikey(db, argv[3])
        let t = self.kind(ik)
        let mut s = ""
        if t == T_STR {
            s = self.strs[ik]
        } else if t != T_NONE {
            return r_wrongtype()
        }
        let b = str_builder()
        let mut i = 0
        while i < str_len(s) {
            builder_write_byte(b, byte(255 - str_byte_at(s, i)))
            i = i + 1
        }
        let nv = builder_string(b)
        let dik = ikey(db, dest)
        if self.live(dik) == 1 {
            let _ = self.drop_key(dik)
        }
        self.strs[dik] = nv
        self.types[dik] = T_STR
        return r_int(str_len(nv))
    }
    if not str_eq(op, "AND") and not str_eq(op, "OR") and not str_eq(op, "XOR") {
        return r_syntax()
    }
    let mut longest = 0
    let mut i = 3
    while i < len(argv) {
        let ik = ikey(db, argv[i])
        let t = self.kind(ik)
        if t != T_NONE and t != T_STR {
            return r_wrongtype()
        }
        if t == T_STR and str_len(self.strs[ik]) > longest {
            longest = str_len(self.strs[ik])
        }
        i = i + 1
    }
    let b = str_builder()
    let mut pos = 0
    while pos < longest {
        let mut acc = 0
        if str_eq(op, "AND") {
            acc = 255
        }
        i = 3
        let mut first = 1
        while i < len(argv) {
            let ik = ikey(db, argv[i])
            let mut v = 0
            if self.kind(ik) == T_STR and pos < str_len(self.strs[ik]) {
                v = str_byte_at(self.strs[ik], pos)
            }
            if first == 1 and str_eq(op, "XOR") {
                acc = v
                first = 0
            } else if first == 1 and str_eq(op, "OR") {
                acc = v
                first = 0
            } else {
                acc = bitop_bytes(op, acc, v)
                first = 0
            }
            i = i + 1
        }
        builder_write_byte(b, byte(acc))
        pos = pos + 1
    }
    let nv = builder_string(b)
    let dik = ikey(db, dest)
    if self.live(dik) == 1 {
        let _ = self.drop_key(dik)
    }
    self.strs[dik] = nv
    self.types[dik] = T_STR
    return r_int(str_len(nv))
}

fn Store_cmd_bitpos(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("bitpos")
    }
    let bit, ok = int_ok(argv[2])
    if ok == 0 or bit < 0 or bit > 1 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        if bit == 0 {
            return r_int(0)
        }
        return r_int(0 - 1)
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let s = self.strs[ik]
    let mut i = 0
    while i < str_len(s) {
        let mut b = 7
        while b >= 0 {
            let v = str_byte_at(s, i)
            let cur = (v / pow2(b)) % 2
            if cur == bit {
                return r_int(i * 8 + (7 - b))
            }
            b = b - 1
        }
        i = i + 1
    }
    if bit == 0 {
        return r_int(str_len(s) * 8)
    }
    return r_int(0 - 1)
}

fn bf_bit_at(s: string, off: int) -> int {
    if off < 0 {
        return 0
    }
    let bi = off / 8
    if bi >= str_len(s) {
        return 0
    }
    let bp = 7 - (off % 8)
    let v = str_byte_at(s, bi)
    let mask = pow2(bp)
    return (v / mask) % 2
}

fn bf_put_bit(s: string, off: int, bit: int) -> string {
    let bi = off / 8
    let bp = 7 - (off % 8)
    let mut cur = s
    if str_len(cur) <= bi {
        cur = grow_bytes(cur, bi + 1)
    }
    let v = str_byte_at(cur, bi)
    let mask = pow2(bp)
    let old = (v / mask) % 2
    let mut nv = v
    if bit == 1 {
        if old == 0 {
            nv = v + mask
        }
    } else {
        if old == 1 {
            nv = v - mask
        }
    }
    let outb = str_builder()
    let mut i = 0
    let n = str_len(cur)
    while i < n {
        let mut x = str_byte_at(cur, i)
        if i == bi {
            x = nv
        }
        builder_write_byte(outb, byte(x))
        i = i + 1
    }
    return builder_string(outb)
}

fn bf_width_of(spec: string) -> int {
    if str_len(spec) < 2 {
        return 8
    }
    let w, ok = int_ok(spec[1:])
    if ok == 0 or w < 1 {
        return 8
    }
    if w > 32 {
        return 32
    }
    return w
}

fn Store_cmd_bitfield(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("bitfield")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_STR {
        return r_wrongtype()
    }
    let mut cur = ""
    if t == T_STR {
        cur = self.strs[ik]
    }
    let mut replies = make([]string, 0, 4)
    let mut idx = 2
    while idx < len(argv) {
        let op = str_to_upper(argv[idx])
        if str_eq(op, "GET") and idx + 2 < len(argv) {
            let wid = bf_width_of(argv[idx + 1])
            let off = int_of(argv[idx + 2])
            if off < 0 {
                return r_err("ERR bit offset is not an integer or out of range")
            }
            let mut acc = 0
            let mut bi = 0
            while bi < wid {
                acc = acc * 2 + bf_bit_at(cur, off + bi)
                bi = bi + 1
            }
            replies = append(replies, format_int(acc))
            idx = idx + 3
        } else if str_eq(op, "SET") and idx + 3 < len(argv) {
            let wid = bf_width_of(argv[idx + 1])
            let off = int_of(argv[idx + 2])
            if off < 0 {
                return r_err("ERR bit offset is not an integer or out of range")
            }
            let mut val = int_of(argv[idx + 3])
            let mut oldv = 0
            let mut bi = 0
            while bi < wid {
                oldv = oldv * 2 + bf_bit_at(cur, off + bi)
                bi = bi + 1
            }
            bi = wid - 1
            while bi >= 0 {
                let mut bitv = val % 2
                if bitv < 0 {
                    bitv = 0
                }
                cur = bf_put_bit(cur, off + bi, bitv)
                val = val / 2
                bi = bi - 1
            }
            replies = append(replies, format_int(oldv))
            idx = idx + 4
        } else if str_eq(op, "INCRBY") and idx + 3 < len(argv) {
            let wid = bf_width_of(argv[idx + 1])
            let off = int_of(argv[idx + 2])
            if off < 0 {
                return r_err("ERR bit offset is not an integer or out of range")
            }
            let inc = int_of(argv[idx + 3])
            let mut curvv = 0
            let mut bi = 0
            while bi < wid {
                curvv = curvv * 2 + bf_bit_at(cur, off + bi)
                bi = bi + 1
            }
            let nval = curvv + inc
            let mut val = nval
            bi = wid - 1
            while bi >= 0 {
                let mut bitv = val % 2
                if bitv < 0 {
                    bitv = 0
                }
                cur = bf_put_bit(cur, off + bi, bitv)
                val = val / 2
                bi = bi - 1
            }
            replies = append(replies, format_int(nval))
            idx = idx + 4
        } else {
            idx = idx + 1
        }
    }
    if str_len(cur) > 0 {
        self.strs[ik] = cur
        self.types[ik] = T_STR
    }
    let outb = str_builder()
    builder_write(outb, "*")
    builder_write(outb, format_int(len(replies)))
    builder_write(outb, "\r\n")
    let mut ri = 0
    while ri < len(replies) {
        builder_write(outb, r_int(int_of(replies[ri])))
        ri = ri + 1
    }
    return builder_string(outb)
}
