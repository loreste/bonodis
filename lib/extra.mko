pack bonodis

fn Store_cmd_getdel(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("getdel")
    }
    let g = self.cmd_get(db, ["GET", argv[1]])
    if str_has_prefix(g, "-") {
        return g
    }
    if not str_eq(g, r_nil()) {
        let _ = self.cmd_del(db, ["DEL", argv[1]])
    }
    return g
}

fn Store_cmd_getex(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("getex")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_STR {
        return r_wrongtype()
    }
    let mut persist = 0
    let mut set_at = 0
    let mut at = 0
    let mut i = 2
    while i < len(argv) {
        let o = str_to_upper(argv[i])
        if str_eq(o, "PERSIST") {
            persist = 1
            i = i + 1
        } else if str_eq(o, "EX") or str_eq(o, "PX") or str_eq(o, "EXAT") or str_eq(o, "PXAT") {
            if i + 1 >= len(argv) {
                return r_syntax()
            }
            let n, ok = int_ok(argv[i + 1])
            if ok == 0 {
                return r_notint()
            }
            if n <= 0 {
                return r_err("ERR invalid expire time in 'getex' command")
            }
            if str_eq(o, "EX") {
                at = wall_ms() + n * 1000
            } else if str_eq(o, "PX") {
                at = wall_ms() + n
            } else if str_eq(o, "EXAT") {
                at = n * 1000
            } else {
                at = n
            }
            set_at = 1
            i = i + 2
        } else {
            return r_syntax()
        }
    }
    if persist == 1 and set_at == 1 {
        return r_syntax()
    }
    let g = self.cmd_get(db, ["GET", argv[1]])
    if str_has_prefix(g, "-") or str_eq(g, r_nil()) {
        return g
    }
    if persist == 1 {
        delete(self.expire, ik)
    } else if set_at == 1 {
        self.set_expire_at(ik, at)
    }
    return g
}

fn Store_cmd_touch(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("touch")
    }
    let mut n = 0
    let mut i = 1
    while i < len(argv) {
        let ik = ikey(db, argv[i])
        if self.live(ik) == 1 {
            n = n + 1
        }
        i = i + 1
    }
    return r_int(n)
}

fn Store_cmd_copy(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("copy")
    }
    let mut dst_db = db
    let mut nx = 0
    let mut i = 3
    while i < len(argv) {
        let opt = str_to_upper(argv[i])
        if str_eq(opt, "NX") {
            nx = 1
            i = i + 1
        } else if str_eq(opt, "REPLACE") {
            i = i + 1
        } else if str_eq(opt, "DB") and i + 1 < len(argv) {
            let d, dok = int_ok(argv[i + 1])
            if dok == 0 or d < 0 or d > 15 {
                return r_err("ERR DB index is out of range")
            }
            dst_db = d
            i = i + 2
        } else {
            return r_syntax()
        }
    }
    let src = ikey(db, argv[1])
    let dst = ikey(dst_db, argv[2])
    if str_eq(src, dst) {
        return r_err("ERR source and destination objects are the same")
    }
    if self.live(src) == 0 {
        return r_int(0)
    }
    if self.live(dst) == 1 {
        if nx == 1 {
            return r_int(0)
        }
        let _ = self.drop_key(dst)
    }
    let payload = self.export_one(db, argv[1])
    if str_len(payload) == 0 {
        return r_int(0)
    }
    let r = self.cmd_restore(dst_db, ["RESTORE", argv[2], "0", "BND1\n" + payload, "REPLACE"])
    if str_has_prefix(r, "-") {
        return r
    }
    return r_int(1)
}

fn Store_cmd_smismember(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("smismember")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    let mut items = make([]string, 0, len(argv) - 2)
    let mut i = 2
    while i < len(argv) {
        let mut hit = 0
        if t == T_SET {
            if has(self.sets[ik], argv[i]) {
                hit = 1
            }
        } else if t != T_NONE {
            return r_wrongtype()
        }
        items = append(items, format_int(hit))
        i = i + 1
    }
    let b = str_builder()
    builder_write(b, "*")
    builder_write(b, format_int(len(items)))
    builder_write(b, "\r\n")
    i = 0
    while i < len(items) {
        builder_write(b, r_int(int_of(items[i])))
        i = i + 1
    }
    return builder_string(b)
}

fn Store_cmd_sunion(mut self: Store, db: int, argv: []string, mode: int) -> string {
    if len(argv) < 2 {
        return r_arity("sunion")
    }
    let mut acc = make(map[string]int)
    let mut first = 1
    let mut i = 1
    while i < len(argv) {
        let ik = ikey(db, argv[i])
        let t = self.kind(ik)
        if t != T_NONE and t != T_SET {
            return r_wrongtype()
        }
        let mut cur = make(map[string]int)
        if t == T_SET {
            cur = self.sets[ik]
        }
        if mode == 0 {
            for m, _ in range cur {
                acc[m] = 1
            }
        } else if mode == 1 {
            if first == 1 {
                for m, _ in range cur {
                    acc[m] = 1
                }
                first = 0
            } else {
                let mut nxt = make(map[string]int)
                for m, _ in range acc {
                    if has(cur, m) {
                        nxt[m] = 1
                    }
                }
                acc = nxt
            }
        } else {
            if first == 1 {
                for m, _ in range cur {
                    acc[m] = 1
                }
                first = 0
            } else {
                for m, _ in range cur {
                    if has(acc, m) {
                        delete(acc, m)
                    }
                }
            }
        }
        i = i + 1
    }
    return r_array_bulks(set_members(acc))
}

fn Store_cmd_sunionstore(mut self: Store, db: int, argv: []string, mode: int) -> string {
    if len(argv) < 3 {
        return r_arity("sunionstore")
    }
    let dest = argv[1]
    let mut src = make([]string, 0, len(argv) - 1)
    src = append(src, "X")
    let mut i = 2
    while i < len(argv) {
        src = append(src, argv[i])
        i = i + 1
    }
    let body = self.cmd_sunion(db, src, mode)
    if str_has_prefix(body, "-") {
        return body
    }
    let ks = parse_array_bulks(body)
    let dik = ikey(db, dest)
    if self.live(dik) == 1 {
        let _ = self.drop_key(dik)
    }
    if len(ks) == 0 {
        return r_int(0)
    }
    let mut sadd = make([]string, 0, len(ks) + 2)
    sadd = append(sadd, "SADD")
    sadd = append(sadd, dest)
    i = 0
    while i < len(ks) {
        sadd = append(sadd, ks[i])
        i = i + 1
    }
    let _ = self.cmd_sadd(db, sadd)
    return r_int(len(ks))
}

fn z_bound_ok(sc: string, minv: string, maxv: string) -> int {
    let sv = parse_float(sc)
    let lmin = str_to_lower(minv)
    if not str_eq(lmin, "-inf") {
        if str_has_prefix(minv, "(") {
            if sv <= parse_float(minv[1:]) {
                return 0
            }
        } else {
            if sv < parse_float(minv) {
                return 0
            }
        }
    }
    let lmax = str_to_lower(maxv)
    if not str_eq(lmax, "+inf") and not str_eq(lmax, "inf") {
        if str_has_prefix(maxv, "(") {
            if sv >= parse_float(maxv[1:]) {
                return 0
            }
        } else {
            if sv > parse_float(maxv) {
                return 0
            }
        }
    }
    return 1
}

fn Store_cmd_zrangebyscore(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 {
        return r_arity("zrangebyscore")
    }
    let mut withscores = 0
    let mut off = 0
    let mut cnt = -1
    let mut i = 4
    while i < len(argv) {
        let o = str_to_upper(argv[i])
        if str_eq(o, "WITHSCORES") {
            withscores = 1
            i = i + 1
        } else if str_eq(o, "LIMIT") and i + 2 < len(argv) {
            let lo, ok1 = int_ok(argv[i + 1])
            let lc, ok2 = int_ok(argv[i + 2])
            if ok1 == 0 or ok2 == 0 {
                return r_notint()
            }
            off = lo
            cnt = lc
            i = i + 3
        } else {
            return r_syntax()
        }
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE or off < 0 or cnt == 0 {
        let none: []string = []
        return r_array_bulks(none)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let mems, scs = z_sorted(self.zsets[ik])
    let mut items = make([]string, 0, len(mems) * 2)
    let mut seen = 0
    let mut taken = 0
    i = 0
    while i < len(mems) {
        if z_bound_ok(scs[i], argv[2], argv[3]) == 1 {
            if seen >= off {
                if cnt >= 0 and taken >= cnt {
                    break
                }
                items = append(items, mems[i])
                if withscores == 1 {
                    items = append(items, scs[i])
                }
                taken = taken + 1
            }
            seen = seen + 1
        }
        i = i + 1
    }
    return r_array_bulks(items)
}

fn Store_cmd_zcount(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("zcount")
    }
    let r = self.cmd_zrangebyscore(db, argv)
    if str_has_prefix(r, "-") {
        return r
    }
    return r_int(len(parse_array_bulks(r)))
}

fn Store_cmd_zpop(mut self: Store, db: int, argv: []string, rev: int) -> string {
    if len(argv) < 2 or len(argv) > 3 {
        return r_arity("zpopmin")
    }
    let mut n = 1
    if len(argv) == 3 {
        let c, ok = int_ok(argv[2])
        if ok == 0 or c < 0 {
            return r_notint()
        }
        n = c
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        let none: []string = []
        return r_array_bulks(none)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let mems, scs = z_sorted(self.zsets[ik])
    if n > len(mems) {
        n = len(mems)
    }
    let mut z = self.zsets[ik]
    let mut out = make([]string, 0, n * 2)
    let mut i = 0
    while i < n {
        let mut idx = i
        if rev == 1 {
            idx = len(mems) - 1 - i
        }
        out = append(out, mems[idx])
        out = append(out, scs[idx])
        delete(z, mems[idx])
        i = i + 1
    }
    if len(z) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.zsets[ik] = z
    }
    return r_array_bulks(out)
}

fn sort_vals(mut xs: []string, alpha: int, desc: int) -> []string {
    let n = len(xs)
    let mut p = 0
    while p < n {
        let mut j = 0
        while j < n - 1 {
            let mut sw = 0
            if alpha == 1 {
                if desc == 1 {
                    if str_lt(xs[j], xs[j + 1]) == 1 {
                        sw = 1
                    }
                } else {
                    if str_lt(xs[j + 1], xs[j]) == 1 {
                        sw = 1
                    }
                }
            } else {
                let a = parse_float(xs[j])
                let b = parse_float(xs[j + 1])
                if desc == 1 {
                    if a < b {
                        sw = 1
                    }
                } else {
                    if a > b {
                        sw = 1
                    }
                }
            }
            if sw == 1 {
                let t = xs[j]
                xs[j] = xs[j + 1]
                xs[j + 1] = t
            }
            j = j + 1
        }
        p = p + 1
    }
    return xs
}

fn Store_cmd_sort(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("sort")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        let none: []string = []
        return r_array_bulks(none)
    }
    let mut xs = make([]string, 0, 8)
    if t == T_LIST {
        xs = self.list_norm(ik)
    } else if t == T_SET {
        xs = set_members(self.sets[ik])
    } else if t == T_ZSET {
        let mems, _ = z_sorted(self.zsets[ik])
        xs = mems
    } else {
        return r_wrongtype()
    }
    let mut alpha = 0
    let mut desc = 0
    let mut store = ""
    let mut off = 0
    let mut cnt = -1
    let mut i = 2
    while i < len(argv) {
        let o = str_to_upper(argv[i])
        if str_eq(o, "ALPHA") {
            alpha = 1
            i = i + 1
        } else if str_eq(o, "DESC") {
            desc = 1
            i = i + 1
        } else if str_eq(o, "ASC") {
            desc = 0
            i = i + 1
        } else if str_eq(o, "LIMIT") {
            if i + 2 >= len(argv) {
                return r_syntax()
            }
            off = int_of(argv[i + 1])
            cnt = int_of(argv[i + 2])
            i = i + 3
        } else if str_eq(o, "STORE") {
            if str_eq(cmd_name(argv), "SORT_RO") or i + 1 >= len(argv) {
                return r_syntax()
            }
            store = argv[i + 1]
            i = i + 2
        } else {
            i = i + 1
        }
    }
    xs = sort_vals(xs, alpha, desc)
    if cnt >= 0 {
        xs = slice_skip_take(xs, off, cnt)
    }
    if str_len(store) > 0 {
        let dik = ikey(db, store)
        if self.live(dik) == 1 {
            let _ = self.drop_key(dik)
        }
        if len(xs) == 0 {
            return r_int(0)
        }
        self.lists[dik] = xs
        self.types[dik] = T_LIST
        return r_int(len(xs))
    }
    return r_array_bulks(xs)
}

fn Store_cmd_getrange(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("getrange")
    }
    let a, ao = int_ok(argv[2])
    let b, bo = int_ok(argv[3])
    if ao == 0 or bo == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_bulk("")
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let s = self.strs[ik]
    let n = str_len(s)
    let mut start = a
    let mut stop = b
    if start < 0 {
        start = n + start
    }
    if stop < 0 {
        stop = n + stop
    }
    if start < 0 {
        start = 0
    }
    if stop >= n {
        stop = n - 1
    }
    if n == 0 or start > stop or start >= n {
        return r_bulk("")
    }
    return r_bulk(s[start:stop + 1])
}

fn Store_cmd_setrange(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("setrange")
    }
    let off, ok = int_ok(argv[2])
    if ok == 0 or off < 0 {
        return r_notint()
    }
    if off > 536870912 {
        return r_err("ERR string exceeds maximum allowed size (512MB)")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_STR {
        return r_wrongtype()
    }
    let mut s = ""
    if t == T_STR {
        s = self.strs[ik]
    }
    let ins = argv[3]
    let need = off + str_len(ins)
    if str_len(s) < need {
        s = grow_bytes(s, need)
    }
    let b = str_builder()
    builder_write(b, s[:off])
    builder_write(b, ins)
    if off + str_len(ins) < str_len(s) {
        builder_write(b, s[off + str_len(ins):])
    }
    let nv = builder_string(b)
    self.strs[ik] = nv
    self.types[ik] = T_STR
    return r_int(str_len(nv))
}

fn Store_cmd_incrbyfloat(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("incrbyfloat")
    }
    if finite_score(argv[2]) == 0 {
        return r_err("ERR value is not a valid float")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    let mut cur = 0.0
    if t == T_STR {
        if finite_score(self.strs[ik]) == 0 {
            return r_err("ERR value is not a valid float")
        }
        cur = parse_float(self.strs[ik])
    } else if t != T_NONE {
        return r_wrongtype()
    }
    let d = parse_float(argv[2])
    let n = cur + d
    let s = format_float(n, 6)
    self.strs[ik] = s
    self.types[ik] = T_STR
    return r_bulk(s)
}

fn Store_cmd_lrem(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("lrem")
    }
    let count, ok = int_ok(argv[2])
    if ok == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    let xs = self.list_norm(ik)
    let val = argv[3]
    let mut out = make([]string, 0, len(xs))
    let mut n = 0
    if count >= 0 {
        let mut i = 0
        while i < len(xs) {
            if str_eq(xs[i], val) and (count == 0 or n < count) {
                n = n + 1
            } else {
                out = append(out, xs[i])
            }
            i = i + 1
        }
    } else {
        let lim = 0 - count
        let mut i = len(xs) - 1
        let mut keep = make([]int, 0, len(xs))
        let mut j = 0
        while j < len(xs) {
            keep = append(keep, 1)
            j = j + 1
        }
        while i >= 0 {
            if str_eq(xs[i], val) and n < lim {
                keep[i] = 0
                n = n + 1
            }
            i = i - 1
        }
        i = 0
        while i < len(xs) {
            if keep[i] == 1 {
                out = append(out, xs[i])
            }
            i = i + 1
        }
    }
    if len(out) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.lists[ik] = out
    }
    return r_int(n)
}

fn Store_cmd_linsert(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 5 {
        return r_arity("linsert")
    }
    let where = str_to_upper(argv[2])
    let mut before = 0
    if str_eq(where, "BEFORE") {
        before = 1
    } else if not str_eq(where, "AFTER") {
        return r_syntax()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    let xs = self.list_norm(ik)
    let mut idx = -1
    let mut i = 0
    while i < len(xs) {
        if str_eq(xs[i], argv[3]) {
            idx = i
            break
        }
        i = i + 1
    }
    if idx < 0 {
        return r_int(0 - 1)
    }
    if before == 0 {
        idx = idx + 1
    }
    let mut out = make([]string, 0, len(xs) + 1)
    i = 0
    while i < idx {
        out = append(out, xs[i])
        i = i + 1
    }
    out = append(out, argv[4])
    while i < len(xs) {
        out = append(out, xs[i])
        i = i + 1
    }
    self.lists[ik] = out
    return r_int(len(out))
}

fn Store_cmd_lmove(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 5 {
        return r_arity("lmove")
    }
    let from = str_to_upper(argv[3])
    let to = str_to_upper(argv[4])
    let mut right_from = 0
    if str_eq(from, "RIGHT") {
        right_from = 1
    } else if not str_eq(from, "LEFT") {
        return r_syntax()
    }
    let mut right_to = 0
    if str_eq(to, "RIGHT") {
        right_to = 1
    } else if not str_eq(to, "LEFT") {
        return r_syntax()
    }
    let pop = self.cmd_lpop(db, ["LPOP", argv[1]], right_from)
    if str_has_prefix(pop, "-") or str_eq(pop, r_nil()) {
        return pop
    }
    let v = bulk_payload(pop)
    if right_to == 1 {
        let _ = self.cmd_lpush(db, ["RPUSH", argv[2], v], 1)
    } else {
        let _ = self.cmd_lpush(db, ["LPUSH", argv[2], v], 0)
    }
    return r_bulk(v)
}

fn Store_cmd_smove(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("smove")
    }
    let rem = self.cmd_srem(db, ["SREM", argv[1], argv[3]])
    if str_eq(rem, ":0\r\n") {
        return r_int(0)
    }
    if str_has_prefix(rem, "-") {
        return rem
    }
    let _ = self.cmd_sadd(db, ["SADD", argv[2], argv[3]])
    return r_int(1)
}

fn Store_cmd_zunionstore(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 {
        return r_arity("zunionstore")
    }
    let dest = argv[1]
    let nk, ok = int_ok(argv[2])
    if ok == 0 or nk < 1 or 3 + nk > len(argv) {
        return r_syntax()
    }
    let mut acc = make(map[string]string)
    let mut i = 0
    while i < nk {
        let ik = ikey(db, argv[3 + i])
        let t = self.kind(ik)
        if t == T_ZSET {
            let z = self.zsets[ik]
            for m, sc in range z {
                if has(acc, m) {
                    let a = parse_float(acc[m])
                    let b = parse_float(sc)
                    acc[m] = format_float(a + b, 6)
                } else {
                    acc[m] = sc
                }
            }
        } else if t == T_SET {
            let s = self.sets[ik]
            for m, _ in range s {
                if not has(acc, m) {
                    acc[m] = "1"
                }
            }
        } else if t != T_NONE {
            return r_wrongtype()
        }
        i = i + 1
    }
    let dik = ikey(db, dest)
    if self.live(dik) == 1 {
        let _ = self.drop_key(dik)
    }
    if len(acc) == 0 {
        return r_int(0)
    }
    self.zsets[dik] = acc
    self.types[dik] = T_ZSET
    return r_int(len(acc))
}

fn scan_opts(argv: []string) -> (int, string, int) {
    let mut cursor = 0
    if len(argv) >= 3 {
        let c, cok = int_ok(argv[2])
        if cok == 1 and c >= 0 {
            cursor = c
        }
    }
    let mut pat = "*"
    let mut count = 10
    let mut i = 3
    while i + 1 < len(argv) {
        let o = str_to_upper(argv[i])
        if str_eq(o, "MATCH") {
            pat = argv[i + 1]
        } else if str_eq(o, "COUNT") {
            let n, ok = int_ok(argv[i + 1])
            if ok == 1 and n > 0 {
                count = n
            }
        }
        i = i + 2
    }
    return (cursor, pat, count)
}

fn scan_page(all: []string, argv: []string) -> string {
    let cursor, _, count = scan_opts(argv)
    let chunk = slice_skip_take(all, cursor, count)
    let mut next = cursor + len(chunk)
    if next >= len(all) {
        next = 0
    }
    return r_scan(format_int(next), chunk)
}

fn Store_cmd_hscan(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("hscan")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_HASH {
        return r_wrongtype()
    }
    let cursor, pat, count = scan_opts(argv)
    let mut fields = make([]string, 0, 8)
    if t == T_HASH {
        let h = self.hashes[ik]
        for f, _ in range h {
            if str_eq(pat, "*") or glob_match(pat, f) == 1 {
                fields = append(fields, f)
            }
        }
        fields = sort_strings(fields)
    }
    let page_f = slice_skip_take(fields, cursor, count)
    let mut next = cursor + len(page_f)
    if next >= len(fields) {
        next = 0
    }
    let mut chunk = make([]string, 0, len(page_f) * 2)
    if t == T_HASH {
        let h = self.hashes[ik]
        let mut i = 0
        while i < len(page_f) {
            let f = page_f[i]
            chunk = append(chunk, f)
            chunk = append(chunk, h[f])
            i = i + 1
        }
    }
    return r_scan(format_int(next), chunk)
}

fn Store_cmd_sscan(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("sscan")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_SET {
        return r_wrongtype()
    }
    let _, pat, _ = scan_opts(argv)
    let mut all = make([]string, 0, 8)
    if t == T_SET {
        let raw = set_members(self.sets[ik])
        let mut i = 0
        while i < len(raw) {
            if str_eq(pat, "*") or glob_match(pat, raw[i]) == 1 {
                all = append(all, raw[i])
            }
            i = i + 1
        }
        all = sort_strings(all)
    }
    return scan_page(all, argv)
}

fn Store_cmd_zscan(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("zscan")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_ZSET {
        return r_wrongtype()
    }
    let cursor, pat, count = scan_opts(argv)
    let mut fmems = make([]string, 0, 8)
    let mut fscs = make([]string, 0, 8)
    if t == T_ZSET {
        let mems, scs = z_sorted(self.zsets[ik])
        let mut i = 0
        while i < len(mems) {
            if str_eq(pat, "*") or glob_match(pat, mems[i]) == 1 {
                fmems = append(fmems, mems[i])
                fscs = append(fscs, scs[i])
            }
            i = i + 1
        }
    }
    let page_m = slice_skip_take(fmems, cursor, count)
    let page_s = slice_skip_take(fscs, cursor, count)
    let mut next = cursor + len(page_m)
    if next >= len(fmems) {
        next = 0
    }
    let mut chunk = make([]string, 0, len(page_m) * 2)
    let mut i = 0
    while i < len(page_m) {
        chunk = append(chunk, page_m[i])
        chunk = append(chunk, page_s[i])
        i = i + 1
    }
    return r_scan(format_int(next), chunk)
}

fn Store_cmd_hstrlen(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("hstrlen")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_HASH {
        return r_wrongtype()
    }
    let h = self.hashes[ik]
    if not has(h, argv[2]) {
        return r_int(0)
    }
    return r_int(str_len(h[argv[2]]))
}

fn Store_cmd_hrandfield(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("hrandfield")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        if len(argv) >= 3 {
            let none: []string = []
            return r_array_bulks(none)
        }
        return r_nil()
    }
    if t != T_HASH {
        return r_wrongtype()
    }
    let h = self.hashes[ik]
    let mut fs = make([]string, 0, len(h))
    for f, _ in range h {
        fs = append(fs, f)
    }
    if len(fs) == 0 {
        if len(argv) >= 3 {
            let none: []string = []
            return r_array_bulks(none)
        }
        return r_nil()
    }
    if len(argv) >= 3 {
        let n0, ok = int_ok(argv[2])
        if ok == 0 {
            return r_notint()
        }
        let mut with_vals = 0
        if len(argv) == 4 {
            if str_eq(str_to_upper(argv[3]), "WITHVALUES") {
                with_vals = 1
            } else {
                return r_syntax()
            }
        } else if len(argv) > 4 {
            return r_syntax()
        }
        if n0 == 0 {
            let none: []string = []
            return r_array_bulks(none)
        }
        let mut out: []string = []
        if n0 > 0 {
            let mut pool = make([]string, 0, len(fs))
            let mut j = 0
            while j < len(fs) {
                pool = append(pool, fs[j])
                j = j + 1
            }
            let mut take = n0
            if take > len(pool) {
                take = len(pool)
            }
            let mut i = 0
            while i < take {
                let rem = len(pool) - i
                let pick = i + rand_intn(rem)
                let f = pool[pick]
                pool[pick] = pool[i]
                pool[i] = f
                out = append(out, f)
                if with_vals == 1 {
                    out = append(out, h[f])
                }
                i = i + 1
            }
        } else {
            let mut n = 0 - n0
            if n > 10000 {
                n = 10000
            }
            let mut i = 0
            while i < n {
                let f = fs[rand_intn(len(fs))]
                out = append(out, f)
                if with_vals == 1 {
                    out = append(out, h[f])
                }
                i = i + 1
            }
        }
        return r_array_bulks(out)
    }
    return r_bulk(fs[rand_intn(len(fs))])
}

fn Store_cmd_zmscore(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("zmscore")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    let mut items = make([]string, 0, len(argv) - 2)
    let mut hit = make([]int, 0, len(argv) - 2)
    let mut i = 2
    while i < len(argv) {
        if t == T_ZSET and has(self.zsets[ik], argv[i]) {
            items = append(items, self.zsets[ik][argv[i]])
            hit = append(hit, 1)
        } else if t != T_NONE and t != T_ZSET {
            return r_wrongtype()
        } else {
            items = append(items, "")
            hit = append(hit, 0)
        }
        i = i + 1
    }
    return r_array_opt(items, hit)
}

fn Store_cmd_zremrangebyscore(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("zremrangebyscore")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let mut z = self.zsets[ik]
    let mut n = 0
    let mut drop: []string = []
    for m, sc in range z {
        if z_bound_ok(sc, argv[2], argv[3]) == 1 {
            drop = append(drop, m)
        }
    }
    let mut i = 0
    while i < len(drop) {
        delete(z, drop[i])
        n = n + 1
        i = i + 1
    }
    if len(z) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.zsets[ik] = z
    }
    return r_int(n)
}

fn Store_cmd_move(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("move")
    }
    let ndb, ok = int_ok(argv[2])
    if ok == 0 or ndb < 0 or ndb > 15 {
        return r_err("ERR DB index is out of range")
    }
    if ndb == db {
        return r_int(0)
    }
    let src = ikey(db, argv[1])
    let dst = ikey(ndb, argv[1])
    if self.live(src) == 0 {
        return r_int(0)
    }
    if self.live(dst) == 1 {
        return r_int(0)
    }
    self.rekey(src, dst)
    return r_int(1)
}

fn Store_cmd_rpoplpush(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("rpoplpush")
    }
    return self.cmd_lmove(db, ["LMOVE", argv[1], argv[2], "RIGHT", "LEFT"])
}

fn Store_cmd_expiretime(mut self: Store, db: int, argv: []string, div: int) -> string {
    if len(argv) != 2 {
        return r_arity("expiretime")
    }
    let ik = ikey(db, argv[1])
    if self.live(ik) == 0 {
        return r_int(0 - 2)
    }
    if not has(self.expire, ik) {
        return r_int(0 - 1)
    }
    let at = self.expire[ik]
    if div == 1 {
        return r_int(at)
    }
    return r_int(at / 1000)
}

fn Store_export_one(mut self: Store, db: int, k: string) -> string {
    let ik = ikey(db, k)
    let t = self.kind(ik)
    if t == T_NONE {
        return ""
    }
    let b = str_builder()
    if t == T_STR {
        let mut a = make([]string, 0, 5)
        a = append(a, "SET")
        a = append(a, k)
        a = append(a, self.strs[ik])
        if has(self.expire, ik) {
            a = append(a, "PXAT")
            a = append(a, format_int(self.expire[ik]))
        }
        builder_write(b, encode_array(a))
    } else if t == T_HASH {
        let h = self.hashes[ik]
        let mut a = make([]string, 0, 8)
        a = append(a, "HSET")
        a = append(a, k)
        for f, v in range h {
            a = append(a, f)
            a = append(a, v)
        }
        if len(a) > 2 {
            builder_write(b, encode_array(a))
        }
        if len(self.xseq) > 0 and has(self.xseq, hk_has(ik)) {
            for f, _ in range h {
                let ek = hk_exp(ik, f)
                if has(self.xseq, ek) {
                    builder_write(b, encode_array(["HPEXPIREAT", k, format_int(self.xseq[ek]), "FIELDS", "1", f]))
                }
            }
        }
    } else if t == T_LIST {
        let xs = self.list_norm(ik)
        if len(xs) > 0 {
            let mut a = make([]string, 0, len(xs) + 2)
            a = append(a, "RPUSH")
            a = append(a, k)
            let mut j = 0
            while j < len(xs) {
                a = append(a, xs[j])
                j = j + 1
            }
            builder_write(b, encode_array(a))
        }
    } else if t == T_SET {
        let s = self.sets[ik]
        let mut a = make([]string, 0, 8)
        a = append(a, "SADD")
        a = append(a, k)
        for m, _ in range s {
            a = append(a, m)
        }
        if len(a) > 2 {
            builder_write(b, encode_array(a))
        }
    } else if t == T_ZSET {
        let z = self.zsets[ik]
        let mut a = make([]string, 0, 8)
        a = append(a, "ZADD")
        a = append(a, k)
        for m, sc in range z {
            a = append(a, sc)
            a = append(a, m)
        }
        if len(a) > 2 {
            builder_write(b, encode_array(a))
        }
    } else if t == T_STREAM {
        if has(self.streams, ik) {
            let xs = self.streams[ik]
            let mut j = 0
            while j < len(xs) {
                let parts = str_split(xs[j], "\u001f")
                let mut a = make([]string, 0, 6)
                a = append(a, "XADD")
                a = append(a, k)
                if len(parts) > 0 {
                    a = append(a, parts[0])
                } else {
                    a = append(a, "*")
                }
                let mut p = 1
                while p < len(parts) {
                    a = append(a, parts[p])
                    p = p + 1
                }
                builder_write(b, encode_array(a))
                j = j + 1
            }
        }
    } else if t == T_VEC {
        if has(self.vecs, ik) {
            let v = self.vecs[ik]
            for elem, packed in range v {
                let mut a = make([]string, 0, 8)
                a = append(a, "VADD")
                a = append(a, k)
                a = append(a, elem)
                let parts = str_split(packed, ",")
                let mut p = 0
                while p < len(parts) {
                    if str_len(parts[p]) > 0 {
                        a = append(a, parts[p])
                    }
                    p = p + 1
                }
                if len(a) > 3 {
                    builder_write(b, encode_array(a))
                }
                if has(self.vtxt, ik) and has(self.vtxt[ik], elem) {
                    let mut ta = make([]string, 0, 4)
                    ta = append(ta, "VATTR")
                    ta = append(ta, k)
                    ta = append(ta, elem)
                    ta = append(ta, self.vtxt[ik][elem])
                    builder_write(b, encode_array(ta))
                }
            }
        }
    }
    if t != T_STR and has(self.expire, ik) {
        builder_write(b, encode_array(["PEXPIREAT", k, format_int(self.expire[ik])]))
    }
    return builder_string(b)
}

fn Store_cmd_dump(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("dump")
    }
    let payload = self.export_one(db, argv[1])
    if str_len(payload) == 0 {
        return r_nil()
    }
    return r_bulk("BND1\n" + payload)
}

fn Store_cmd_restore(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 {
        return r_arity("restore")
    }
    let k = argv[1]
    let ttl, ok = int_ok(argv[2])
    if ok == 0 {
        return r_notint()
    }
    let mut payload = argv[3]
    if str_has_prefix(payload, "BND1\n") {
        payload = payload[5:]
    }
    let ik = ikey(db, k)
    if self.live(ik) == 1 {
        let mut replace = 0
        let mut i = 4
        while i < len(argv) {
            if str_eq(str_to_upper(argv[i]), "REPLACE") {
                replace = 1
            }
            i = i + 1
        }
        if replace == 0 {
            return r_err("BUSYKEY Target key name already exists.")
        }
        let _ = self.drop_key(ik)
    }
    let mut pos = 0
    let n = str_len(payload)
    while pos < n {
        let parsed, next_pos, st = parse_cmd_at(payload, pos)
        if st != 1 or next_pos <= pos {
            break
        }
        let mut cmdv = make([]string, 0, len(parsed))
        let mut ci = 0
        while ci < len(parsed) {
            if ci == 1 {
                cmdv = append(cmdv, k)
            } else {
                cmdv = append(cmdv, parsed[ci])
            }
            ci = ci + 1
        }
        let _ = self.apply(db, cmdv)
        pos = next_pos
    }
    if ttl > 0 {
        let _ = self.cmd_expire(db, ["PEXPIRE", k, format_int(ttl)], 1)
    }
    return r_ok()
}

fn Store_cmd_zrandmember(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("zrandmember")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        if len(argv) >= 3 {
            let none: []string = []
            return r_array_bulks(none)
        }
        return r_nil()
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let mems, scs = z_sorted(self.zsets[ik])
    if len(mems) == 0 {
        if len(argv) >= 3 {
            let none: []string = []
            return r_array_bulks(none)
        }
        return r_nil()
    }
    if len(argv) >= 3 {
        let n0, ok = int_ok(argv[2])
        if ok == 0 {
            return r_notint()
        }
        let mut with_scores = 0
        if len(argv) == 4 {
            if str_eq(str_to_upper(argv[3]), "WITHSCORES") {
                with_scores = 1
            } else {
                return r_syntax()
            }
        } else if len(argv) > 4 {
            return r_syntax()
        }
        if n0 == 0 {
            let none: []string = []
            return r_array_bulks(none)
        }
        let mut out: []string = []
        if n0 > 0 {
            let mut idxs = make([]int, 0, len(mems))
            let mut j = 0
            while j < len(mems) {
                idxs = append(idxs, j)
                j = j + 1
            }
            let mut take = n0
            if take > len(idxs) {
                take = len(idxs)
            }
            let mut i = 0
            while i < take {
                let rem = len(idxs) - i
                let pick = i + rand_intn(rem)
                let idx = idxs[pick]
                idxs[pick] = idxs[i]
                idxs[i] = idx
                out = append(out, mems[idx])
                if with_scores == 1 {
                    out = append(out, scs[idx])
                }
                i = i + 1
            }
        } else {
            let mut n = 0 - n0
            if n > 10000 {
                n = 10000
            }
            let mut i = 0
            while i < n {
                let idx = rand_intn(len(mems))
                out = append(out, mems[idx])
                if with_scores == 1 {
                    out = append(out, scs[idx])
                }
                i = i + 1
            }
        }
        return r_array_bulks(out)
    }
    return r_bulk(mems[rand_intn(len(mems))])
}

fn Store_cmd_lpos(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("lpos")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nil()
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    let xs = self.list_norm(ik)
    let mut i = 0
    while i < len(xs) {
        if str_eq(xs[i], argv[2]) {
            return r_int(i)
        }
        i = i + 1
    }
    return r_nil()
}

fn Store_cmd_hincrbyfloat(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("hincrbyfloat")
    }
    if finite_score(argv[3]) == 0 {
        return r_err("ERR value is not a valid float")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_HASH {
        return r_wrongtype()
    }
    if t == T_HASH and has(self.hashes[ik], argv[2]) {
        if finite_score(self.hashes[ik][argv[2]]) == 0 {
            return r_err("ERR hash value is not a float")
        }
    }
    let _ = self.ensure_hash(ik)
    let mut h = self.hashes[ik]
    let mut cur = 0.0
    if has(h, argv[2]) {
        cur = parse_float(h[argv[2]])
    }
    let n = parse_float(argv[3])
    let v = format_float(cur + n, 6)
    h[argv[2]] = v
    self.hashes[ik] = h
    return r_bulk(v)
}

fn Store_cmd_hsetnx(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("hsetnx")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_HASH {
        return r_wrongtype()
    }
    let _ = self.ensure_hash(ik)
    let mut h = self.hashes[ik]
    if has(h, argv[2]) {
        return r_int(0)
    }
    h[argv[2]] = argv[3]
    self.hashes[ik] = h
    return r_int(1)
}



fn Store_cmd_lpushx(mut self: Store, db: int, argv: []string, right: int) -> string {
    if len(argv) < 3 {
        return r_arity("lpushx")
    }
    let ik = ikey(db, argv[1])
    if self.kind(ik) != T_LIST {
        return r_int(0)
    }
    return self.cmd_lpush(db, argv, right)
}

fn Store_cmd_sintercard(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("sintercard")
    }
    let nk, ok = int_ok(argv[1])
    if ok == 0 or nk < 1 or 2 + nk > len(argv) {
        return r_syntax()
    }
    let ik0 = ikey(db, argv[2])
    if self.kind(ik0) != T_SET {
        return r_int(0)
    }
    let first = set_members(self.sets[ik0])
    let mut n = 0
    let mut fi = 0
    while fi < len(first) {
        let mut in_all = 1
        let mut j = 1
        while j < nk {
            let ik = ikey(db, argv[2 + j])
            if self.kind(ik) != T_SET {
                in_all = 0
            } else if not has(self.sets[ik], first[fi]) {
                in_all = 0
            }
            j = j + 1
        }
        if in_all == 1 {
            n = n + 1
        }
        fi = fi + 1
    }
    return r_int(n)
}

fn Store_cmd_zunion(mut self: Store, db: int, argv: []string, mode: int) -> string {
    if len(argv) < 3 {
        return r_arity("zunion")
    }
    let nk, ok = int_ok(argv[1])
    if ok == 0 or nk < 1 or 2 + nk > len(argv) {
        return r_syntax()
    }
    let mut acc = make(map[string]string)
    let mut i = 0
    while i < nk {
        let ik = ikey(db, argv[2 + i])
        let t = self.kind(ik)
        let mut cur = make(map[string]string)
        if t == T_ZSET {
            let src_z = self.zsets[ik]
            for m, sc in range src_z {
                cur[m] = sc
            }
        } else if t == T_SET {
            let s = self.sets[ik]
            for m, _ in range s {
                cur[m] = "1"
            }
        } else if t != T_NONE {
            return r_wrongtype()
        }
        if mode == 0 {
            for m, sc in range cur {
                if has(acc, m) {
                    acc[m] = format_float(parse_float(acc[m]) + parse_float(sc), 6)
                } else {
                    acc[m] = sc
                }
            }
        } else if mode == 1 {
            if i == 0 {
                for m, sc in range cur {
                    acc[m] = sc
                }
            } else {
                let mut drop: []string = []
                let mut keep_m: []string = []
                let mut keep_s: []string = []
                for m, sc in range acc {
                    if has(cur, m) {
                        keep_m = append(keep_m, m)
                        keep_s = append(keep_s, format_float(parse_float(sc) + parse_float(cur[m]), 6))
                    } else {
                        drop = append(drop, m)
                    }
                }
                let mut di = 0
                while di < len(drop) {
                    delete(acc, drop[di])
                    di = di + 1
                }
                let mut ki = 0
                while ki < len(keep_m) {
                    acc[keep_m[ki]] = keep_s[ki]
                    ki = ki + 1
                }
            }
        } else {
            if i == 0 {
                for m, sc in range cur {
                    acc[m] = sc
                }
            } else {
                for m, _ in range cur {
                    if has(acc, m) {
                        delete(acc, m)
                    }
                }
            }
        }
        i = i + 1
    }
    let mut with_scores = 0
    if len(argv) > 2 + nk and str_eq(str_to_upper(argv[2 + nk]), "WITHSCORES") {
        with_scores = 1
    }
    let mems, scs = z_sorted(acc)
    if with_scores == 0 {
        return r_array_bulks(mems)
    }
    let mut items = make([]string, 0, len(mems) * 2)
    let mut mi = 0
    while mi < len(mems) {
        items = append(items, mems[mi])
        items = append(items, scs[mi])
        mi = mi + 1
    }
    return r_array_bulks(items)
}

fn Store_cmd_zunionstore_mode(mut self: Store, db: int, argv: []string, mode: int) -> string {
    if mode == 0 {
        return self.cmd_zunionstore(db, argv)
    }
    if len(argv) < 4 {
        return r_arity("zinterstore")
    }
    let dest = argv[1]
    let nk, ok = int_ok(argv[2])
    if ok == 0 or nk < 1 or 3 + nk > len(argv) {
        return r_syntax()
    }
    let mut zargv = make([]string, 0, nk + 3)
    zargv = append(zargv, "ZUNION")
    zargv = append(zargv, argv[2])
    let mut i = 0
    while i < nk {
        zargv = append(zargv, argv[3 + i])
        i = i + 1
    }
    zargv = append(zargv, "WITHSCORES")
    let r = self.cmd_zunion(db, zargv, mode)
    if str_has_prefix(r, "-") {
        return r
    }
    let mems = parse_array_bulks(r)
    let dik = ikey(db, dest)
    if self.live(dik) == 1 {
        let _ = self.drop_key(dik)
    }
    if len(mems) == 0 {
        return r_int(0)
    }
    let mut z = make(map[string]string)
    i = 0
    while i + 1 < len(mems) {
        z[mems[i]] = mems[i + 1]
        i = i + 2
    }
    self.zsets[dik] = z
    self.types[dik] = T_ZSET
    return r_int(len(mems) / 2)
}

fn Store_cmd_zrevrangebyscore(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 {
        return r_arity("zrevrangebyscore")
    }
    let mut with_scores = 0
    let mut off = 0
    let mut lim = -1
    let mut idx = 4
    while idx < len(argv) {
        let opt = str_to_upper(argv[idx])
        if str_eq(opt, "WITHSCORES") {
            with_scores = 1
            idx = idx + 1
        } else if str_eq(opt, "LIMIT") {
            if idx + 2 >= len(argv) {
                return r_syntax()
            }
            let o, oko = int_ok(argv[idx + 1])
            let c, okc = int_ok(argv[idx + 2])
            if oko == 0 or okc == 0 {
                return r_notint()
            }
            off = o
            lim = c
            idx = idx + 3
        } else {
            return r_syntax()
        }
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        let none: []string = []
        return r_array_bulks(none)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let mems, scs = z_sorted(self.zsets[ik])
    let mut out = make([]string, 0, len(mems))
    let mut matched = 0
    let mut taken = 0
    let mut i = len(mems) - 1
    while i >= 0 {
        if z_bound_ok(scs[i], argv[3], argv[2]) == 1 {
            if matched >= off {
                if lim < 0 or taken < lim {
                    out = append(out, mems[i])
                    if with_scores == 1 {
                        out = append(out, scs[i])
                    }
                    taken = taken + 1
                }
            }
            matched = matched + 1
        }
        i = i - 1
    }
    return r_array_bulks(out)
}

fn Store_cmd_zremrangebyrank(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("zremrangebyrank")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let a0, oka = int_ok(argv[2])
    let b0, okb = int_ok(argv[3])
    if oka == 0 or okb == 0 {
        return r_notint()
    }
    let mut a = a0
    let mut b = b0
    let mems, _ = z_sorted(self.zsets[ik])
    let n = len(mems)
    if a < 0 {
        a = n + a
    }
    if b < 0 {
        b = n + b
    }
    if a < 0 {
        a = 0
    }
    if b >= n {
        b = n - 1
    }
    if a > b or n == 0 {
        return r_int(0)
    }
    let mut z = self.zsets[ik]
    let mut i = a
    let mut dropped = 0
    while i <= b {
        delete(z, mems[i])
        dropped = dropped + 1
        i = i + 1
    }
    if len(z) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.zsets[ik] = z
    }
    return r_int(dropped)
}

fn Store_rekey(mut self: Store, src: string, dst: string) {
    if str_eq(src, dst) or not has(self.types, src) {
        return
    }
    let t = self.types[src]
    self.types[dst] = t
    if t == T_STR and has(self.strs, src) {
        self.strs[dst] = self.strs[src]
    } else if t == T_HASH and has(self.hashes, src) {
        self.hashes[dst] = self.hashes[src]
        if len(self.xseq) > 0 and has(self.xseq, hk_has(src)) {
            self.xseq[hk_has(dst)] = self.xseq[hk_has(src)]
            let h = self.hashes[src]
            for f, _ in range h {
                let sek = hk_exp(src, f)
                if has(self.xseq, sek) {
                    self.xseq[hk_exp(dst, f)] = self.xseq[sek]
                }
            }
        }
    } else if t == T_LIST and has(self.lists, src) {
        self.lists[dst] = self.lists[src]
        if len(self.xseq) > 0 and has(self.xseq, lk_head(src)) {
            self.xseq[lk_head(dst)] = self.xseq[lk_head(src)]
        }
    } else if t == T_SET and has(self.sets, src) {
        self.sets[dst] = self.sets[src]
    } else if t == T_ZSET and has(self.zsets, src) {
        self.zsets[dst] = self.zsets[src]
    } else if t == T_STREAM and has(self.streams, src) {
        self.streams[dst] = self.streams[src]
        if has(self.xseq, src) {
            self.xseq[dst] = self.xseq[src]
        }
    } else if t == T_VEC {
        if has(self.vecs, src) {
            self.vecs[dst] = self.vecs[src]
        }
        if has(self.vtxt, src) {
            self.vtxt[dst] = self.vtxt[src]
        }
        if has(self.vdim, src) {
            self.vdim[dst] = self.vdim[src]
        }
    }
    if has(self.expire, src) {
        self.expire[dst] = self.expire[src]
    }
    let _ = self.drop_key(src)
}

fn Store_cmd_swapdb(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("swapdb")
    }
    let a, oka = int_ok(argv[1])
    let b, okb = int_ok(argv[2])
    if oka == 0 or okb == 0 or a < 0 or b < 0 or a > 15 or b > 15 {
        return r_err("ERR DB index is out of range")
    }
    if a == b {
        return r_ok()
    }
    let ka = self.collect_keys(a, "*")
    let kb = self.collect_keys(b, "*")
    let tmp = 99
    let mut i = 0
    while i < len(ka) {
        self.rekey(ikey(a, ka[i]), ikey(tmp, ka[i]))
        i = i + 1
    }
    i = 0
    while i < len(kb) {
        self.rekey(ikey(b, kb[i]), ikey(a, kb[i]))
        i = i + 1
    }
    i = 0
    while i < len(ka) {
        self.rekey(ikey(tmp, ka[i]), ikey(b, ka[i]))
        i = i + 1
    }
    return r_ok()
}

fn Store_payload_bytes(mut self: Store, ik: string) -> int {
    if not has(self.types, ik) {
        return 0
    }
    let t = self.types[ik]
    let mut n = ukey_len(ik) + 16
    if t == T_STR {
        if has(self.strs, ik) {
            n = n + str_len(self.strs[ik])
        }
    } else if t == T_HASH {
        if has(self.hashes, ik) {
            let h = self.hashes[ik]
            for f, v in range h {
                n = n + str_len(f) + str_len(v) + 8
            }
        }
    } else if t == T_LIST {
        if has(self.lists, ik) {
            let xs = self.lists[ik]
            let mut i = 0
            if len(self.xseq) > 0 and has(self.xseq, lk_head(ik)) {
                i = self.xseq[lk_head(ik)]
            }
            while i < len(xs) {
                n = n + str_len(xs[i]) + 8
                i = i + 1
            }
        }
    } else if t == T_SET {
        if has(self.sets, ik) {
            let s = self.sets[ik]
            for m, _ in range s {
                n = n + str_len(m) + 8
            }
        }
    } else if t == T_ZSET {
        if has(self.zsets, ik) {
            let z = self.zsets[ik]
            for m, sc in range z {
                n = n + str_len(m) + str_len(sc) + 8
            }
        }
    } else if t == T_STREAM {
        if has(self.streams, ik) {
            let xs = self.streams[ik]
            let mut i = 0
            while i < len(xs) {
                n = n + str_len(xs[i]) + 8
                i = i + 1
            }
        }
        let pref = ik + "\u001e"
        for gk, last in range self.xg {
            if str_has_prefix(gk, pref) {
                n = n + str_len(gk) + str_len(last)
            }
        }
        for gk, pend in range self.xp {
            if str_has_prefix(gk, pref) {
                n = n + str_len(pend)
            }
        }
    } else if t == T_VEC {
        if has(self.vecs, ik) {
            let v = self.vecs[ik]
            for id, s in range v {
                n = n + str_len(id) + str_len(s) + 8
            }
        }
        if has(self.vtxt, ik) {
            let tx = self.vtxt[ik]
            for id, s in range tx {
                n = n + str_len(id) + str_len(s)
            }
        }
    }
    return n
}

fn Store_recount(mut self: Store, _n: int) -> int {
    let mut keys = make([]string, 0, 8)
    for ik, _ in range self.types {
        keys = append(keys, ik)
    }
    let mut n = 0
    let mut i = 0
    while i < len(keys) {
        n = n + self.payload_bytes(keys[i])
        i = i + 1
    }
    let _ = self.charge(n - self.used)
    return self.used
}

fn Store_cmd_memory(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) >= 3 and str_eq(str_to_upper(argv[1]), "USAGE") {
        let ik = ikey(db, argv[2])
        if self.live(ik) == 0 {
            return r_nil()
        }
        return r_int(self.payload_bytes(ik))
    }
    return r_int(self.recount(0))
}

fn Store_cmd_hgetdel(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("hgetdel")
    }
    let g = self.cmd_hget(db, ["HGET", argv[1], argv[2]])
    if str_has_prefix(g, "$") and not str_eq(g, r_nil()) {
        let _ = self.cmd_hdel(db, ["HDEL", argv[1], argv[2]])
    }
    return g
}

fn Store_cmd_lmpop(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 {
        return r_arity("lmpop")
    }
    let nk, ok = int_ok(argv[1])
    if ok == 0 or nk < 1 or 2 + nk >= len(argv) {
        return r_syntax()
    }
    let mut right = 0
    let mut count = 1
    let mut i = 2 + nk
    while i < len(argv) {
        let o = str_to_upper(argv[i])
        if str_eq(o, "RIGHT") {
            right = 1
        } else if str_eq(o, "LEFT") {
            right = 0
        } else if str_eq(o, "COUNT") and i + 1 < len(argv) {
            count = int_of(argv[i + 1])
            i = i + 1
        }
        i = i + 1
    }
    let mut k = 0
    while k < nk {
        let key = argv[2 + k]
        let ik = ikey(db, key)
        if self.kind(ik) == T_LIST and self.list_len(ik) > 0 {
            let mut pop = "LPOP"
            if right == 1 {
                pop = "RPOP"
            }
            let r = self.cmd_lpop(db, [pop, key, format_int(count)], right)
            if str_has_prefix(r, "*") and not str_has_prefix(r, "*0") {
                let b = str_builder()
                builder_write(b, "*2\r\n")
                builder_write(b, r_bulk(key))
                builder_write(b, r)
                return builder_string(b)
            }
        }
        k = k + 1
    }
    return r_nil()
}

fn Store_cmd_zmpop(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 {
        return r_arity("zmpop")
    }
    let nk, ok = int_ok(argv[1])
    if ok == 0 or nk < 1 or 2 + nk >= len(argv) {
        return r_syntax()
    }
    let mut rev = 0
    let mut count = 1
    let mut i = 2 + nk
    while i < len(argv) {
        let o = str_to_upper(argv[i])
        if str_eq(o, "MAX") {
            rev = 1
        } else if str_eq(o, "MIN") {
            rev = 0
        } else if str_eq(o, "COUNT") and i + 1 < len(argv) {
            count = int_of(argv[i + 1])
            i = i + 1
        }
        i = i + 1
    }
    let mut k = 0
    while k < nk {
        let key = argv[2 + k]
        let ik = ikey(db, key)
        if self.kind(ik) == T_ZSET {
            let r = self.cmd_zpop(db, ["ZPOPMIN", key, format_int(count)], rev)
            if str_has_prefix(r, "*") and not str_has_prefix(r, "*0") {
                let b = str_builder()
                builder_write(b, "*2\r\n")
                builder_write(b, r_bulk(key))
                builder_write(b, r)
                return builder_string(b)
            }
        }
        k = k + 1
    }
    return r_nil()
}

fn r_int_array(xs: []int) -> string {
    let b = str_builder()
    builder_write(b, "*")
    builder_write(b, format_int(len(xs)))
    builder_write(b, "\r\n")
    let mut i = 0
    while i < len(xs) {
        builder_write(b, r_int(xs[i]))
        i = i + 1
    }
    return builder_string(b)
}

fn parse_hfields_tail(argv: []string, idx: int) -> ([]string, int) {
    let empty: []string = []
    if idx >= len(argv) {
        return (empty, 0)
    }
    if str_eq(str_to_upper(argv[idx]), "FIELDS") {
        if idx + 2 >= len(argv) {
            return (empty, 0)
        }
        let nf, ok = int_ok(argv[idx + 1])
        if ok == 0 or nf < 1 or idx + 2 + nf != len(argv) {
            return (empty, 0)
        }
        return (argv[idx + 2:], 1)
    }
    return (argv[idx:], 1)
}

fn Store_cmd_hexpire(mut self: Store, db: int, argv: []string, mul: int, is_at: int) -> string {
    if len(argv) < 4 {
        return r_arity(str_to_lower(argv[0]))
    }
    let mut raw_t = argv[2]
    let mut opt_idx = 3
    let mut n, ok = int_ok(raw_t)
    let mut shorthand_field = ""
    if ok == 0 and len(argv) >= 4 {
        let n2, ok2 = int_ok(argv[3])
        if ok2 == 1 {
            shorthand_field = argv[2]
            n = n2
            ok = 1
            opt_idx = 4
        }
    }
    if ok == 0 {
        return r_notint()
    }
    let mut nx = 0
    let mut xx = 0
    let mut gt = 0
    let mut lt = 0
    while opt_idx < len(argv) {
        let o = str_to_upper(argv[opt_idx])
        if str_eq(o, "NX") {
            nx = 1
            opt_idx = opt_idx + 1
        } else if str_eq(o, "XX") {
            xx = 1
            opt_idx = opt_idx + 1
        } else if str_eq(o, "GT") {
            gt = 1
            opt_idx = opt_idx + 1
        } else if str_eq(o, "LT") {
            lt = 1
            opt_idx = opt_idx + 1
        } else {
            break
        }
    }
    if nx == 1 and (xx == 1 or gt == 1 or lt == 1) {
        return r_err("ERR NX and XX, GT or LT options at the same time are not compatible")
    }
    if gt == 1 and lt == 1 {
        return r_err("ERR GT and LT options at the same time are not compatible")
    }
    let mut fields: []string = []
    if str_len(shorthand_field) > 0 {
        if opt_idx != len(argv) {
            return r_syntax()
        }
        fields = [shorthand_field]
    } else {
        let fs, fok = parse_hfields_tail(argv, opt_idx)
        if fok == 0 or len(fs) == 0 {
            return r_syntax()
        }
        fields = fs
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_HASH {
        return r_wrongtype()
    }
    let mut res = make([]int, 0, len(fields))
    if t == T_NONE {
        let mut i = 0
        while i < len(fields) {
            res = append(res, 0 - 2)
            i = i + 1
        }
        return r_int_array(res)
    }
    let now = wall_ms()
    let mut at = n * mul
    if is_at == 0 {
        at = now + n * mul
    }
    let expired_imm = if (is_at == 0 and n <= 0) or (is_at == 1 and at <= now) { 1 } else { 0 }
    let mut h = self.hashes[ik]
    let mut fi = 0
    while fi < len(fields) {
        let f = fields[fi]
        if not has(h, f) {
            res = append(res, 0 - 2)
        } else {
            let ek = hk_exp(ik, f)
            let has_e = if has(self.xseq, ek) { 1 } else { 0 }
            let old_at = if has_e == 1 { self.xseq[ek] } else { 0 }
            let mut cond_ok = 1
            if nx == 1 and has_e == 1 {
                cond_ok = 0
            }
            if xx == 1 and has_e == 0 {
                cond_ok = 0
            }
            if gt == 1 {
                if has_e == 0 or at <= old_at {
                    cond_ok = 0
                }
            }
            if lt == 1 {
                if has_e == 1 and at >= old_at {
                    cond_ok = 0
                }
            }
            if cond_ok == 0 {
                res = append(res, 0)
            } else if expired_imm == 1 {
                delete(h, f)
                delete(self.xseq, ek)
                res = append(res, 2)
            } else {
                self.xseq[ek] = at
                self.xseq[hk_has(ik)] = 1
                res = append(res, 1)
            }
        }
        fi = fi + 1
    }
    if len(h) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.hashes[ik] = h
    }
    return r_int_array(res)
}

fn Store_cmd_httl(mut self: Store, db: int, argv: []string, div: int) -> string {
    if len(argv) < 3 {
        return r_arity(str_to_lower(argv[0]))
    }
    let fields, fok = parse_hfields_tail(argv, 2)
    if fok == 0 or len(fields) == 0 {
        return r_syntax()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_HASH {
        return r_wrongtype()
    }
    let mut res = make([]int, 0, len(fields))
    if t == T_NONE {
        let mut i = 0
        while i < len(fields) {
            res = append(res, 0 - 2)
            i = i + 1
        }
        return r_int_array(res)
    }
    let h = self.hashes[ik]
    let now = wall_ms()
    let mut i = 0
    while i < len(fields) {
        let f = fields[i]
        if not has(h, f) {
            res = append(res, 0 - 2)
        } else {
            let ek = hk_exp(ik, f)
            if not has(self.xseq, ek) {
                res = append(res, 0 - 1)
            } else {
                let left = self.xseq[ek] - now
                if left <= 0 {
                    res = append(res, 0 - 2)
                } else if div == 1 {
                    res = append(res, left)
                } else {
                    res = append(res, (left + 999) / 1000)
                }
            }
        }
        i = i + 1
    }
    return r_int_array(res)
}

fn Store_cmd_hpersist(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("hpersist")
    }
    let fields, fok = parse_hfields_tail(argv, 2)
    if fok == 0 or len(fields) == 0 {
        return r_syntax()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_HASH {
        return r_wrongtype()
    }
    let mut res = make([]int, 0, len(fields))
    if t == T_NONE {
        let mut i = 0
        while i < len(fields) {
            res = append(res, 0 - 2)
            i = i + 1
        }
        return r_int_array(res)
    }
    let h = self.hashes[ik]
    let mut i = 0
    while i < len(fields) {
        let f = fields[i]
        if not has(h, f) {
            res = append(res, 0 - 2)
        } else {
            let ek = hk_exp(ik, f)
            if not has(self.xseq, ek) {
                res = append(res, 0 - 1)
            } else {
                delete(self.xseq, ek)
                res = append(res, 1)
            }
        }
        i = i + 1
    }
    return r_int_array(res)
}

fn Store_cmd_hsetex(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 5 {
        return r_arity("hsetex")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_HASH {
        return r_wrongtype()
    }
    // Shorthand form: HSETEX key seconds field value [field value ...]
    let sec0, ok0 = int_ok(argv[2])
    if ok0 == 1 {
        if (len(argv) % 2) == 0 {
            return r_arity("hsetex")
        }
        if sec0 <= 0 {
            return r_err("ERR invalid expire time in 'hsetex' command")
        }
        if self.ensure_hash(ik) == 0 {
            return r_wrongtype()
        }
        let at = wall_ms() + sec0 * 1000
        let mut h = self.hashes[ik]
        let mut added = 0
        let mut i = 3
        while i + 1 < len(argv) {
            let f = argv[i]
            let v = argv[i + 1]
            if not has(h, f) {
                added = added + 1
            }
            h[f] = v
            self.xseq[hk_exp(ik, f)] = at
            i = i + 2
        }
        self.xseq[hk_has(ik)] = 1
        self.hashes[ik] = h
        return r_int(added)
    }

    // Redis 8.0 form: HSETEX key [FNX|FXX] [EX sec | PX ms | EXAT ts | PXAT ms-ts | KEEPTTL] FIELDS numfields field value ...
    let mut fnx = 0
    let mut fxx = 0
    let mut keepttl = 0
    let mut exp_at = 0
    let mut has_exp = 0
    let mut idx = 2
    while idx < len(argv) {
        let u = str_to_upper(argv[idx])
        if str_eq(u, "FNX") {
            fnx = 1
            idx = idx + 1
        } else if str_eq(u, "FXX") {
            fxx = 1
            idx = idx + 1
        } else if str_eq(u, "KEEPTTL") {
            keepttl = 1
            idx = idx + 1
        } else if str_eq(u, "EX") or str_eq(u, "PX") or str_eq(u, "EXAT") or str_eq(u, "PXAT") {
            if idx + 1 >= len(argv) {
                return r_syntax()
            }
            let val, vok = int_ok(argv[idx + 1])
            if vok == 0 {
                return r_notint()
            }
            if val <= 0 {
                return r_err("ERR invalid expire time in 'hsetex' command")
            }
            has_exp = 1
            if str_eq(u, "EX") {
                exp_at = wall_ms() + val * 1000
            } else if str_eq(u, "PX") {
                exp_at = wall_ms() + val
            } else if str_eq(u, "EXAT") {
                exp_at = val * 1000
            } else {
                exp_at = val
            }
            idx = idx + 2
        } else if str_eq(u, "FIELDS") {
            break
        } else {
            return r_syntax()
        }
    }
    if (fnx == 1 and fxx == 1) or (keepttl == 1 and has_exp == 1) {
        return r_syntax()
    }
    if idx + 1 >= len(argv) or not str_eq(str_to_upper(argv[idx]), "FIELDS") {
        return r_syntax()
    }
    let nf, nfok = int_ok(argv[idx + 1])
    if nfok == 0 or nf <= 0 {
        return r_err("ERR numfields must be greater than 0")
    }
    let start = idx + 2
    if start + nf * 2 != len(argv) {
        return r_syntax()
    }
    if fnx == 1 and t == T_HASH {
        let hcheck = self.hashes[ik]
        let mut j = 0
        while j < nf {
            if has(hcheck, argv[start + j * 2]) {
                return r_int(0)
            }
            j = j + 1
        }
    }
    if fxx == 1 {
        if t != T_HASH {
            return r_int(0)
        }
        let hcheck = self.hashes[ik]
        let mut j = 0
        while j < nf {
            if not has(hcheck, argv[start + j * 2]) {
                return r_int(0)
            }
            j = j + 1
        }
    }
    if self.ensure_hash(ik) == 0 {
        return r_wrongtype()
    }
    let mut h = self.hashes[ik]
    let mut j = 0
    while j < nf {
        let f = argv[start + j * 2]
        let v = argv[start + j * 2 + 1]
        h[f] = v
        let ek = hk_exp(ik, f)
        if has_exp == 1 {
            self.xseq[ek] = exp_at
            self.xseq[hk_has(ik)] = 1
        } else if keepttl == 0 {
            delete(self.xseq, ek)
        }
        j = j + 1
    }
    self.hashes[ik] = h
    return r_int(1)
}

fn Store_cmd_hexpiretime(mut self: Store, db: int, argv: []string, div: int) -> string {
    if len(argv) < 5 {
        return r_arity("hexpiretime")
    }
    if not str_eq(str_to_upper(argv[2]), "FIELDS") {
        return r_syntax()
    }
    let nf, nfok = int_ok(argv[3])
    if nfok == 0 or nf <= 0 or 4 + nf != len(argv) {
        return r_syntax()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_HASH {
        return r_wrongtype()
    }
    let b = str_builder()
    builder_write(b, "*")
    builder_write(b, fmt_int_fast(nf))
    builder_write(b, "\r\n")
    let mut j = 0
    while j < nf {
        let f = argv[4 + j]
        if t == T_NONE {
            builder_write(b, r_int(-2))
        } else {
            let h = self.hashes[ik]
            if not has(h, f) {
                builder_write(b, r_int(-2))
            } else {
                let ek = hk_exp(ik, f)
                if not has(self.xseq, ek) {
                    builder_write(b, r_int(-1))
                } else {
                    builder_write(b, r_int(self.xseq[ek] / div))
                }
            }
        }
        j = j + 1
    }
    return builder_string(b)
}

fn Store_cmd_hgetex(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 5 {
        return r_arity("hgetex")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_HASH {
        return r_wrongtype()
    }
    let mut idx = 2
    let mut mode = 0
    let mut exp_at = 0
    while idx < len(argv) {
        let u = str_to_upper(argv[idx])
        if str_eq(u, "PERSIST") {
            mode = 1
            idx = idx + 1
        } else if (str_eq(u, "EX") or str_eq(u, "PX") or str_eq(u, "EXAT") or str_eq(u, "PXAT")) and idx + 1 < len(argv) {
            let v, ok = int_ok(argv[idx + 1])
            if ok == 0 or v <= 0 {
                return r_err("ERR invalid expire time in 'hgetex' command")
            }
            mode = 2
            if str_eq(u, "EX") {
                exp_at = wall_ms() + v * 1000
            } else if str_eq(u, "PX") {
                exp_at = wall_ms() + v
            } else if str_eq(u, "EXAT") {
                exp_at = v * 1000
            } else {
                exp_at = v
            }
            idx = idx + 2
        } else {
            break
        }
    }
    if idx + 1 >= len(argv) or not str_eq(str_to_upper(argv[idx]), "FIELDS") {
        return r_syntax()
    }
    let nf, nfok = int_ok(argv[idx + 1])
    if nfok == 0 or nf <= 0 or idx + 2 + nf != len(argv) {
        return r_syntax()
    }
    let start = idx + 2
    let mut vals = make([]string, 0, nf)
    let mut present = make([]int, 0, nf)
    let now = wall_ms()
    if t == T_NONE {
        let mut j = 0
        while j < nf {
            vals = append(vals, "")
            present = append(present, 0)
            j = j + 1
        }
        return r_array_opt(vals, present)
    }
    let mut h = self.hashes[ik]
    let mut expired_now = 0
    let mut j = 0
    while j < nf {
        let f = argv[start + j]
        if has(h, f) {
            vals = append(vals, h[f])
            present = append(present, 1)
            let ek = hk_exp(ik, f)
            if mode == 1 {
                delete(self.xseq, ek)
            } else if mode == 2 {
                if exp_at <= now {
                    delete(h, f)
                    delete(self.xseq, ek)
                    expired_now = 1
                } else {
                    self.xseq[ek] = exp_at
                    self.xseq[hk_has(ik)] = 1
                }
            }
        } else {
            vals = append(vals, "")
            present = append(present, 0)
        }
        j = j + 1
    }
    if expired_now == 1 {
        if len(h) == 0 {
            let _ = self.drop_key(ik)
        } else {
            self.hashes[ik] = h
        }
    }
    return r_array_opt(vals, present)
}

fn z_lex_bound_valid(b: string) -> int {
    if str_eq(b, "-") or str_eq(b, "+") {
        return 1
    }
    if str_len(b) >= 1 {
        let c = str_byte_at(b, 0)
        if c == 91 or c == 40 {
            return 1
        }
    }
    return 0
}

fn z_lex_ge_min(mem: string, min_b: string) -> int {
    if str_eq(min_b, "-") {
        return 1
    }
    if str_eq(min_b, "+") {
        return 0
    }
    let c = str_byte_at(min_b, 0)
    let val = min_b[1:]
    if c == 91 {
        if str_eq(mem, val) or str_lt(val, mem) == 1 {
            return 1
        }
        return 0
    }
    if str_lt(val, mem) == 1 {
        return 1
    }
    return 0
}

fn z_lex_le_max(mem: string, max_b: string) -> int {
    if str_eq(max_b, "+") {
        return 1
    }
    if str_eq(max_b, "-") {
        return 0
    }
    let c = str_byte_at(max_b, 0)
    let val = max_b[1:]
    if c == 91 {
        if str_eq(mem, val) or str_lt(mem, val) == 1 {
            return 1
        }
        return 0
    }
    if str_lt(mem, val) == 1 {
        return 1
    }
    return 0
}

fn Store_cmd_zrangebylex(mut self: Store, db: int, argv: []string, rev: int) -> string {
    if len(argv) < 4 {
        return r_arity("zrangebylex")
    }
    let mut min_b = argv[2]
    let mut max_b = argv[3]
    if rev == 1 {
        max_b = argv[2]
        min_b = argv[3]
    }
    if z_lex_bound_valid(min_b) == 0 or z_lex_bound_valid(max_b) == 0 {
        return r_err("ERR min or max not valid string range item")
    }
    let mut lim_off = 0
    let mut lim_cnt = -1
    if len(argv) > 4 {
        if len(argv) != 7 or not str_eq(str_to_upper(argv[4]), "LIMIT") {
            return r_syntax()
        }
        let lo, loo = int_ok(argv[5])
        let lc, lco = int_ok(argv[6])
        if loo == 0 or lco == 0 {
            return r_notint()
        }
        lim_off = lo
        lim_cnt = lc
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    let none: []string = []
    if t == T_NONE {
        return r_array_bulks(none)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    if lim_off < 0 {
        return r_array_bulks(none)
    }
    let mems, _ = z_sorted(self.zsets[ik])
    let n = len(mems)
    let mut out = make([]string, 0, 8)
    let mut skipped = 0
    if rev == 1 {
        let mut i = n - 1
        while i >= 0 {
            let m = mems[i]
            if z_lex_ge_min(m, min_b) == 1 and z_lex_le_max(m, max_b) == 1 {
                if skipped < lim_off {
                    skipped = skipped + 1
                } else {
                    if lim_cnt >= 0 and len(out) >= lim_cnt {
                        break
                    }
                    out = append(out, m)
                }
            }
            i = i - 1
        }
    } else {
        let mut i = 0
        while i < n {
            let m = mems[i]
            if z_lex_ge_min(m, min_b) == 1 and z_lex_le_max(m, max_b) == 1 {
                if skipped < lim_off {
                    skipped = skipped + 1
                } else {
                    if lim_cnt >= 0 and len(out) >= lim_cnt {
                        break
                    }
                    out = append(out, m)
                }
            }
            i = i + 1
        }
    }
    return r_array_bulks(out)
}

fn Store_cmd_zlexcount(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("zlexcount")
    }
    let min_b = argv[2]
    let max_b = argv[3]
    if z_lex_bound_valid(min_b) == 0 or z_lex_bound_valid(max_b) == 0 {
        return r_err("ERR min or max not valid string range item")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let mems, _ = z_sorted(self.zsets[ik])
    let mut cnt = 0
    let mut i = 0
    while i < len(mems) {
        let m = mems[i]
        if z_lex_ge_min(m, min_b) == 1 and z_lex_le_max(m, max_b) == 1 {
            cnt = cnt + 1
        }
        i = i + 1
    }
    return r_int(cnt)
}

fn Store_cmd_zremrangebylex(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("zremrangebylex")
    }
    let min_b = argv[2]
    let max_b = argv[3]
    if z_lex_bound_valid(min_b) == 0 or z_lex_bound_valid(max_b) == 0 {
        return r_err("ERR min or max not valid string range item")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let mut z = self.zsets[ik]
    let mems, _ = z_sorted(z)
    let mut rem = 0
    let mut i = 0
    while i < len(mems) {
        let m = mems[i]
        if z_lex_ge_min(m, min_b) == 1 and z_lex_le_max(m, max_b) == 1 {
            delete(z, m)
            rem = rem + 1
        }
        i = i + 1
    }
    if len(z) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.zsets[ik] = z
    }
    return r_int(rem)
}

fn Store_cmd_zrangestore(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 5 {
        return r_arity("zrangestore")
    }
    let dst_ik = ikey(db, argv[1])
    let src_ik = ikey(db, argv[2])
    let st = self.kind(src_ik)
    if st != T_NONE and st != T_ZSET {
        return r_wrongtype()
    }
    let mut sub = make([]string, 0, len(argv))
    sub = append(sub, "ZRANGE")
    let mut i = 2
    while i < len(argv) {
        let u = str_to_upper(argv[i])
        if str_eq(u, "WITHSCORES") {
            return r_syntax()
        }
        sub = append(sub, argv[i])
        i = i + 1
    }
    let resp = self.cmd_zrange(db, sub, 0)
    if str_len(resp) > 0 and str_byte_at(resp, 0) == 45 {
        return resp
    }
    if st == T_NONE {
        let _ = self.drop_key(dst_ik)
        return r_int(0)
    }
    let src_z = self.zsets[src_ik]
    let mems, _, ok = parse_cmd(resp)
    if ok == 0 or len(mems) == 0 {
        let _ = self.drop_key(dst_ik)
        return r_int(0)
    }
    let mut nz = make(map[string]string)
    let mut j = 0
    while j < len(mems) {
        let m = mems[j]
        if has(src_z, m) {
            nz[m] = src_z[m]
        }
        j = j + 1
    }
    let _ = self.drop_key(dst_ik)
    self.types[dst_ik] = T_ZSET
    self.zsets[dst_ik] = nz
    return r_int(len(nz))
}

fn lcs_compute(a: string, b: string, argv: []string, opt_start: int) -> string {
    let mut only_len = 0
    let mut with_idx = 0
    let mut min_match = 0
    let mut with_match_len = 0
    let mut i = opt_start
    while i < len(argv) {
        let u = str_to_upper(argv[i])
        if str_eq(u, "LEN") {
            only_len = 1
            i = i + 1
        } else if str_eq(u, "IDX") {
            with_idx = 1
            i = i + 1
        } else if str_eq(u, "WITHMATCHLEN") {
            with_match_len = 1
            i = i + 1
        } else if str_eq(u, "MINMATCHLEN") and i + 1 < len(argv) {
            let mm, mmo = int_ok(argv[i + 1])
            if mmo == 0 {
                return r_notint()
            }
            if mm > 0 {
                min_match = mm
            }
            i = i + 2
        } else {
            return r_syntax()
        }
    }
    if only_len == 1 and with_idx == 1 {
        return r_err("ERR If you want both the length and indexes, please just use IDX.")
    }
    let m = str_len(a)
    let n = str_len(b)
    let cols = n + 1
    let mut dp = make([]int, (m + 1) * cols)
    let mut r = 1
    while r <= m {
        let ca = str_byte_at(a, r - 1)
        let mut c = 1
        while c <= n {
            if ca == str_byte_at(b, c - 1) {
                dp[r * cols + c] = dp[(r - 1) * cols + (c - 1)] + 1
            } else {
                let up = dp[(r - 1) * cols + c]
                let lf = dp[r * cols + (c - 1)]
                if up >= lf {
                    dp[r * cols + c] = up
                } else {
                    dp[r * cols + c] = lf
                }
            }
            c = c + 1
        }
        r = r + 1
    }
    let total_len = dp[m * cols + n]
    if only_len == 1 {
        return r_int(total_len)
    }
    if with_idx == 0 {
        let mut chars = make([]string, 0, total_len)
        let mut ri = m
        let mut ci = n
        while ri > 0 and ci > 0 {
            if str_byte_at(a, ri - 1) == str_byte_at(b, ci - 1) {
                chars = append(chars, a[ri - 1:ri])
                ri = ri - 1
                ci = ci - 1
            } else if dp[(ri - 1) * cols + ci] >= dp[ri * cols + (ci - 1)] {
                ri = ri - 1
            } else {
                ci = ci - 1
            }
        }
        let sb = str_builder()
        let mut k = len(chars) - 1
        while k >= 0 {
            builder_write(sb, chars[k])
            k = k - 1
        }
        return r_bulk(builder_string(sb))
    }
    // IDX mode: backtrack contiguous matching ranges
    let mut a_starts = make([]int, 0, 8)
    let mut a_ends = make([]int, 0, 8)
    let mut b_starts = make([]int, 0, 8)
    let mut b_ends = make([]int, 0, 8)
    let mut m_lens = make([]int, 0, 8)
    let mut ri = m
    let mut ci = n
    while ri > 0 and ci > 0 {
        if str_byte_at(a, ri - 1) == str_byte_at(b, ci - 1) {
            let ae = ri - 1
            let be = ci - 1
            let mut mlen = 0
            while ri > 0 and ci > 0 and str_byte_at(a, ri - 1) == str_byte_at(b, ci - 1) {
                ri = ri - 1
                ci = ci - 1
                mlen = mlen + 1
            }
            if mlen >= min_match {
                a_starts = append(a_starts, ri)
                a_ends = append(a_ends, ae)
                b_starts = append(b_starts, ci)
                b_ends = append(b_ends, be)
                m_lens = append(m_lens, mlen)
            }
        } else if dp[(ri - 1) * cols + ci] >= dp[ri * cols + (ci - 1)] {
            ri = ri - 1
        } else {
            ci = ci - 1
        }
    }
    let sb = str_builder()
    builder_write(sb, "*4\r\n")
    builder_write(sb, r_bulk("matches"))
    builder_write(sb, "*")
    builder_write(sb, fmt_int_fast(len(m_lens)))
    builder_write(sb, "\r\n")
    let mut idx = 0
    while idx < len(m_lens) {
        if with_match_len == 1 {
            builder_write(sb, "*3\r\n")
        } else {
            builder_write(sb, "*2\r\n")
        }
        builder_write(sb, "*2\r\n")
        builder_write(sb, r_int(a_starts[idx]))
        builder_write(sb, r_int(a_ends[idx]))
        builder_write(sb, "*2\r\n")
        builder_write(sb, r_int(b_starts[idx]))
        builder_write(sb, r_int(b_ends[idx]))
        if with_match_len == 1 {
            builder_write(sb, r_int(m_lens[idx]))
        }
        idx = idx + 1
    }
    builder_write(sb, r_bulk("len"))
    builder_write(sb, r_int(total_len))
    return builder_string(sb)
}

fn Store_cmd_lcs(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("lcs")
    }
    let ik1 = ikey(db, argv[1])
    let ik2 = ikey(db, argv[2])
    let t1 = self.kind(ik1)
    let t2 = self.kind(ik2)
    if (t1 != T_NONE and t1 != T_STR) or (t2 != T_NONE and t2 != T_STR) {
        return r_wrongtype()
    }
    let mut s1 = ""
    let mut s2 = ""
    if t1 == T_STR {
        s1 = self.strs[ik1]
    }
    if t2 == T_STR {
        s2 = self.strs[ik2]
    }
    return lcs_compute(s1, s2, argv, 3)
}

// CAS key expected new_val [EX s | PX ms | EXAT ts | PXAT ms-ts | KEEPTTL]
// Killer atomic Compare-And-Swap: returns :1 if swapped, :0 if mismatch, :-1 if key missing.
fn Store_cmd_cas(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 {
        return r_arity("cas")
    }
    let mut keepttl = 0
    let mut set_exp = 0
    let mut exp_at = 0
    let mut i = 4
    while i < len(argv) {
        let u = str_to_upper(argv[i])
        if str_eq(u, "KEEPTTL") {
            keepttl = 1
            i = i + 1
        } else if (str_eq(u, "EX") or str_eq(u, "PX") or str_eq(u, "EXAT") or str_eq(u, "PXAT")) and i + 1 < len(argv) {
            let v, ok = int_ok(argv[i + 1])
            if ok == 0 or v <= 0 {
                return r_err("ERR invalid expire time in 'cas' command")
            }
            set_exp = 1
            if str_eq(u, "EX") {
                exp_at = wall_ms() + v * 1000
            } else if str_eq(u, "PX") {
                exp_at = wall_ms() + v
            } else if str_eq(u, "EXAT") {
                exp_at = v * 1000
            } else {
                exp_at = v
            }
            i = i + 2
        } else {
            return r_syntax()
        }
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(-1)
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let cur = self.strs[ik]
    if not str_eq(cur, argv[2]) {
        return r_int(0)
    }
    self.strs[ik] = argv[3]
    self.charge(str_len(argv[3]) - str_len(cur))
    if set_exp == 1 {
        self.set_expire_at(ik, exp_at)
    } else if keepttl == 0 {
        delete(self.expire, ik)
    }
    return r_int(1)
}

// CAD key expected
// Killer atomic Compare-And-Delete: returns :1 if deleted, :0 if mismatch, :-1 if key missing.
fn Store_cmd_cad(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("cad")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(-1)
    }
    if t != T_STR {
        return r_wrongtype()
    }
    if not str_eq(self.strs[ik], argv[2]) {
        return r_int(0)
    }
    let _ = self.drop_key(ik)
    return r_int(1)
}

// DELEX key [IFEQ val | IFNE val]
// Conditional delete (compatible with Redis 8 / Valkey DELEX and plain DEL).
fn Store_cmd_delex(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 and len(argv) != 4 {
        return r_arity("delex")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if len(argv) == 2 {
        if t == T_NONE {
            return r_int(0)
        }
        let _ = self.drop_key(ik)
        return r_int(1)
    }
    let cond = str_to_upper(argv[2])
    if not str_eq(cond, "IFEQ") and not str_eq(cond, "IFNE") {
        return r_syntax()
    }
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let cur = self.strs[ik]
    if str_eq(cond, "IFEQ") {
        if not str_eq(cur, argv[3]) {
            return r_int(0)
        }
    } else {
        if str_eq(cur, argv[3]) {
            return r_int(0)
        }
    }
    let _ = self.drop_key(ik)
    return r_int(1)
}

// RATELIMIT key max_requests window_ms [cost]
// Native atomic fixed/tumbling window rate limiter with auto-TTL cleanup.
// Returns 4-element integer array: [allowed (1|0), remaining, reset_ms, total_in_window]
fn Store_cmd_ratelimit(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 or len(argv) > 5 {
        return r_arity("ratelimit")
    }
    let max_req, m_ok = int_ok(argv[2])
    let win_ms, w_ok = int_ok(argv[3])
    if m_ok == 0 or w_ok == 0 or max_req <= 0 or win_ms <= 0 {
        return r_err("ERR max_requests and window_ms must be positive integers")
    }
    let mut cost = 1
    if len(argv) == 5 {
        let c, c_ok = int_ok(argv[4])
        if c_ok == 0 or c < 0 {
            return r_err("ERR cost must be a non-negative integer")
        }
        cost = c
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_STR {
        return r_wrongtype()
    }
    let now = wall_ms()
    let mut count = 0
    let mut exp_at = now + win_ms
    if t == T_STR {
        let cur_c, cok = int_ok(self.strs[ik])
        if cok == 1 {
            count = cur_c
        }
        if has(self.expire, ik) and self.expire[ik] > now {
            exp_at = self.expire[ik]
        }
    }
    let mut allowed = 0
    if count + cost <= max_req {
        allowed = 1
        count = count + cost
        self.strs[ik] = fmt_int_fast(count)
        self.types[ik] = T_STR
        self.set_expire_at(ik, exp_at)
    } else if t == T_NONE {
        self.strs[ik] = "0"
        self.types[ik] = T_STR
        self.set_expire_at(ik, exp_at)
    }
    let mut rem = max_req - count
    if rem < 0 {
        rem = 0
    }
    let mut reset_ms = exp_at - now
    if reset_ms < 0 {
        reset_ms = 0
    }
    return "*4\r\n" + r_int(allowed) + r_int(rem) + r_int(reset_ms) + r_int(count)
}

// CL.THROTTLE key max_burst count_per_period period_seconds [quantity]
// 100% drop-in native replacement for the Redis redis-cell module (GCRA leaky bucket).
// Returns 5-element integer array:
//   [0] 0 if allowed, 1 if throttled
//   [1] total capacity (max_burst + 1)
//   [2] remaining capacity
//   [3] retry_after seconds (-1 if allowed)
//   [4] full_reset seconds until bucket is completely empty
fn Store_cmd_clthrottle(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 5 or len(argv) > 6 {
        return r_arity("cl.throttle")
    }
    let max_burst, b_ok = int_ok(argv[2])
    let cnt_period, c_ok = int_ok(argv[3])
    let period_sec, p_ok = int_ok(argv[4])
    if b_ok == 0 or c_ok == 0 or p_ok == 0 or max_burst < 0 or cnt_period <= 0 or period_sec <= 0 {
        return r_err("ERR invalid rate limit arguments")
    }
    let mut qty = 1
    if len(argv) == 6 {
        let q, q_ok = int_ok(argv[5])
        if q_ok == 0 or q < 0 {
            return r_err("ERR invalid quantity")
        }
        qty = q
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_STR {
        return r_wrongtype()
    }
    let capacity = max_burst + 1
    let period_ms = period_sec * 1000
    let mut emission_ms = period_ms / cnt_period
    if emission_ms < 1 {
        emission_ms = 1
    }
    let delay_tolerance_ms = emission_ms * capacity
    let incr_ms = emission_ms * qty
    let now = wall_ms()
    let mut tat = now
    if t == T_STR {
        let prev_tat, tok = int_ok(self.strs[ik])
        if tok == 1 and prev_tat > now {
            tat = prev_tat
        }
    }
    let new_tat = tat + incr_ms
    let allow_at = new_tat - delay_tolerance_ms
    let mut throttled = 0
    let mut retry_after = -1
    let mut final_tat = tat
    if allow_at > now {
        throttled = 1
        retry_after = (allow_at - now + 999) / 1000
        if retry_after < 1 {
            retry_after = 1
        }
    } else {
        final_tat = new_tat
        self.strs[ik] = format_int(final_tat)
        self.types[ik] = T_STR
        self.set_expire_at(ik, final_tat + period_ms)
    }
    let diff_ms = delay_tolerance_ms - (final_tat - now)
    let mut remaining = 0
    if diff_ms > 0 {
        remaining = diff_ms / emission_ms
        if remaining > capacity {
            remaining = capacity
        }
    }
    let reset_sec = (final_tat - now + 999) / 1000
    let mut full_reset = reset_sec
    if full_reset < 0 {
        full_reset = 0
    }
    return "*5\r\n" + r_int(throttled) + r_int(capacity) + r_int(remaining) + r_int(retry_after) + r_int(full_reset)
}

fn Store_cmd_zintercard(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("zintercard")
    }
    let nk, ok = int_ok(argv[1])
    if ok == 0 or nk < 1 or 2 + nk > len(argv) {
        return r_syntax()
    }
    let mut lim = 0
    if 2 + nk < len(argv) {
        if 2 + nk + 2 != len(argv) or not str_eq(str_to_upper(argv[2 + nk]), "LIMIT") {
            return r_syntax()
        }
        let lv, lok = int_ok(argv[2 + nk + 1])
        if lok == 0 or lv < 0 {
            return r_err("ERR LIMIT can't be negative")
        }
        lim = lv
    }
    let mut i = 0
    while i < nk {
        let ik = ikey(db, argv[2 + i])
        let t = self.kind(ik)
        if t != T_NONE and t != T_ZSET {
            return r_wrongtype()
        }
        i = i + 1
    }
    let ik0 = ikey(db, argv[2])
    if self.kind(ik0) != T_ZSET {
        return r_int(0)
    }
    let first, _ = z_sorted(self.zsets[ik0])
    let mut n = 0
    let mut fi = 0
    while fi < len(first) {
        let mut in_all = 1
        let mut j = 1
        while j < nk {
            let ik = ikey(db, argv[2 + j])
            if self.kind(ik) != T_ZSET {
                in_all = 0
            } else if not has(self.zsets[ik], first[fi]) {
                in_all = 0
            }
            j = j + 1
        }
        if in_all == 1 {
            n = n + 1
            if lim > 0 and n >= lim {
                return r_int(n)
            }
        }
        fi = fi + 1
    }
    return r_int(n)
}

// ============================================================================
// Sub-Key Expiration for Sets (SEXPIRE/STTL/SPERSIST) & ZSets (ZEXPIRE/ZTTL/ZPERSIST)
// ============================================================================

fn sk_exp(ik: string, mem: string) -> string {
    return "\u001eSE\u001e" + ik + "\u001e" + mem
}

fn sk_has(ik: string) -> string {
    return "\u001eSH\u001e" + ik
}

fn zk_exp(ik: string, mem: string) -> string {
    return "\u001eZE\u001e" + ik + "\u001e" + mem
}

fn zk_has(ik: string) -> string {
    return "\u001eZH\u001e" + ik
}

fn Store_cmd_sexpire(mut self: Store, db: int, argv: []string, mult: int, is_at: int) -> string {
    if len(argv) < 4 {
        return r_arity(str_to_lower(argv[0]))
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_SET {
        return r_wrongtype()
    }
    let raw_t, tok = int_ok(argv[2])
    if tok == 0 {
        return r_notint()
    }
    let mut exp_at = raw_t * mult
    if is_at == 0 {
        exp_at = wall_ms() + raw_t * mult
    }
    let mut nx = 0
    let mut xx = 0
    let mut gt = 0
    let mut lt = 0
    let mut idx = 3
    let u3 = str_to_upper(argv[idx])
    if str_eq(u3, "NX") or str_eq(u3, "XX") or str_eq(u3, "GT") or str_eq(u3, "LT") {
        if str_eq(u3, "NX") {
            nx = 1
        } else if str_eq(u3, "XX") {
            xx = 1
        } else if str_eq(u3, "GT") {
            gt = 1
        } else {
            lt = 1
        }
        idx = idx + 1
    }
    if idx < len(argv) and (str_eq(str_to_upper(argv[idx]), "MEMBERS") or str_eq(str_to_upper(argv[idx]), "FIELDS")) {
        if idx + 2 >= len(argv) {
            return r_syntax()
        }
        let nm, nok = int_ok(argv[idx + 1])
        if nok == 0 or nm <= 0 or idx + 2 + nm != len(argv) {
            return r_syntax()
        }
        idx = idx + 2
    }
    let cnt = len(argv) - idx
    if cnt <= 0 {
        return r_syntax()
    }
    let now = wall_ms()
    let b = str_builder()
    builder_write(b, "*")
    builder_write(b, fmt_int_fast(cnt))
    builder_write(b, "\r\n")
    if t == T_NONE {
        let mut k = 0
        while k < cnt {
            builder_write(b, r_int(-2))
            k = k + 1
        }
        return builder_string(b)
    }
    let mut s = self.sets[ik]
    let mut k = 0
    while k < cnt {
        let m = argv[idx + k]
        if not has(s, m) {
            builder_write(b, r_int(-2))
        } else {
            let ek = sk_exp(ik, m)
            let has_e = has(self.xseq, ek)
            let mut cur_e = 0
            if has_e {
                cur_e = self.xseq[ek]
            }
            let mut allow = 1
            if nx == 1 and has_e {
                allow = 0
            }
            if xx == 1 and not has_e {
                allow = 0
            }
            if gt == 1 and (not has_e or exp_at <= cur_e) {
                allow = 0
            }
            if lt == 1 and has_e and exp_at >= cur_e {
                allow = 0
            }
            if allow == 0 {
                builder_write(b, r_int(0))
            } else if exp_at <= now {
                delete(s, m)
                delete(self.xseq, ek)
                builder_write(b, r_int(2))
            } else {
                self.xseq[ek] = exp_at
                self.xseq[sk_has(ik)] = 1
                builder_write(b, r_int(1))
            }
        }
        k = k + 1
    }
    if len(s) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.sets[ik] = s
    }
    return builder_string(b)
}

fn Store_cmd_sttl(mut self: Store, db: int, argv: []string, div: int) -> string {
    if len(argv) < 3 {
        return r_arity(str_to_lower(argv[0]))
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_SET {
        return r_wrongtype()
    }
    let mut idx = 2
    if idx < len(argv) and (str_eq(str_to_upper(argv[idx]), "MEMBERS") or str_eq(str_to_upper(argv[idx]), "FIELDS")) {
        if idx + 2 >= len(argv) {
            return r_syntax()
        }
        let nm, nok = int_ok(argv[idx + 1])
        if nok == 0 or nm <= 0 or idx + 2 + nm != len(argv) {
            return r_syntax()
        }
        idx = idx + 2
    }
    let cnt = len(argv) - idx
    let now = wall_ms()
    let b = str_builder()
    builder_write(b, "*")
    builder_write(b, fmt_int_fast(cnt))
    builder_write(b, "\r\n")
    let mut k = 0
    while k < cnt {
        let m = argv[idx + k]
        if t == T_NONE or not has(self.sets[ik], m) {
            builder_write(b, r_int(-2))
        } else {
            let ek = sk_exp(ik, m)
            if not has(self.xseq, ek) {
                builder_write(b, r_int(-1))
            } else {
                let mut left = (self.xseq[ek] - now) / div
                if left < 0 {
                    left = 0
                }
                builder_write(b, r_int(left))
            }
        }
        k = k + 1
    }
    return builder_string(b)
}

fn Store_cmd_spersist(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("spersist")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_SET {
        return r_wrongtype()
    }
    let mut idx = 2
    if idx < len(argv) and (str_eq(str_to_upper(argv[idx]), "MEMBERS") or str_eq(str_to_upper(argv[idx]), "FIELDS")) {
        if idx + 2 >= len(argv) {
            return r_syntax()
        }
        idx = idx + 2
    }
    let cnt = len(argv) - idx
    let b = str_builder()
    builder_write(b, "*")
    builder_write(b, fmt_int_fast(cnt))
    builder_write(b, "\r\n")
    let mut k = 0
    while k < cnt {
        let m = argv[idx + k]
        if t == T_NONE or not has(self.sets[ik], m) {
            builder_write(b, r_int(-2))
        } else {
            let ek = sk_exp(ik, m)
            if not has(self.xseq, ek) {
                builder_write(b, r_int(-1))
            } else {
                delete(self.xseq, ek)
                builder_write(b, r_int(1))
            }
        }
        k = k + 1
    }
    return builder_string(b)
}

fn Store_cmd_zexpire(mut self: Store, db: int, argv: []string, mult: int, is_at: int) -> string {
    if len(argv) < 4 {
        return r_arity(str_to_lower(argv[0]))
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_ZSET {
        return r_wrongtype()
    }
    let raw_t, tok = int_ok(argv[2])
    if tok == 0 {
        return r_notint()
    }
    let mut exp_at = raw_t * mult
    if is_at == 0 {
        exp_at = wall_ms() + raw_t * mult
    }
    let mut nx = 0
    let mut xx = 0
    let mut gt = 0
    let mut lt = 0
    let mut idx = 3
    let u3 = str_to_upper(argv[idx])
    if str_eq(u3, "NX") or str_eq(u3, "XX") or str_eq(u3, "GT") or str_eq(u3, "LT") {
        if str_eq(u3, "NX") {
            nx = 1
        } else if str_eq(u3, "XX") {
            xx = 1
        } else if str_eq(u3, "GT") {
            gt = 1
        } else {
            lt = 1
        }
        idx = idx + 1
    }
    if idx < len(argv) and (str_eq(str_to_upper(argv[idx]), "MEMBERS") or str_eq(str_to_upper(argv[idx]), "FIELDS")) {
        if idx + 2 >= len(argv) {
            return r_syntax()
        }
        let nm, nok = int_ok(argv[idx + 1])
        if nok == 0 or nm <= 0 or idx + 2 + nm != len(argv) {
            return r_syntax()
        }
        idx = idx + 2
    }
    let cnt = len(argv) - idx
    if cnt <= 0 {
        return r_syntax()
    }
    let now = wall_ms()
    let b = str_builder()
    builder_write(b, "*")
    builder_write(b, fmt_int_fast(cnt))
    builder_write(b, "\r\n")
    if t == T_NONE {
        let mut k = 0
        while k < cnt {
            builder_write(b, r_int(-2))
            k = k + 1
        }
        return builder_string(b)
    }
    let mut z = self.zsets[ik]
    let mut k = 0
    while k < cnt {
        let m = argv[idx + k]
        if not has(z, m) {
            builder_write(b, r_int(-2))
        } else {
            let ek = zk_exp(ik, m)
            let has_e = has(self.xseq, ek)
            let mut cur_e = 0
            if has_e {
                cur_e = self.xseq[ek]
            }
            let mut allow = 1
            if nx == 1 and has_e {
                allow = 0
            }
            if xx == 1 and not has_e {
                allow = 0
            }
            if gt == 1 and (not has_e or exp_at <= cur_e) {
                allow = 0
            }
            if lt == 1 and has_e and exp_at >= cur_e {
                allow = 0
            }
            if allow == 0 {
                builder_write(b, r_int(0))
            } else if exp_at <= now {
                delete(z, m)
                delete(self.xseq, ek)
                builder_write(b, r_int(2))
            } else {
                self.xseq[ek] = exp_at
                self.xseq[zk_has(ik)] = 1
                builder_write(b, r_int(1))
            }
        }
        k = k + 1
    }
    if len(z) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.zsets[ik] = z
    }
    return builder_string(b)
}

