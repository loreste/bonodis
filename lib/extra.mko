        k = k + 1
    }
    return builder_string(b)
}

fn Store_cmd_zpersist(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("zpersist")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_ZSET {
        return r_wrongtype()
    }
    let mut idx = 2
    if idx < len(argv) and (str_eq(str_to_upper(argv[idx]), "MEMBERS") or str_eq(str_to_upper(argv[idx]), "FIELDS")) {
        if idx + 2 >= len(argv) {
            return r_syntax()
        }
        idx = idx + 2
    }
    let cnt = len(argv) - idx
    let b = str_builder()
    builder_write(b, "*")
    builder_write(b, fmt_int_fast(cnt))
    builder_write(b, "\r\n")
    let mut k = 0
    while k < cnt {
        let m = argv[idx + k]
        if t == T_NONE or not has(self.zsets[ik], m) {
            builder_write(b, r_int(-2))
        } else {
            let ek = zk_exp(ik, m)
            if not has(self.xseq, ek) {
                builder_write(b, r_int(-1))
            } else {
                delete(self.xseq, ek)
                builder_write(b, r_int(1))
            }
        }
        k = k + 1
    }
    return builder_string(b)
}

// ============================================================================
// Native JSON Commands (JSON.SET, JSON.GET, JSON.DEL, JSON.TYPE, JSON.NUMINCRBY,
// JSON.STRAPPEND, JSON.STRLEN, JSON.ARRAPPEND, JSON.ARRLEN, JSON.OBJKEYS, JSON.OBJLEN)
// ============================================================================

fn json_trim(s: string) -> string {
    let n = str_len(s)
    let mut a = 0
    while a < n {
        let c = str_byte_at(s, a)
        if c != 32 and c != 9 and c != 10 and c != 13 {
            break
        }
        a = a + 1
    }
    let mut b = n
    while b > a {
        let c = str_byte_at(s, b - 1)
        if c != 32 and c != 9 and c != 10 and c != 13 {
            break
        }
        b = b - 1
    }
    return s[a:b]
}

fn json_norm_path(p: string) -> []string {
    let none: []string = []
    if str_len(p) == 0 or str_eq(p, "$") or str_eq(p, ".") {
        return none
    }
    let mut s = p
    if str_has_prefix(s, "$.") {
        s = s[2:]
    } else if str_has_prefix(s, "$") or str_has_prefix(s, ".") {
        s = s[1:]
    }
    if str_len(s) == 0 {
        return none
    }
    return str_split(s, ".")
}

// Find value span [start, end) of top-level field `field` inside a JSON object `doc`.
// Also returns the key span start (`k_start`) for deletion.
fn json_find_field(doc: string, field: string) -> (int, int, int) {
    let t = json_trim(doc)
    let n = str_len(t)
    if n < 2 or str_byte_at(t, 0) != 123 {
        return (-1, -1, -1)
    }
    let off = str_index(doc, "{")
    let mut i = off + 1
    let dn = str_len(doc)
    while i < dn {
        while i < dn {
            let c = str_byte_at(doc, i)
            if c == 32 or c == 9 or c == 10 or c == 13 or c == 44 {
                i = i + 1
            } else {
                break
            }
        }
        if i >= dn or str_byte_at(doc, i) == 125 {
            break
        }
        if str_byte_at(doc, i) != 34 {
            break
        }
        let k_start = i
        i = i + 1
        let mut k_end = i
        while k_end < dn {
            let c = str_byte_at(doc, k_end)
            if c == 34 {
                break
            }
            if c == 92 {
                k_end = k_end + 1
            }
            k_end = k_end + 1
        }
        let key_name = doc[i:k_end]
        i = k_end + 1
        while i < dn and str_byte_at(doc, i) != 58 {
            i = i + 1
        }
        if i >= dn {
            break
        }
        i = i + 1
        while i < dn {
            let c = str_byte_at(doc, i)
            if c == 32 or c == 9 or c == 10 or c == 13 {
                i = i + 1
            } else {
                break
            }
        }
        let v_start = i
        let mut depth = 0
        let mut in_str = 0
        while i < dn {
            let c = str_byte_at(doc, i)
            if in_str == 1 {
                if c == 92 {
                    i = i + 1
                } else if c == 34 {
                    in_str = 0
                }
            } else {
                if c == 34 {
                    in_str = 1
                } else if c == 123 or c == 91 {
                    depth = depth + 1
                } else if c == 125 or c == 93 {
                    if depth == 0 {
                        break
                    }
                    depth = depth - 1
                } else if c == 44 and depth == 0 {
                    break
                }
            }
            i = i + 1
        }
        let mut v_end = i
        while v_end > v_start {
            let c = str_byte_at(doc, v_end - 1)
            if c == 32 or c == 9 or c == 10 or c == 13 {
                v_end = v_end - 1
            } else {
                break
            }
        }
        if str_eq(key_name, field) {
            return (v_start, v_end, k_start)
        }
    }
    return (-1, -1, -1)
}

fn json_get_path(doc: string, parts: []string, idx: int) -> (string, int) {
    if idx >= len(parts) {
        return (json_trim(doc), 1)
    }
    let vs, ve, _ = json_find_field(doc, parts[idx])
    if vs < 0 {
        return ("", 0)
    }
    return json_get_path(doc[vs:ve], parts, idx + 1)
}

fn json_set_path(doc: string, parts: []string, idx: int, new_val: string) -> (string, int) {
    if idx >= len(parts) {
        return (new_val, 1)
    }
    let field = parts[idx]
    let vs, ve, _ = json_find_field(doc, field)
    if vs >= 0 {
        let sub_new, ok = json_set_path(doc[vs:ve], parts, idx + 1, new_val)
        if ok == 0 {
            return (doc, 0)
        }
        return (doc[:vs] + sub_new + doc[ve:], 1)
    }
    let t = json_trim(doc)
    if str_len(t) < 2 or str_byte_at(t, 0) != 123 or str_byte_at(t, str_len(t) - 1) != 125 {
        return (doc, 0)
    }
    let sub_new, ok = json_set_path("{}", parts, idx + 1, new_val)
    if ok == 0 {
        return (doc, 0)
    }
    let inner = json_trim(t[1:str_len(t) - 1])
    let entry = "\"" + field + "\":" + sub_new
    if str_len(inner) == 0 {
        return ("{" + entry + "}", 1)
    }
    return ("{" + inner + "," + entry + "}", 1)
}

fn json_del_field(doc: string, field: string) -> (string, int) {
    let vs, ve, ks = json_find_field(doc, field)
    if vs < 0 or ks < 0 {
        return (doc, 0)
    }
    let dn = str_len(doc)
    let mut r_start = ks
    let mut r_end = ve
    let mut p = ks - 1
    while p >= 0 {
        let c = str_byte_at(doc, p)
        if c == 32 or c == 9 or c == 10 or c == 13 {
            p = p - 1
        } else {
            break
        }
    }
    if p >= 0 and str_byte_at(doc, p) == 44 {
        r_start = p
    } else {
        let mut q = ve
        while q < dn {
            let c = str_byte_at(doc, q)
            if c == 32 or c == 9 or c == 10 or c == 13 {
                q = q + 1
            } else {
                break
            }
        }
        if q < dn and str_byte_at(doc, q) == 44 {
            r_end = q + 1
        }
    }
    return (doc[:r_start] + doc[r_end:], 1)
}

fn json_del_path(doc: string, parts: []string, idx: int) -> (string, int) {
    if idx + 1 == len(parts) {
        return json_del_field(doc, parts[idx])
    }
    let vs, ve, _ = json_find_field(doc, parts[idx])
    if vs < 0 {
        return (doc, 0)
    }
    let sub_new, removed = json_del_path(doc[vs:ve], parts, idx + 1)
    if removed == 0 {
        return (doc, 0)
    }
    return (doc[:vs] + sub_new + doc[ve:], 1)
}

fn json_val_type(val: string) -> string {
    let t = json_trim(val)
    if str_len(t) == 0 {
        return "null"
    }
    let c = str_byte_at(t, 0)
    if c == 123 {
        return "object"
    }
    if c == 91 {
        return "array"
    }
    if c == 34 {
        return "string"
    }
    if str_eq(t, "true") or str_eq(t, "false") {
        return "boolean"
    }
    if str_eq(t, "null") {
        return "null"
    }
    if str_contains(t, ".") {
        return "number"
    }
    return "integer"
}

fn Store_cmd_jsonset(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 or len(argv) > 5 {
        return r_arity("json.set")
    }
    let mut nx = 0
    let mut xx = 0
    if len(argv) == 5 {
        let cond = str_to_upper(argv[4])
        if str_eq(cond, "NX") {
            nx = 1
        } else if str_eq(cond, "XX") {
            xx = 1
        } else {
            return r_syntax()
        }
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_STR {
        return r_wrongtype()
    }
    let parts = json_norm_path(argv[2])
    let new_val = json_trim(argv[3])
    if len(parts) == 0 {
        if nx == 1 and t != T_NONE {
            return r_nil()
        }
        if xx == 1 and t == T_NONE {
            return r_nil()
        }
        self.strs[ik] = new_val
        self.types[ik] = T_STR
        return r_ok()
    }
    if t == T_NONE {
        if xx == 1 {
            return r_nil()
        }
        let doc, ok = json_set_path("{}", parts, 0, new_val)
        if ok == 0 {
            return r_err("ERR could not set JSON path")
        }
        self.strs[ik] = doc
        self.types[ik] = T_STR
        return r_ok()
    }
    let cur_doc = self.strs[ik]
    let _, exists = json_get_path(cur_doc, parts, 0)
    if nx == 1 and exists == 1 {
        return r_nil()
    }
    if xx == 1 and exists == 0 {
        return r_nil()
    }
    let doc, ok = json_set_path(cur_doc, parts, 0, new_val)
    if ok == 0 {
        return r_err("ERR could not set JSON path")
    }
    self.strs[ik] = doc
    return r_ok()
}

fn Store_cmd_jsonget(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("json.get")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nil()
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let doc = self.strs[ik]
    let mut path = "$"
    if len(argv) >= 3 {
        path = argv[2]
    }
    let parts = json_norm_path(path)
    let val, ok = json_get_path(doc, parts, 0)
    if ok == 0 {
        if str_has_prefix(path, "$") and len(parts) > 0 {
            return r_bulk("[]")
        }
        return r_nil()
    }
    if str_has_prefix(path, "$.") {
        return r_bulk("[" + val + "]")
    }
    return r_bulk(val)
}

fn Store_cmd_jsondel(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 or len(argv) > 3 {
        return r_arity("json.del")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let mut path = "$"
    if len(argv) == 3 {
        path = argv[2]
    }
    let parts = json_norm_path(path)
    if len(parts) == 0 {
        let _ = self.drop_key(ik)
        return r_int(1)
    }
    let nw, rem = json_del_path(self.strs[ik], parts, 0)
    if rem == 1 {
        self.strs[ik] = nw
    }
    return r_int(rem)
}

fn Store_cmd_jsontype(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 or len(argv) > 3 {
        return r_arity("json.type")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nil()
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let mut path = "$"
    if len(argv) == 3 {
        path = argv[2]
    }
    let parts = json_norm_path(path)
    let val, ok = json_get_path(self.strs[ik], parts, 0)
    if ok == 0 {
        return r_nil()
    }
    return r_bulk(json_val_type(val))
}

fn Store_cmd_jsonnumincrby(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("json.numincrby")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nil()
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let parts = json_norm_path(argv[2])
    let val, ok = json_get_path(self.strs[ik], parts, 0)
    if ok == 0 {
        return r_nil()
    }
    let mut next_s = ""
    let iv, iok = int_ok(val)
    let di, dok = int_ok(argv[3])
    if iok == 1 and dok == 1 {
        next_s = fmt_int_fast(iv + di)
    } else {
        let fv = parse_float(val) + parse_float(argv[3])
        next_s = format_float(fv, 4)
    }
    let nw, sok = json_set_path(self.strs[ik], parts, 0, next_s)
    if sok == 0 {
        return r_err("ERR could not increment JSON path")
    }
    self.strs[ik] = nw
    return r_bulk(next_s)
}

fn Store_cmd_jsonstrappend(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 and len(argv) != 4 {
        return r_arity("json.strappend")
    }
    let ik = ikey(db, argv[1])
    if self.kind(ik) != T_STR {
        return r_nil()
    }
    let mut path = "$"
    let mut add_raw = argv[2]
    if len(argv) == 4 {
        path = argv[2]
        add_raw = argv[3]
    }
    let parts = json_norm_path(path)
    let val, ok = json_get_path(self.strs[ik], parts, 0)
    if ok == 0 or str_len(val) < 2 or str_byte_at(val, 0) != 34 {
        return r_nil()
    }
    let mut suffix = add_raw
    if str_len(suffix) >= 2 and str_byte_at(suffix, 0) == 34 and str_byte_at(suffix, str_len(suffix) - 1) == 34 {
        suffix = suffix[1:str_len(suffix) - 1]
    }
    let inner = val[1:str_len(val) - 1] + suffix
    let nw, sok = json_set_path(self.strs[ik], parts, 0, "\"" + inner + "\"")
    if sok == 1 {
        self.strs[ik] = nw
    }
    return r_int(str_len(inner))
}

fn Store_cmd_jsonstrlen(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 or len(argv) > 3 {
        return r_arity("json.strlen")
    }
    let ik = ikey(db, argv[1])
    if self.kind(ik) != T_STR {
        return r_nil()
    }
    let mut path = "$"
    if len(argv) == 3 {
        path = argv[2]
    }
    let val, ok = json_get_path(self.strs[ik], json_norm_path(path), 0)
    if ok == 0 or str_len(val) < 2 or str_byte_at(val, 0) != 34 {
        return r_nil()
    }
    return r_int(str_len(val) - 2)
}

fn json_arr_count(arr_str: string) -> int {
    let t = json_trim(arr_str)
    let n = str_len(t)
    if n < 2 or str_byte_at(t, 0) != 91 or str_byte_at(t, n - 1) != 93 {
        return -1
    }
    let inner = json_trim(t[1:n - 1])
    if str_len(inner) == 0 {
        return 0
    }
    let mut cnt = 1
    let mut depth = 0
    let mut in_str = 0
    let mut i = 0
    while i < str_len(inner) {
        let c = str_byte_at(inner, i)
        if in_str == 1 {
            if c == 92 {
                i = i + 1
            } else if c == 34 {
                in_str = 0
            }
        } else {
            if c == 34 {
                in_str = 1
            } else if c == 123 or c == 91 {
                depth = depth + 1
            } else if c == 125 or c == 93 {
                depth = depth - 1
            } else if c == 44 and depth == 0 {
                cnt = cnt + 1
            }
        }
        i = i + 1
    }
    return cnt
}

fn Store_cmd_jsonarrappend(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 {
        return r_arity("json.arrappend")
    }
    let ik = ikey(db, argv[1])
    if self.kind(ik) != T_STR {
        return r_nil()
    }
    let parts = json_norm_path(argv[2])
    let val, ok = json_get_path(self.strs[ik], parts, 0)
    if ok == 0 {
        return r_nil()
    }
    let t = json_trim(val)
    if str_len(t) < 2 or str_byte_at(t, 0) != 91 or str_byte_at(t, str_len(t) - 1) != 93 {
        return r_wrongtype()
    }
    let mut inner = json_trim(t[1:str_len(t) - 1])
    let mut i = 3
    while i < len(argv) {
        if str_len(inner) > 0 {
            inner = inner + "," + json_trim(argv[i])
        } else {
            inner = json_trim(argv[i])
        }
        i = i + 1
    }
    let nw_arr = "[" + inner + "]"
    let nw_doc, sok = json_set_path(self.strs[ik], parts, 0, nw_arr)
    if sok == 1 {
        self.strs[ik] = nw_doc
    }
    return r_int(json_arr_count(nw_arr))
}

fn Store_cmd_jsonarrlen(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 or len(argv) > 3 {
        return r_arity("json.arrlen")
    }
    let ik = ikey(db, argv[1])
    if self.kind(ik) != T_STR {
        return r_nil()
    }
    let mut path = "$"
    if len(argv) == 3 {
        path = argv[2]
    }
    let val, ok = json_get_path(self.strs[ik], json_norm_path(path), 0)
    if ok == 0 {
        return r_nil()
    }
    let cnt = json_arr_count(val)
    if cnt < 0 {
        return r_nil()
    }
    return r_int(cnt)
}

fn json_obj_keys(obj_str: string) -> []string {
    let none: []string = []
    let t = json_trim(obj_str)
    let n = str_len(t)
    if n < 2 or str_byte_at(t, 0) != 123 {
        return none
    }
    let mut keys = make([]string, 0, 8)
    let mut i = 1
    while i < n {
        while i < n {
            let c = str_byte_at(t, i)
            if c == 32 or c == 9 or c == 10 or c == 13 or c == 44 {
                i = i + 1
            } else {
                break
            }
        }
        if i >= n or str_byte_at(t, i) == 125 or str_byte_at(t, i) != 34 {
            break
        }
        i = i + 1
        let mut ke = i
        while ke < n {
            let c = str_byte_at(t, ke)
            if c == 34 {
                break
            }
            if c == 92 {
                ke = ke + 1
            }
            ke = ke + 1
        }
        keys = append(keys, t[i:ke])
        i = ke + 1
        while i < n and str_byte_at(t, i) != 58 {
            i = i + 1
        }
        i = i + 1
        let mut depth = 0
        let mut in_str = 0
        while i < n {
            let c = str_byte_at(t, i)
            if in_str == 1 {
                if c == 92 {
                    i = i + 1
                } else if c == 34 {
                    in_str = 0
                }
            } else {
                if c == 34 {
                    in_str = 1
                } else if c == 123 or c == 91 {
                    depth = depth + 1
                } else if c == 125 or c == 93 {
                    if depth == 0 {
                        break
                    }
                    depth = depth - 1
                } else if c == 44 and depth == 0 {
                    break
                }
            }
            i = i + 1
        }
    }
    return keys
}

fn Store_cmd_jsonobjkeys(mut self: Store, db: int, argv: []string, only_len: int) -> string {
    if len(argv) < 2 or len(argv) > 3 {
        return r_arity(str_to_lower(argv[0]))
    }
    let ik = ikey(db, argv[1])
    if self.kind(ik) != T_STR {
        return r_nil()
    }
    let mut path = "$"
    if len(argv) == 3 {
        path = argv[2]
    }
    let val, ok = json_get_path(self.strs[ik], json_norm_path(path), 0)
    if ok == 0 {
        return r_nil()
    }
    let ks = json_obj_keys(val)
    if only_len == 1 {
        return r_int(len(ks))
    }
    return r_array_bulks(ks)
}

// ============================================================================
// Native Time-Series Commands (TS.CREATE, TS.ADD, TS.MADD, TS.INCRBY, TS.DECRBY,
// TS.GET, TS.RANGE, TS.REVRANGE, TS.INFO)
// ============================================================================

fn ts_is_valid(raw: string) -> int {
    if str_has_prefix(raw, "TS1\n") {
        return 1
    }
    return 0
}

fn ts_parse_samples(raw: string) -> ([]int, []float, []string) {
    let mut ts_arr = make([]int, 0, 8)
    let mut val_arr = make([]float, 0, 8)
    let mut str_arr = make([]string, 0, 8)
    if not str_has_prefix(raw, "TS1\n") {
        return (ts_arr, val_arr, str_arr)
    }
    let body = raw[4:]
    if str_len(body) == 0 {
        return (ts_arr, val_arr, str_arr)
    }
    let lines = str_split(body, "\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i]
        if str_len(ln) > 0 {
            let tab = str_index(ln, "\t")
            if tab > 0 {
                let t = int_of(ln[:tab])
                let vs = ln[tab + 1:]
                ts_arr = append(ts_arr, t)
                val_arr = append(val_arr, parse_float(vs))
                str_arr = append(str_arr, vs)
            }
        }
        i = i + 1
    }
    return (ts_arr, val_arr, str_arr)
}

fn ts_encode_samples(ts_arr: []int, str_arr: []string, min_ts: int) -> string {
    let b = str_builder()
    builder_write(b, "TS1\n")
    let mut i = 0
    while i < len(ts_arr) {
        if ts_arr[i] >= min_ts {
            builder_write(b, format_int(ts_arr[i]))
            builder_write(b, "\t")
            builder_write(b, str_arr[i])
            builder_write(b, "\n")
        }
        i = i + 1
    }
    return builder_string(b)
}

fn Store_ts_append(mut self: Store, ik: string, ts_in: int, val_s: string, ret_ms: int) -> int {
    let mut raw = "TS1\n"
    if self.kind(ik) == T_STR and ts_is_valid(self.strs[ik]) == 1 {
        raw = self.strs[ik]
    }
    let mut ts = ts_in
    if ts <= 0 {
        ts = wall_ms()
    }
    let mut retention = ret_ms
    if retention <= 0 and has(self.xseq, "\u001eTSret\u001e" + ik) {
        retention = self.xseq["\u001eTSret\u001e" + ik]
    } else if retention > 0 {
        self.xseq["\u001eTSret\u001e" + ik] = retention
    }
    let mut ts_arr, _, str_arr = ts_parse_samples(raw)
    let n = len(ts_arr)
    if n > 0 and ts == ts_arr[n - 1] {
        str_arr[n - 1] = val_s
    } else if n == 0 or ts > ts_arr[n - 1] {
        ts_arr = append(ts_arr, ts)
        str_arr = append(str_arr, val_s)
    } else {
        let mut nt = make([]int, 0, n + 1)
        let mut ns = make([]string, 0, n + 1)
        let mut placed = 0
        let mut i = 0
        while i < n {
            if placed == 0 and ts == ts_arr[i] {
                nt = append(nt, ts)
                ns = append(ns, val_s)
                placed = 1
            } else if placed == 0 and ts < ts_arr[i] {
                nt = append(nt, ts)
                ns = append(ns, val_s)
                nt = append(nt, ts_arr[i])
                ns = append(ns, str_arr[i])
                placed = 1
            } else {
                nt = append(nt, ts_arr[i])
                ns = append(ns, str_arr[i])
            }
            i = i + 1
        }
        ts_arr = nt
        str_arr = ns
    }
    let mut min_ts = 0
    if retention > 0 and len(ts_arr) > 0 {
        let max_t = ts_arr[len(ts_arr) - 1]
        min_ts = max_t - retention
    }
    self.strs[ik] = ts_encode_samples(ts_arr, str_arr, min_ts)
    self.types[ik] = T_STR
    return ts
}

fn Store_cmd_tscreate(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("ts.create")
    }
    let ik = ikey(db, argv[1])
    if self.kind(ik) != T_NONE {
        return r_err("ERR TSDB: key already exists")
    }
    let mut ret_ms = 0
    let mut i = 2
    while i < len(argv) {
        let u = str_to_upper(argv[i])
        if str_eq(u, "RETENTION") and i + 1 < len(argv) {
            let rv, rok = int_ok(argv[i + 1])
            if rok == 0 or rv < 0 {
                return r_err("ERR TSDB: invalid RETENTION")
            }
            ret_ms = rv
            i = i + 2
        } else if str_eq(u, "LABELS") {
            let lb = str_builder()
            i = i + 1
            while i + 1 < len(argv) {
                if str_len(builder_string(lb)) > 0 {
                    builder_write(lb, "\t")
                }
                builder_write(lb, argv[i])
                builder_write(lb, "=")
                builder_write(lb, argv[i + 1])
                i = i + 2
            }
            self.xp["\u001eTSlbl\u001e" + ik] = builder_string(lb)
            break
        } else {
            i = i + 1
        }
    }
    self.strs[ik] = "TS1\n"
    self.types[ik] = T_STR
    if ret_ms > 0 {
        self.xseq["\u001eTSret\u001e" + ik] = ret_ms
    }
    return r_ok()
}

fn Store_cmd_tsadd(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 {
        return r_arity("ts.add")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and (t != T_STR or ts_is_valid(self.strs[ik]) == 0) {
        return r_wrongtype()
    }
    let mut ts = 0
    if not str_eq(argv[2], "*") {
        let tv, tok = int_ok(argv[2])
        if tok == 0 or tv < 0 {
            return r_err("ERR TSDB: invalid timestamp")
        }
        ts = tv
    }
    if finite_score(argv[3]) == 0 {
        return r_err("ERR TSDB: invalid value")
    }
    let mut ret_ms = 0
    let mut i = 4
    while i < len(argv) {
        let u = str_to_upper(argv[i])
        if str_eq(u, "RETENTION") and i + 1 < len(argv) {
            ret_ms = int_of(argv[i + 1])
            i = i + 2
        } else {
            i = i + 1
        }
    }
    let out_ts = self.ts_append(ik, ts, argv[3], ret_ms)
    return r_int(out_ts)
}

fn Store_cmd_tsincrby(mut self: Store, db: int, argv: []string, sign: int) -> string {
    if len(argv) < 3 {
        return r_arity(str_to_lower(argv[0]))
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and (t != T_STR or ts_is_valid(self.strs[ik]) == 0) {
        return r_wrongtype()
    }
    if finite_score(argv[2]) == 0 {
        return r_err("ERR TSDB: invalid value")
    }
    let delta = parse_float(argv[2]) * float(sign)
    let mut cur_val = 0.0
    let mut ts = wall_ms()
    if t == T_STR {
        let ts_arr, val_arr, _ = ts_parse_samples(self.strs[ik])
        if len(val_arr) > 0 {
            cur_val = val_arr[len(val_arr) - 1]
            if ts < ts_arr[len(ts_arr) - 1] {
                ts = ts_arr[len(ts_arr) - 1]
            }
        }
    }
    let mut i = 3
    while i + 1 < len(argv) {
        if str_eq(str_to_upper(argv[i]), "TIMESTAMP") and not str_eq(argv[i + 1], "*") {
            ts = int_of(argv[i + 1])
        }
        i = i + 2
    }
    let nw_val = cur_val + delta
    let out_ts = self.ts_append(ik, ts, format_float(nw_val, 4), 0)
    return r_int(out_ts)
}

fn Store_cmd_tsget(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("ts.get")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return "*0\r\n"
    }
    if t != T_STR or ts_is_valid(self.strs[ik]) == 0 {
        return r_wrongtype()
    }
    let ts_arr, _, str_arr = ts_parse_samples(self.strs[ik])
    if len(ts_arr) == 0 {
        return "*0\r\n"
    }
    let last = len(ts_arr) - 1
    return "*2\r\n" + r_int(ts_arr[last]) + r_bulk(str_arr[last])
}

fn Store_cmd_tsrange(mut self: Store, db: int, argv: []string, rev: int) -> string {
    if len(argv) < 4 {
        return r_arity(str_to_lower(argv[0]))
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return "*0\r\n"
    }
    if t != T_STR or ts_is_valid(self.strs[ik]) == 0 {
        return r_wrongtype()
    }
    let mut min_ts = 0
    if not str_eq(argv[2], "-") {
        min_ts = int_of(argv[2])
    }
    let mut max_ts = 9223372036854775807
    if not str_eq(argv[3], "+") {
        max_ts = int_of(argv[3])
    }
    let mut count = -1
    let mut agg = ""
    let mut bucket = 0
    let mut i = 4
    while i < len(argv) {
        let u = str_to_upper(argv[i])
        if str_eq(u, "COUNT") and i + 1 < len(argv) {
            count = int_of(argv[i + 1])
            i = i + 2
        } else if str_eq(u, "AGGREGATION") and i + 2 < len(argv) {
            agg = str_to_upper(argv[i + 1])
            bucket = int_of(argv[i + 2])
            if bucket <= 0 {
                return r_err("ERR TSDB: bucketDuration must be greater than 0")
            }
            i = i + 3
        } else {
            i = i + 1
        }
    }
    let ts_arr, val_arr, str_arr = ts_parse_samples(self.strs[ik])
    let mut out_t = make([]int, 0, 8)
    let mut out_s = make([]string, 0, 8)
    if str_len(agg) == 0 {
        let mut k = 0
        while k < len(ts_arr) {
            if ts_arr[k] >= min_ts and ts_arr[k] <= max_ts {
                out_t = append(out_t, ts_arr[k])
                out_s = append(out_s, str_arr[k])
            }
            k = k + 1
        }
    } else {
        let mut k = 0
        while k < len(ts_arr) {
            if ts_arr[k] >= min_ts and ts_arr[k] <= max_ts {
                let b_ts = (ts_arr[k] / bucket) * bucket
                let mut sum = val_arr[k]
                let mut mn = val_arr[k]
                let mut mx = val_arr[k]
                let first_v = val_arr[k]
                let mut last_v = val_arr[k]
                let mut bc = 1
                k = k + 1
                while k < len(ts_arr) and ts_arr[k] <= max_ts and (ts_arr[k] / bucket) * bucket == b_ts {
                    let v = val_arr[k]
                    sum = sum + v
                    if v < mn {
                        mn = v
                    }
                    if v > mx {
                        mx = v
                    }
                    last_v = v
                    bc = bc + 1
                    k = k + 1
                }
                out_t = append(out_t, b_ts)
                if str_eq(agg, "AVG") {
                    out_s = append(out_s, format_float(sum / float(bc), 4))
                } else if str_eq(agg, "SUM") {
                    out_s = append(out_s, format_float(sum, 4))
                } else if str_eq(agg, "MIN") {
                    out_s = append(out_s, format_float(mn, 4))
                } else if str_eq(agg, "MAX") {
                    out_s = append(out_s, format_float(mx, 4))
                } else if str_eq(agg, "COUNT") {
                    out_s = append(out_s, fmt_int_fast(bc))
                } else if str_eq(agg, "FIRST") {
                    out_s = append(out_s, format_float(first_v, 4))
                } else {
                    out_s = append(out_s, format_float(last_v, 4))
                }
            } else {
                k = k + 1
            }
        }
    }
    let total = len(out_t)
    let mut take = total
    if count >= 0 and count < take {
        take = count
    }
    let sb = str_builder()
    builder_write(sb, "*")
    builder_write(sb, fmt_int_fast(take))
    builder_write(sb, "\r\n")
    let mut j = 0
    while j < take {
        let mut idx = j
        if rev == 1 {
            idx = total - 1 - j
        }
        builder_write(sb, "*2\r\n")
        builder_write(sb, r_int(out_t[idx]))
        builder_write(sb, r_bulk(out_s[idx]))
        j = j + 1
    }
    return builder_string(sb)
}

fn Store_cmd_tsinfo(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("ts.info")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_err("ERR TSDB: the key does not exist")
    }
    if t != T_STR or ts_is_valid(self.strs[ik]) == 0 {
        return r_wrongtype()
    }
    let ts_arr, _, _ = ts_parse_samples(self.strs[ik])
    let mut first_ts = 0
    let mut last_ts = 0
    if len(ts_arr) > 0 {
        first_ts = ts_arr[0]
        last_ts = ts_arr[len(ts_arr) - 1]
    }
    let ret = self.xseq["\u001eTSret\u001e" + ik]
    let sb = str_builder()
    builder_write(sb, "*8\r\n")
    builder_write(sb, r_bulk("totalSamples"))
    builder_write(sb, r_int(len(ts_arr)))
    builder_write(sb, r_bulk("firstTimestamp"))
    builder_write(sb, r_int(first_ts))
    builder_write(sb, r_bulk("lastTimestamp"))
    builder_write(sb, r_int(last_ts))
    builder_write(sb, r_bulk("retentionTime"))
    builder_write(sb, r_int(ret))
    return builder_string(sb)
}
