pack bonodis

// Sandboxed Lua subset for EVAL: KEYS/ARGV, redis.call/pcall, locals, if/while, return.
// No os/io/load/require. Runs inside one shard so redis.call is atomic there.

struct LVal {
    k: int
    n: int
    s: string
}

fn lv_nil() -> LVal {
    return LVal { k: 0, n: 0, s: "" }
}

fn lv_int(n: int) -> LVal {
    return LVal { k: 1, n: n, s: "" }
}

fn lv_str(s: string) -> LVal {
    return LVal { k: 2, n: 0, s: s }
}

fn lv_bool(b: int) -> LVal {
    return LVal { k: 3, n: b, s: "" }
}

fn lv_truth(v: LVal) -> int {
    if v.k == 0 {
        return 0
    }
    if v.k == 3 and v.n == 0 {
        return 0
    }
    return 1
}

fn lv_eq(a: LVal, b: LVal) -> int {
    if a.k != b.k {
        return 0
    }
    if a.k == 0 {
        return 1
    }
    if a.k == 1 or a.k == 3 {
        if a.n == b.n {
            return 1
        }
        return 0
    }
    if str_eq(a.s, b.s) {
        return 1
    }
    return 0
}

fn lua_skip(src: string, p: int) -> int {
    let n = str_len(src)
    let mut i = p
    while i < n {
        let c = str_byte_at(src, i)
        if c == 32 or c == 9 or c == 10 or c == 13 {
            i = i + 1
        } else if c == 45 and i + 1 < n and str_byte_at(src, i + 1) == 45 {
            i = i + 2
            while i < n and str_byte_at(src, i) != 10 {
                i = i + 1
            }
        } else {
            break
        }
    }
    return i
}

fn lua_is_id0(c: int) -> int {
    if c >= 65 and c <= 90 {
        return 1
    }
    if c >= 97 and c <= 122 {
        return 1
    }
    if c == 95 {
        return 1
    }
    return 0
}

fn lua_is_id(c: int) -> int {
    if lua_is_id0(c) == 1 {
        return 1
    }
    if c >= 48 and c <= 57 {
        return 1
    }
    return 0
}

fn lua_ident(src: string, p: int) -> (string, int) {
    let n = str_len(src)
    if p >= n or lua_is_id0(str_byte_at(src, p)) == 0 {
        return ("", p)
    }
    let mut i = p + 1
    while i < n and lua_is_id(str_byte_at(src, i)) == 1 {
        i = i + 1
    }
    return (src[p:i], i)
}

fn lua_kw(src: string, p: int, kw: string) -> int {
    let id, np = lua_ident(src, p)
    if str_eq(id, kw) {
        return np
    }
    return p
}

fn lua_skip_end(src: string, p0: int) -> int {
    let mut sp = p0
    let mut depth = 1
    while sp < str_len(src) and depth > 0 {
        sp = lua_skip(src, sp)
        if sp >= str_len(src) {
            break
        }
        let wid, wp = lua_ident(src, sp)
        if str_eq(wid, "if") or str_eq(wid, "while") {
            depth = depth + 1
            sp = wp
        } else if str_eq(wid, "end") {
            depth = depth - 1
            sp = wp
        } else if str_len(wid) > 0 {
            sp = wp
        } else {
            sp = sp + 1
        }
    }
    return sp
}

fn lua_str(src: string, p: int) -> (string, int, int) {
    let n = str_len(src)
    if p >= n {
        return ("", p, 1)
    }
    let q = str_byte_at(src, p)
    if q != 34 and q != 39 {
        return ("", p, 1)
    }
    let b = str_builder()
    let mut i = p + 1
    while i < n {
        let c = str_byte_at(src, i)
        if c == q {
            return (builder_string(b), i + 1, 0)
        }
        if c == 92 and i + 1 < n {
            let e = str_byte_at(src, i + 1)
            if e == 110 {
                builder_write(b, "\n")
            } else if e == 116 {
                builder_write(b, "\t")
            } else {
                builder_write_byte(b, byte(e))
            }
            i = i + 2
        } else {
            builder_write_byte(b, byte(c))
            i = i + 1
        }
    }
    return ("", p, 1)
}

fn lua_num(src: string, p: int) -> (int, int, int) {
    let n = str_len(src)
    let mut i = p
    let mut neg = 0
    if i < n and str_byte_at(src, i) == 45 {
        neg = 1
        i = i + 1
    }
    if i >= n or str_byte_at(src, i) < 48 or str_byte_at(src, i) > 57 {
        return (0, p, 1)
    }
    let mut v = 0
    while i < n {
        let c = str_byte_at(src, i)
        if c < 48 or c > 57 {
            break
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    if neg == 1 {
        v = 0 - v
    }
    return (v, i, 0)
}

fn lua_enc(v: LVal) -> string {
    if v.k == 0 {
        return "N"
    }
    if v.k == 1 {
        return "I" + format_int(v.n)
    }
    if v.k == 3 {
        return "B" + format_int(v.n)
    }
    return "S" + format_int(str_len(v.s)) + ":" + v.s
}

fn lua_dec(s: string) -> LVal {
    if str_len(s) == 0 or str_eq(s, "N") {
        return lv_nil()
    }
    let c = str_byte_at(s, 0)
    if c == 73 {
        return lv_int(int_of(s[1:]))
    }
    if c == 66 {
        return lv_bool(int_of(s[1:]))
    }
    if c == 83 {
        let col = str_index(s, ":")
        if col < 2 {
            return lv_str(s[1:])
        }
        return lv_str(s[col + 1:])
    }
    return lv_str(s)
}

fn lua_from_resp(r: string) -> (LVal, int) {
    if str_len(r) == 0 {
        return (lv_nil(), 0)
    }
    let c = str_byte_at(r, 0)
    if c == 45 {
        return (lv_str(r), 1)
    }
    if c == 43 {
        let cr = find_crlf(r, 0)
        if cr > 1 {
            return (lv_str(r[1:cr]), 0)
        }
        return (lv_str("OK"), 0)
    }
    if c == 58 {
        let cr = find_crlf(r, 0)
        if cr > 1 {
            return (lv_int(int_of(r[1:cr])), 0)
        }
        return (lv_int(0), 0)
    }
    if c == 36 {
        if str_has_prefix(r, "$-1") {
            return (lv_nil(), 0)
        }
        return (lv_str(bulk_payload(r)), 0)
    }
    if c == 42 {
        if str_has_prefix(r, "*-1") {
            return (lv_nil(), 0)
        }
        let xs = parse_array_bulks(r)
        if len(xs) == 0 {
            return (lv_nil(), 0)
        }
        return (lv_str(xs[0]), 0)
    }
    return (lv_str(r), 0)
}

fn lua_to_resp(v: LVal) -> string {
    if v.k == 0 {
        return r_nil()
    }
    if v.k == 1 {
        return r_int(v.n)
    }
    if v.k == 3 {
        if v.n == 0 {
            return r_nil()
        }
        return r_int(1)
    }
    return r_bulk(v.s)
}

fn lua_idx_get(name: string, idx: int, keys: []string, args: []string) -> LVal {
    if idx < 1 {
        return lv_nil()
    }
    if str_eq(name, "KEYS") {
        if idx > len(keys) {
            return lv_nil()
        }
        return lv_str(keys[idx - 1])
    }
    if str_eq(name, "ARGV") {
        if idx > len(args) {
            return lv_nil()
        }
        return lv_str(args[idx - 1])
    }
    return lv_nil()
}

fn Store_lua_primary(mut self: Store, src: string, p0: int, keys: []string, args: []string, db: int, mut env: map[string]string) -> (LVal, int, int) {
    let p = lua_skip(src, p0)
    let n = str_len(src)
    if p >= n {
        return (lv_nil(), p, 1)
    }
    let c = str_byte_at(src, p)
    if c == 34 or c == 39 {
        let s, np, e = lua_str(src, p)
        if e != 0 {
            return (lv_nil(), p, 1)
        }
        return (lv_str(s), np, 0)
    }
    if c == 40 {
        let v, np, e = self.lua_expr(src, p + 1, keys, args, db, env)
        if e != 0 {
            return (v, np, e)
        }
        let q = lua_skip(src, np)
        if q >= n or str_byte_at(src, q) != 41 {
            return (lv_nil(), q, 1)
        }
        return (v, q + 1, 0)
    }
    if c >= 48 and c <= 57 or c == 45 {
        let v, np, e = lua_num(src, p)
        if e == 0 {
            return (lv_int(v), np, 0)
        }
    }
    let id, np = lua_ident(src, p)
    if str_len(id) == 0 {
        return (lv_nil(), p, 1)
    }
    if str_eq(id, "nil") {
        return (lv_nil(), np, 0)
    }
    if str_eq(id, "true") {
        return (lv_bool(1), np, 0)
    }
    if str_eq(id, "false") {
        return (lv_bool(0), np, 0)
    }
    let q = lua_skip(src, np)
    if str_eq(id, "KEYS") or str_eq(id, "ARGV") {
        if q < n and str_byte_at(src, q) == 91 {
            let ix, qp, e = self.lua_expr(src, q + 1, keys, args, db, env)
            if e != 0 {
                return (ix, qp, e)
            }
            let r = lua_skip(src, qp)
            if r >= n or str_byte_at(src, r) != 93 {
                return (lv_nil(), r, 1)
            }
            let mut idx = ix.n
            if ix.k == 2 {
                idx = int_of(ix.s)
            }
            return (lua_idx_get(id, idx, keys, args), r + 1, 0)
        }
        return (lv_nil(), np, 1)
    }
    if str_eq(id, "redis") {
        if q < n and str_byte_at(src, q) == 46 {
            let meth, mp = lua_ident(src, q + 1)
            let r = lua_skip(src, mp)
            if r >= n or str_byte_at(src, r) != 40 {
                return (lv_nil(), r, 1)
            }
            let mut argv = make([]string, 0, 8)
            let mut ap = r + 1
            ap = lua_skip(src, ap)
            while ap < n and str_byte_at(src, ap) != 41 {
                let av, a2, ae = self.lua_expr(src, ap, keys, args, db, env)
                if ae != 0 {
                    return (av, a2, ae)
                }
                if av.k == 1 {
                    argv = append(argv, format_int(av.n))
                } else if av.k == 0 {
                    argv = append(argv, "")
                } else {
                    argv = append(argv, av.s)
                }
                ap = lua_skip(src, a2)
                if ap < n and str_byte_at(src, ap) == 44 {
                    ap = lua_skip(src, ap + 1)
                }
            }
            if ap >= n or str_byte_at(src, ap) != 41 {
                return (lv_nil(), ap, 1)
            }
            if len(argv) == 0 {
                return (lv_nil(), ap + 1, 2)
            }
            argv[0] = str_to_upper(argv[0])
            let rr = self.apply(db, argv)
            let lv, ler = lua_from_resp(rr)
            if ler != 0 and not str_eq(meth, "pcall") {
                return (lv, ap + 1, 2)
            }
            if ler != 0 {
                return (lv_bool(0), ap + 1, 0)
            }
            return (lv, ap + 1, 0)
        }
        return (lv_nil(), np, 1)
    }
    if str_eq(id, "tonumber") or str_eq(id, "tostring") {
        let r = lua_skip(src, np)
        if r >= n or str_byte_at(src, r) != 40 {
            return (lv_nil(), r, 1)
        }
        let av, a2, ae = self.lua_expr(src, r + 1, keys, args, db, env)
        if ae != 0 {
            return (av, a2, ae)
        }
        let epos = lua_skip(src, a2)
        if epos >= n or str_byte_at(src, epos) != 41 {
            return (lv_nil(), epos, 1)
        }
        if str_eq(id, "tostring") {
            if av.k == 1 {
                return (lv_str(format_int(av.n)), epos + 1, 0)
            }
            if av.k == 0 {
                return (lv_str("nil"), epos + 1, 0)
            }
            return (lv_str(av.s), epos + 1, 0)
        }
        if av.k == 1 {
            return (av, epos + 1, 0)
        }
        let nn, ok = int_ok(av.s)
        if ok == 0 {
            return (lv_nil(), epos + 1, 0)
        }
        return (lv_int(nn), epos + 1, 0)
    }
    if has(env, id) {
        return (lua_dec(env[id]), np, 0)
    }
    return (lv_nil(), np, 0)
}

fn Store_lua_unary(mut self: Store, src: string, p0: int, keys: []string, args: []string, db: int, mut env: map[string]string) -> (LVal, int, int) {
    let p = lua_skip(src, p0)
    let id, np = lua_ident(src, p)
    if str_eq(id, "not") {
        let v, qp, e = self.lua_unary(src, np, keys, args, db, env)
        if e != 0 {
            return (v, qp, e)
        }
        if lv_truth(v) == 1 {
            return (lv_bool(0), qp, 0)
        }
        return (lv_bool(1), qp, 0)
    }
    if p < str_len(src) and str_byte_at(src, p) == 35 {
        let v, qp, e = self.lua_unary(src, p + 1, keys, args, db, env)
        if e != 0 {
            return (v, qp, e)
        }
        if v.k == 2 {
            return (lv_int(str_len(v.s)), qp, 0)
        }
        if v.k == 1 {
            return (lv_int(str_len(format_int(v.n))), qp, 0)
        }
        return (lv_int(0), qp, 0)
    }
    if p < str_len(src) and str_byte_at(src, p) == 45 {
        let nxt = lua_skip(src, p + 1)
        if nxt < str_len(src) and str_byte_at(src, nxt) >= 48 and str_byte_at(src, nxt) <= 57 {
            return self.lua_primary(src, p, keys, args, db, env)
        }
        let v, qp, e = self.lua_unary(src, p + 1, keys, args, db, env)
        if e != 0 {
            return (v, qp, e)
        }
        if v.k == 1 {
            return (lv_int(0 - v.n), qp, 0)
        }
        return (lv_int(0), qp, 0)
    }
    return self.lua_primary(src, p, keys, args, db, env)
}

fn Store_lua_mul(mut self: Store, src: string, p0: int, keys: []string, args: []string, db: int, mut env: map[string]string) -> (LVal, int, int) {
    let left, p, e = self.lua_unary(src, p0, keys, args, db, env)
    if e != 0 {
        return (left, p, e)
    }
    let mut lp = p
    let mut lv = left
    while true {
        let q = lua_skip(src, lp)
        if q >= str_len(src) {
            return (lv, lp, 0)
        }
        let c = str_byte_at(src, q)
        if c != 42 and c != 47 and c != 37 {
            return (lv, lp, 0)
        }
        let rv, rp, re = self.lua_unary(src, q + 1, keys, args, db, env)
        if re != 0 {
            return (rv, rp, re)
        }
        let mut a = lv.n
        let mut b = rv.n
        if lv.k != 1 {
            a = int_of(lv.s)
        }
        if rv.k != 1 {
            b = int_of(rv.s)
        }
        if c == 42 {
            lv = lv_int(a * b)
        } else if c == 47 {
            if b == 0 {
                return (lv_nil(), rp, 2)
            }
            lv = lv_int(a / b)
        } else {
            if b == 0 {
                return (lv_nil(), rp, 2)
            }
            lv = lv_int(a % b)
        }
        lp = rp
    }
    return (lv, lp, 0)
}

fn Store_lua_add(mut self: Store, src: string, p0: int, keys: []string, args: []string, db: int, mut env: map[string]string) -> (LVal, int, int) {
    let left, p, e = self.lua_mul(src, p0, keys, args, db, env)
    if e != 0 {
        return (left, p, e)
    }
    let mut lp = p
    let mut lv = left
    while true {
        let q = lua_skip(src, lp)
        if q >= str_len(src) {
            return (lv, lp, 0)
        }
        let c = str_byte_at(src, q)
        if c != 43 and c != 45 {
            if q + 1 < str_len(src) and c == 46 and str_byte_at(src, q + 1) == 46 {
                let rv, rp, re = self.lua_mul(src, q + 2, keys, args, db, env)
                if re != 0 {
                    return (rv, rp, re)
                }
                let mut sa = lv.s
                if lv.k == 1 {
                    sa = format_int(lv.n)
                }
                let mut sb = rv.s
                if rv.k == 1 {
                    sb = format_int(rv.n)
                }
                lv = lv_str(sa + sb)
                lp = rp
                continue
            }
            return (lv, lp, 0)
        }
        let rv, rp, re = self.lua_mul(src, q + 1, keys, args, db, env)
        if re != 0 {
            return (rv, rp, re)
        }
        let mut a = lv.n
        let mut b = rv.n
        if lv.k != 1 {
            a = int_of(lv.s)
        }
        if rv.k != 1 {
            b = int_of(rv.s)
        }
        if c == 43 {
            lv = lv_int(a + b)
        } else {
            lv = lv_int(a - b)
        }
        lp = rp
    }
    return (lv, lp, 0)
}

fn Store_lua_cmp(mut self: Store, src: string, p0: int, keys: []string, args: []string, db: int, mut env: map[string]string) -> (LVal, int, int) {
    let left, p, e = self.lua_add(src, p0, keys, args, db, env)
    if e != 0 {
        return (left, p, e)
    }
    let q = lua_skip(src, p)
    if q + 1 >= str_len(src) {
        return (left, p, 0)
    }
    let c0 = str_byte_at(src, q)
    let c1 = str_byte_at(src, q + 1)
    let mut op = ""
    let mut qp = q
    if c0 == 61 and c1 == 61 {
        op = "=="
        qp = q + 2
    } else if c0 == 126 and c1 == 61 {
        op = "~="
        qp = q + 2
    } else if c0 == 60 and c1 == 61 {
        op = "<="
        qp = q + 2
    } else if c0 == 62 and c1 == 61 {
        op = ">="
        qp = q + 2
    } else if c0 == 60 {
        op = "<"
        qp = q + 1
    } else if c0 == 62 {
        op = ">"
        qp = q + 1
    } else {
        return (left, p, 0)
    }
    let right, rp, re = self.lua_add(src, qp, keys, args, db, env)
    if re != 0 {
        return (right, rp, re)
    }
    if str_eq(op, "==") {
        return (lv_bool(lv_eq(left, right)), rp, 0)
    }
    if str_eq(op, "~=") {
        if lv_eq(left, right) == 1 {
            return (lv_bool(0), rp, 0)
        }
        return (lv_bool(1), rp, 0)
    }
    let mut a = left.n
    let mut b = right.n
    if left.k == 2 {
        a = int_of(left.s)
    }
    if right.k == 2 {
        b = int_of(right.s)
    }
    if str_eq(op, "<") {
        if a < b {
            return (lv_bool(1), rp, 0)
        }
        return (lv_bool(0), rp, 0)
    }
    if str_eq(op, ">") {
        if a > b {
            return (lv_bool(1), rp, 0)
        }
        return (lv_bool(0), rp, 0)
    }
    if str_eq(op, "<=") {
        if a <= b {
            return (lv_bool(1), rp, 0)
        }
        return (lv_bool(0), rp, 0)
    }
    if a >= b {
        return (lv_bool(1), rp, 0)
    }
    return (lv_bool(0), rp, 0)
}

fn Store_lua_logic(mut self: Store, src: string, p0: int, keys: []string, args: []string, db: int, mut env: map[string]string) -> (LVal, int, int) {
    let left, p, e = self.lua_cmp(src, p0, keys, args, db, env)
    if e != 0 {
        return (left, p, e)
    }
    let mut lp = p
    let mut lv = left
    while true {
        let q = lua_skip(src, lp)
        let id, np = lua_ident(src, q)
        if str_eq(id, "and") {
            let rv, rp, re = self.lua_cmp(src, np, keys, args, db, env)
            if re != 0 {
                return (rv, rp, re)
            }
            if lv_truth(lv) == 0 {
                lp = rp
            } else {
                lv = rv
                lp = rp
            }
        } else if str_eq(id, "or") {
            let rv, rp, re = self.lua_cmp(src, np, keys, args, db, env)
            if re != 0 {
                return (rv, rp, re)
            }
            if lv_truth(lv) == 1 {
                lp = rp
            } else {
                lv = rv
                lp = rp
            }
        } else {
            return (lv, lp, 0)
        }
    }
    return (lv, lp, 0)
}

fn Store_lua_expr(mut self: Store, src: string, p0: int, keys: []string, args: []string, db: int, mut env: map[string]string) -> (LVal, int, int) {
    return self.lua_logic(src, p0, keys, args, db, env)
}

fn Store_lua_block(mut self: Store, src: string, p0: int, keys: []string, args: []string, db: int, mut env: map[string]string) -> (LVal, int, int) {
    let mut p = lua_skip(src, p0)
    let mut last = lv_nil()
    let mut steps = 0
    while p < str_len(src) and steps < 10000 {
        steps = steps + 1
        p = lua_skip(src, p)
        if p >= str_len(src) {
            break
        }
        let id, np = lua_ident(src, p)
        if str_eq(id, "end") or str_eq(id, "else") or str_eq(id, "elseif") {
            return (last, p, 0)
        }
        if str_eq(id, "return") {
            let v, rp, e = self.lua_expr(src, np, keys, args, db, env)
            if e != 0 {
                return (v, rp, e)
            }
            return (v, rp, 3)
        }
        if str_eq(id, "local") {
            let name, n2 = lua_ident(src, lua_skip(src, np))
            if str_len(name) == 0 {
                return (lv_nil(), n2, 1)
            }
            let eqp = lua_skip(src, n2)
            if eqp >= str_len(src) or str_byte_at(src, eqp) != 61 {
                return (lv_nil(), eqp, 1)
            }
            let v, rp, e = self.lua_expr(src, eqp + 1, keys, args, db, env)
            if e != 0 {
                return (v, rp, e)
            }
            env[name] = lua_enc(v)
            last = v
            p = rp
            continue
        }
        if str_eq(id, "while") {
            let mut loops = 0
            let mut done = 0
            while loops < 10000 and done == 0 {
                loops = loops + 1
                let cond, cp, ce = self.lua_expr(src, np, keys, args, db, env)
                if ce != 0 {
                    return (cond, cp, ce)
                }
                let d0 = lua_skip(src, cp)
                let d1 = lua_kw(src, d0, "do")
                if d1 == d0 {
                    return (lv_nil(), d0, 1)
                }
                if lv_truth(cond) == 0 {
                    p = lua_skip_end(src, d1)
                    done = 1
                } else {
                    let bv, bp, be = self.lua_block(src, d1, keys, args, db, env)
                    if be != 0 and be != 3 {
                        return (bv, bp, be)
                    }
                    if be == 3 {
                        return (bv, bp, 3)
                    }
                    last = bv
                }
            }
            if done == 0 {
                let cond, cp, ce = self.lua_expr(src, np, keys, args, db, env)
                let _ = ce
                let d0 = lua_skip(src, cp)
                let d1 = lua_kw(src, d0, "do")
                let _ = cond.k
                p = lua_skip_end(src, d1)
            }
            continue
        }
        if str_eq(id, "if") {
            let cond, cp, ce = self.lua_expr(src, np, keys, args, db, env)
            if ce != 0 {
                return (cond, cp, ce)
            }
            let th = lua_skip(src, cp)
            let th2 = lua_kw(src, th, "then")
            if th2 == th {
                return (lv_nil(), th, 1)
            }
            if lv_truth(cond) == 1 {
                let bv, bp, be = self.lua_block(src, th2, keys, args, db, env)
                if be != 0 and be != 3 {
                    return (bv, bp, be)
                }
                if be == 3 {
                    return (bv, bp, 3)
                }
                last = bv
                p = lua_skip(src, bp)
                let eid, ep = lua_ident(src, p)
                if str_eq(eid, "else") {
                    let skipv, sp, se = self.lua_block(src, ep, keys, args, db, env)
                    let _ = skipv.k
                    if se != 0 {
                        return (lv_nil(), sp, se)
                    }
                    p = lua_skip(src, sp)
                    let xid, xp = lua_ident(src, p)
                    if str_eq(xid, "end") {
                        p = xp
                    }
                } else if str_eq(eid, "end") {
                    p = ep
                }
                continue
            }
            let mut sp = th2
            let mut depth = 1
            while sp < str_len(src) and depth > 0 {
                sp = lua_skip(src, sp)
                let wid, wp = lua_ident(src, sp)
                if str_eq(wid, "if") or str_eq(wid, "while") {
                    depth = depth + 1
                    sp = wp
                } else if str_eq(wid, "end") {
                    depth = depth - 1
                    if depth == 0 {
                        let elsep = lua_skip(src, sp)
                        let eid, e2 = lua_ident(src, elsep)
                        if str_eq(eid, "else") and depth == 0 {
                            let bv, bp, be = self.lua_block(src, e2, keys, args, db, env)
                            if be != 0 and be != 3 {
                                return (bv, bp, be)
                            }
                            if be == 3 {
                                return (bv, bp, 3)
                            }
                            last = bv
                            p = lua_skip(src, bp)
                            let xid, xp = lua_ident(src, p)
                            if str_eq(xid, "end") {
                                p = xp
                            }
                            break
                        }
                        p = wp
                    } else {
                        sp = wp
                    }
                } else if str_eq(wid, "else") and depth == 1 {
                    let bv, bp, be = self.lua_block(src, wp, keys, args, db, env)
                    if be != 0 and be != 3 {
                        return (bv, bp, be)
                    }
                    if be == 3 {
                        return (bv, bp, 3)
                    }
                    last = bv
                    p = lua_skip(src, bp)
                    let xid, xp = lua_ident(src, p)
                    if str_eq(xid, "end") {
                        p = xp
                    }
                    break
                } else if str_len(wid) > 0 {
                    sp = wp
                } else {
                    sp = sp + 1
                }
            }
            continue
        }
        if str_len(id) > 0 {
            let eqp = lua_skip(src, np)
            if eqp < str_len(src) and str_byte_at(src, eqp) == 61 {
                if eqp + 1 >= str_len(src) or str_byte_at(src, eqp + 1) != 61 {
                    let v, rp, e = self.lua_expr(src, eqp + 1, keys, args, db, env)
                    if e != 0 {
                        return (v, rp, e)
                    }
                    env[id] = lua_enc(v)
                    last = v
                    p = rp
                    continue
                }
            }
        }
        let v, rp, e = self.lua_expr(src, p, keys, args, db, env)
        if e != 0 {
            return (v, rp, e)
        }
        last = v
        p = rp
        p = lua_skip(src, p)
        if p < str_len(src) and str_byte_at(src, p) == 59 {
            p = p + 1
        }
    }
    return (last, p, 0)
}

fn Store_cmd_eval(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("eval")
    }
    let src = argv[1]
    if str_len(src) > 65536 {
        return r_err("ERR lua script too big")
    }
    let mut paren_depth = 0
    let mut pi = 0
    while pi < str_len(src) {
        let pc = str_byte_at(src, pi)
        if pc == 40 {
            paren_depth = paren_depth + 1
            if paren_depth > 200 {
                return r_err("ERR lua nesting too deep")
            }
        } else if pc == 41 {
            paren_depth = paren_depth - 1
        }
        pi = pi + 1
    }
    let nk, ok = int_ok(argv[2])
    if ok == 0 or nk < 0 {
        return r_notint()
    }
    if nk > len(argv) - 3 {
        return r_syntax()
    }
    let mut keys = make([]string, 0, nk)
    let mut i = 0
    while i < nk {
        keys = append(keys, argv[3 + i])
        i = i + 1
    }
    let mut args = make([]string, 0, 4)
    i = 3 + nk
    while i < len(argv) {
        args = append(args, argv[i])
        i = i + 1
    }
    let mut env = make(map[string]string)
    let v, pe, e = self.lua_block(src, 0, keys, args, db, env)
    let _ = pe
    if e == 1 {
        return r_err("ERR Error compiling script: syntax error")
    }
    if e == 3 {
        return lua_to_resp(v)
    }
    if e == 2 {
        if v.k == 2 and str_has_prefix(v.s, "-") {
            return v.s
        }
        return r_err("ERR Error running script")
    }
    return lua_to_resp(v)
}
