        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
    let _ = unix_unlink(sock)
}

fn TestLiveEvalAndAuth() {
    let stop = atomic_new(0)
    let port = 19536
    crew t {
        let srv = t.kick(boot(port, "s3cret", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let no = resp_send(fd, ["EVAL", "return 1", "0"])
        assert(str_contains(no, "NOAUTH"))
        assert_eq_str(resp_send(fd, ["AUTH", "s3cret"]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["EVAL", "return 1", "0"]), ":1\r\n")
        assert_eq_str(resp_send(fd, ["SET", "ek", "1"]), "+OK\r\n")
        let g = resp_send(fd, ["EVAL", "return redis.call('GET', KEYS[1])", "1", "ek"])
        assert_eq_str(g, "$1\r\n1\r\n")
        let ld = resp_send(fd, ["SCRIPT", "LOAD", "return 2"])
        assert(str_has_prefix(ld, "$"))
        let sha = bulk_str(ld)
        assert_eq_str(resp_send(fd, ["EVALSHA", sha, "0"]), ":2\r\n")
        let nan = resp_send(fd, ["ZADD", "z", "nan", "m"])
        assert(str_has_prefix(nan, "-ERR"))
        assert_eq_str(resp_send(fd, ["EVAL", "local i = 0 while i < 2 do i = i + 1 end return i", "0"]), ":2\r\n")
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveTlsVerify() {
    let stop = atomic_new(0)
    let port = 19537
    let cert = "/tmp/bonodis_tls_ca.crt"
    let key = "/tmp/bonodis_tls_ca.key"
    let rc = tls_make_self_signed(cert, key, "localhost", 1)
    if rc != 0 {
        return
    }
    crew t {
        let cfg = pack_opts(0, "", "", "", "0") + "\n0\n0\n10000\n0\n" + cert + "\n" + key + "\n\n0\n0\n1\n50000\n\n448\n" + cert
        let srv = t.kick(serve("127.0.0.1", port, 4, "", "", 0, 0, stop, 10000, 0, 10000, 0, cfg))
        let mut i = 0
        let mut fd = -1
        while i < 80 {
            fd = tcp_connect("127.0.0.1", port)
            if fd >= 0 {
                break
            }
            sleep_ms(50)
            i = i + 1
        }
        assert(fd >= 0)
        let _ = tcp_nodelay(fd)
        let cli = tls_client_new(cert)
        let tc = tls_connect(cli, fd, "localhost")
        assert(tls_conn_fd(tc) >= 0)
        let n = tls_write(tc, encode_array(["PING"]))
        assert(n > 0)
        let r = tls_read(tc, 65536)
        assert(str_contains(r, "PONG"))
        let _ = tls_conn_close(tc)
        let _ = tls_client_free(cli)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveHttpApi() {
    let stop = atomic_new(0)
    let port = 19538
    let hport = 19539
    crew t {
        let srv = t.kick(boot_metrics(port, hport, stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let _ = tcp_close(fd)
        let mut hi = 0
        let mut hfd = -1
        while hi < 40 {
            hfd = tcp_connect("127.0.0.1", hport)
            if hfd >= 0 {
                break
            }
            sleep_ms(50)
            hi = hi + 1
        }
        assert(hfd >= 0)
        let _ = tcp_nodelay(hfd)
        let _ = tcp_set_timeout(hfd, 2000)
        let _ = tcp_write_all(hfd, "GET /api HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n")
        let disc = tcp_read(hfd)
        assert(str_contains(disc, "bonodis"))
        assert(str_contains(disc, "RESP2") or str_contains(disc, "\"ok\""))
        let _ = tcp_close(hfd)
        hfd = tcp_connect("127.0.0.1", hport)
        assert(hfd >= 0)
        let _ = tcp_set_timeout(hfd, 1000)
        let _ = tcp_write_all(hfd, "GET /api/ping HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
        let ping = tcp_read(hfd)
        assert(str_contains(ping, "PONG"))
        let _ = tcp_close(hfd)
        let body = "{\"argv\":[\"SET\",\"apik\",\"1\"]}"
        let req = "POST /api HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: " + format_int(str_len(body)) + "\r\nConnection: close\r\n\r\n" + body
        hfd = tcp_connect("127.0.0.1", hport)
        assert(hfd >= 0)
        let _ = tcp_set_timeout(hfd, 1000)
        let _ = tcp_write_all(hfd, req)
        let setr = tcp_read(hfd)
        assert(str_contains(setr, "OK"))
        let _ = tcp_close(hfd)
        let gbody = "{\"argv\":[\"GET\",\"apik\"]}"
        let greq = "POST /api HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: " + format_int(str_len(gbody)) + "\r\nConnection: close\r\n\r\n" + gbody
        hfd = tcp_connect("127.0.0.1", hport)
        assert(hfd >= 0)
        let _ = tcp_set_timeout(hfd, 1000)
        let _ = tcp_write_all(hfd, greq)
        let getr = tcp_read(hfd)
        assert(str_contains(getr, "\"result\":\"1\""))
        let _ = tcp_close(hfd)
        let ebody = "{\"argv\":[\"EVAL\",\"return 7\",\"0\"]}"
        let ereq = "POST /api HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: " + format_int(str_len(ebody)) + "\r\nConnection: close\r\n\r\n" + ebody
        hfd = tcp_connect("127.0.0.1", hport)
        assert(hfd >= 0)
        let _ = tcp_set_timeout(hfd, 1000)
        let _ = tcp_write_all(hfd, ereq)
        let ev = tcp_read(hfd)
        assert(str_contains(ev, "\"result\":7"))
        let _ = tcp_close(hfd)
        let pbody = "{\"commands\":[[\"SET\",\"pk\",\"z\"],[\"GET\",\"pk\"]]}"
        let preq = "POST /api/pipeline HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: " + format_int(str_len(pbody)) + "\r\nConnection: close\r\n\r\n" + pbody
        hfd = tcp_connect("127.0.0.1", hport)
        assert(hfd >= 0)
        let _ = tcp_set_timeout(hfd, 1000)
        let _ = tcp_write_all(hfd, preq)
        let pipe = tcp_read(hfd)
        assert(str_contains(pipe, "replies"))
        assert(str_contains(pipe, "z"))
        let _ = tcp_close(hfd)
        hfd = tcp_connect("127.0.0.1", hport)
        assert(hfd >= 0)
        let _ = tcp_set_timeout(hfd, 2000)
        let _ = tcp_write_all(hfd, "GET /play HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n")
        let play = tcp_read(hfd)
        assert(str_contains(play, "TURN"))
        let _ = tcp_close(hfd)
        let mb = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}"
        let mreq = "POST /mcp HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: " + format_int(str_len(mb)) + "\r\nConnection: close\r\n\r\n" + mb
        hfd = tcp_connect("127.0.0.1", hport)
        assert(hfd >= 0)
        let _ = tcp_set_timeout(hfd, 2000)
        let _ = tcp_write_all(hfd, mreq)
        let mcp = tcp_read(hfd)
        assert(str_contains(mcp, "bonodis"))
        assert(str_contains(mcp, "protocolVersion"))
        let _ = tcp_close(hfd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestReact() {
    let stop = atomic_new(0)
    let port = 16393
    crew t {
        let srv = t.kick(boot(port, "", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)

        // REACT CREATE: when {r}src is written, SET {r}dst to the value
        let cr = resp_send(fd, ["REACT", "CREATE", "copyval", "{r}src", "ON", "WRITE", "SET", "{r}dst", "$VALUE"])
        assert(str_has_prefix(cr, "+"))
        // Write triggers the reaction
        assert_eq_str(resp_send(fd, ["SET", "{r}src", "hello"]), "+OK\r\n")
        // Reaction should have set {r}dst
        let got = resp_send(fd, ["GET", "{r}dst"])
        assert(str_contains(got, "hello"))
        // Delete the rule
        let dr = resp_send(fd, ["REACT", "DELETE", "copyval"])
        assert(str_has_prefix(dr, ":"))
        // Write again — no reaction
        assert_eq_str(resp_send(fd, ["SET", "{r}src", "gone"]), "+OK\r\n")
        let got2 = resp_send(fd, ["GET", "{r}dst"])
        assert(str_contains(got2, "hello"))

        let _ = resp_send(fd, ["QUIT"])
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestReactChain() {
    let stop = atomic_new(0)
    let port = 16394
    crew t {
        let srv = t.kick(boot(port, "", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)

        // Chain: SET {c}src triggers GET {c}src | SET {c}copy $RESULT
        let cr = resp_send(fd, ["REACT", "CREATE", "chain", "{c}src", "ON", "WRITE", "GET", "{c}src", "|", "SET", "{c}copy", "$RESULT"])
        assert_eq_str(cr, "+OK\r\n")

        assert_eq_str(resp_send(fd, ["SET", "{c}src", "chained"]), "+OK\r\n")
        let got = resp_send(fd, ["GET", "{c}copy"])
        assert(str_contains(got, "chained"))

        let _ = resp_send(fd, ["QUIT"])
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}
