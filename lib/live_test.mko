// End-to-end RESP over TCP. Server is kicked in-process — 100% Mako.

fn boot(port: int, pass: string, stop: AtomicInt) -> int {
    return serve("127.0.0.1", port, 4, pass, "", 0, 0, stop, 10000, 0, 10000, 0, "")
}

fn boot_metrics(port: int, mport: int, stop: AtomicInt) -> int {
    return serve("127.0.0.1", port, 4, "", "", 0, 0, stop, 10000, 0, 0, mport, "")
}

fn boot_cluster(port: int, stop: AtomicInt, dir: string) -> int {
    return serve("127.0.0.1", port, 4, "", "", 0, 0, stop, 10000, 0, 10000, 0, pack_opts(1, "127.0.0.1", dir, "", "0"))
}

fn boot_replica_of(port: int, stop: AtomicInt, mhost: string, mport: int) -> int {
    return serve("127.0.0.1", port, 4, "", "", 0, 0, stop, 10000, 0, 10000, 0, pack_opts(0, "", "", mhost, format_int(mport)))
}

fn boot_tls(port: int, stop: AtomicInt, cert: string, key: string) -> int {
    let cfg = pack_opts(0, "", "", "", "0") + "\n0\n0\n10000\n0\n" + cert + "\n" + key + "\n"
    return serve("127.0.0.1", port, 4, "", "", 0, 0, stop, 10000, 0, 10000, 0, cfg)
}

fn boot_persist(port: int, stop: AtomicInt, dir: string) -> int {
    let cfg = pack_opts(0, "", dir, "", "0") + "\n0\n0\n1000\n0"
    return serve("127.0.0.1", port, 4, "", dir + "/appendonly.aof", 1, 0, stop, 10000, 0, 10000, 0, cfg)
}

fn boot_unix(port: int, sock: string, stop: AtomicInt) -> int {
    let cfg = pack_opts(0, "", "", "", "0") + "\n0\n0\n10000\n0\n\n\n\n0\n0\n1\n50000\n" + sock + "\n448"
    return serve("127.0.0.1", port, 4, "", "", 0, 1, stop, 10000, 0, 10000, 0, cfg)
}

fn boot_defttl(port: int, stop: AtomicInt, sec: int) -> int {
    let cfg = pack_opts(0, "", "", "", "0") + "\n0\n" + format_int(sec) + "\n1000\n0"
    return serve("127.0.0.1", port, 4, "", "", 0, 0, stop, 10000, 0, 10000, 0, cfg)
}

fn bulk_str(r: string) -> string {
    if not str_has_prefix(r, "$") {
        return r
    }
    let cr = find_crlf(r, 0)
    if cr < 2 {
        return ""
    }
    let ln = int_of(r[1:cr])
    if ln <= 0 {
        return ""
    }
    let start = cr + 2
    if start + ln > str_len(r) {
        return r[start:]
    }
    return r[start:start + ln]
}

fn parse_moved(r: string) -> (string, int, int) {
    if not str_has_prefix(r, "-MOVED") {
        return ("", 0, 0)
    }
    let n = str_len(r)
    let mut end = n
    if n >= 2 and str_byte_at(r, n - 2) == 13 {
        end = n - 2
    }
    let line = r[1:end]
    let f = str_fields(line)
    if len(f) < 3 {
        return ("", 0, 0)
    }
    let ip, ps = parse_ipport(f[2])
    return (ip, int_of(ps), 1)
}

fn resp_follow(fd0: int, argv: []string) -> string {
    let r = resp_send(fd0, argv)
    let ip, port, ok = parse_moved(r)
    if ok == 0 {
        return r
    }
    let fd = tcp_connect(ip, port)
    if fd < 0 {
        return r
    }
    let _ = tcp_nodelay(fd)
    let r2 = resp_send(fd, argv)
    let _ = tcp_close(fd)
    return r2
}

fn TestLivePingSetGet() {
    let stop = atomic_new(0)
    let port = 19491
    crew t {
        let srv = t.kick(boot(port, "", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        assert_eq_str(resp_send(fd, ["PING"]), "+PONG\r\n")
        assert_eq_str(resp_send(fd, ["SET", "smoke", "ok"]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["GET", "smoke"]), "$2\r\nok\r\n")
        assert_eq_str(resp_send(fd, ["INCR", "smoke_n"]), ":1\r\n")
        assert_eq_str(resp_send(fd, ["INCR", "smoke_n"]), ":2\r\n")
        let _ = resp_send(fd, ["QUIT"])
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveFastGet() {
    let stop = atomic_new(0)
    let port = 19508
    crew t {
        let srv = t.kick(boot(port, "", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        assert_eq_str(resp_send(fd, ["SET", "hot", "1"]), "+OK\r\n")
        let t0 = wall_ms()
        let mut i = 0
        while i < 200 {
            assert_eq_str(resp_send(fd, ["GET", "hot"]), "$1\r\n1\r\n")
            i = i + 1
        }
        let dt = wall_ms() - t0
        assert(dt < 80)
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveTypes() {
    let stop = atomic_new(0)
    let port = 19492
    crew t {
        let srv = t.kick(boot(port, "", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        assert_eq_str(resp_send(fd, ["HSET", "h", "f", "1"]), ":1\r\n")
        let g = resp_send(fd, ["GET", "h"])
        assert(str_has_prefix(g, "-WRONGTYPE"))
        assert_eq_str(resp_send(fd, ["LPUSH", "L", "a", "b"]), ":2\r\n")
        let lr = resp_send(fd, ["LRANGE", "L", "0", "-1"])
        assert(str_contains(lr, "b"))
        assert(str_contains(lr, "a"))
        assert_eq_str(resp_send(fd, ["SADD", "s", "m"]), ":1\r\n")
        assert_eq_str(resp_send(fd, ["SISMEMBER", "s", "m"]), ":1\r\n")
        assert_eq_str(resp_send(fd, ["ZADD", "z", "1", "a"]), ":1\r\n")
        assert_eq_str(resp_send(fd, ["ZSCORE", "z", "a"]), "$1\r\n1\r\n")
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveBrain() {
    let stop = atomic_new(0)
    let port = 19509
    crew t {
        let srv = t.kick(boot(port, "", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        assert_eq_str(resp_send(fd, ["BRAIN", "REMEMBER", "{bot}mem", "m1", "likes espresso"]), "+OK\r\n")
        assert(str_has_prefix(resp_send(fd, ["BRAIN", "SAY", "{bot}sess", "user", "coffee?"]), ":"))
        let rec = resp_send(fd, ["BRAIN", "RECALL", "{bot}mem", "COUNT", "3", "QUERY", "espresso"])
        assert(str_contains(rec, "m1"))
        let pack = resp_send(fd, ["BRAIN", "PACK", "{bot}sess", "{bot}mem", "QUERY", "coffee"])
        assert(str_has_prefix(pack, "$"))
        let help = resp_send(fd, ["BRAIN", "HELP"])
        assert(str_contains(help, "REMEMBER"))
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveBrainHttp() {
    let stop = atomic_new(0)
    let port = 19510
    let hport = 19511
    crew t {
        let srv = t.kick(boot_metrics(port, hport, stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let _ = tcp_close(fd)
        let mut hi = 0
        let mut hfd = -1
        while hi < 40 {
            hfd = tcp_connect("127.0.0.1", hport)
            if hfd >= 0 {
                break
            }
            sleep_ms(50)
            hi = hi + 1
        }
        assert(hfd >= 0)
        let _ = tcp_set_timeout(hfd, 1000)
        let _ = tcp_write_all(hfd, "GET /health HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
        let body = tcp_read(hfd)
        assert(str_contains(body, "\"service\":\"bonodis\""))
        let _ = tcp_close(hfd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveAuth() {
    let stop = atomic_new(0)
    let port = 19493
    crew t {
        let srv = t.kick(boot(port, "s3cret", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let denied = resp_send(fd, ["GET", "k"])
        assert(str_contains(denied, "NOAUTH"))
        let multi = resp_send(fd, ["MULTI"])
        assert(str_contains(multi, "NOAUTH"))
        let hello = resp_send(fd, ["HELLO", "2"])
        assert(str_contains(hello, "NOAUTH"))
        let bad = resp_send(fd, ["AUTH", "nope"])
        assert(str_contains(bad, "WRONGPASS"))
        assert_eq_str(resp_send(fd, ["AUTH", "s3cret"]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["SET", "authed", "yes"]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["GET", "authed"]), "$3\r\nyes\r\n")
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

