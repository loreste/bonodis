        assert_eq_str(resp_send(fd, ["SETBIT", "bm", "7", "1"]), ":0\r\n")
        assert_eq_str(resp_send(fd, ["GETBIT", "bm", "7"]), ":1\r\n")
        assert_eq_str(resp_send(fd, ["BITCOUNT", "bm"]), ":1\r\n")
        assert_eq_str(resp_send(fd, ["GEOADD", "cities", "13.361389", "38.115556", "Palermo"]), ":1\r\n")
        let d = resp_send(fd, ["GEODIST", "cities", "Palermo", "Palermo", "m"])
        assert(str_has_prefix(d, "$"))
        let xid = resp_send(fd, ["XADD", "xs", "*", "f", "v"])
        assert(str_has_prefix(xid, "$"))
        assert_eq_str(resp_send(fd, ["XLEN", "xs"]), ":1\r\n")
        let _ = resp_send(fd, ["LPUSH", "bl", "x"])
        let bl = resp_send(fd, ["BLPOP", "bl", "1"])
        assert(str_contains(bl, "x"))
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveSlowlogMetricsCluster() {
    let stop = atomic_new(0)
    let port = 19504
    let mport = 19505
    crew t {
        let srv = t.kick(boot_metrics(port, mport, stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let _ = resp_send(fd, ["PING"])
        let sl = resp_send(fd, ["SLOWLOG", "LEN"])
        assert(str_has_prefix(sl, ":"))
        let m = resp_send(fd, ["METRICS"])
        assert(str_contains(m, "bonodis_up"))
        assert_eq_str(resp_send(fd, ["CLUSTER", "KEYSLOT", "foo"]), ":12182\r\n")
        let slots = resp_send(fd, ["CLUSTER", "SLOTS"])
        assert(str_contains(slots, "16383"))
        let role = resp_send(fd, ["ROLE"])
        assert(str_contains(role, "master"))
        let ev = resp_send(fd, ["EVAL", "return 1", "0"])
        assert_eq_str(ev, ":1\r\n")
        let sen = resp_send(fd, ["SENTINEL", "MASTERS"])
        assert(str_contains(sen, "mymaster"))
        let inf = bulk_str(resp_send(fd, ["INFO"]))
        assert(str_contains(inf, "persistence_fork:0"))
        assert(str_contains(inf, "sentinel_mode:0"))
        assert(str_contains(inf, "license:MIT"))
        assert(str_contains(inf, "maxmemory_policy:allkeys-lru"))
        let cfg = resp_send(fd, ["CONFIG", "GET", "*"])
        assert(str_contains(cfg, "appendfsync"))
        assert(str_contains(cfg, "everysec"))
        assert(str_contains(cfg, "maxmemory-policy"))
        assert(str_contains(cfg, "allkeys-lru"))
        let _ = resp_send(fd, ["SET", "hk", "1"])
        let hk = resp_send(fd, ["HOTKEYS", "5"])
        assert(str_has_prefix(hk, "*"))
        let _ = tcp_close(fd)
        let mut hi = 0
        let mut hfd = -1
        while hi < 40 {
            hfd = tcp_connect("127.0.0.1", mport)
            if hfd >= 0 {
                break
            }
            sleep_ms(50)
            hi = hi + 1
        }
        assert(hfd >= 0)
        let _ = tcp_set_timeout(hfd, 1000)
        let _ = tcp_write_all(hfd, "GET /metrics HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
        let body = tcp_read(hfd)
        assert(str_contains(body, "bonodis_up"))
        let _ = tcp_close(hfd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveReplica() {
    let stopm = atomic_new(0)
    let stopr = atomic_new(0)
    let mp = 19506
    let rp = 19507
    crew t {
        let sm = t.kick(boot(mp, "", stopm))
        let sr = t.kick(boot(rp, "", stopr))
        let fdm = wait_connect("127.0.0.1", mp, 80)
        let fdr = wait_connect("127.0.0.1", rp, 80)
        assert(fdm >= 0)
        assert(fdr >= 0)
        assert_eq_str(resp_send(fdm, ["SET", "from_master", "hello"]), "+OK\r\n")
        assert_eq_str(resp_send(fdr, ["REPLICAOF", "127.0.0.1", format_int(mp)]), "+OK\r\n")
        let mut n = 0
        let mut got = ""
        while n < 80 {
            sleep_ms(50)
            got = resp_send(fdr, ["GET", "from_master"])
            if str_contains(got, "hello") {
                break
            }
            n = n + 1
        }
        assert(str_contains(got, "hello"))
        assert_eq_str(resp_send(fdm, ["SET", "streamed", "yes"]), "+OK\r\n")
        n = 0
        got = ""
        while n < 80 {
            sleep_ms(50)
            got = resp_send(fdr, ["GET", "streamed"])
            if str_contains(got, "yes") {
                break
            }
            n = n + 1
        }
        assert(str_contains(got, "yes"))
        let mut ro = ""
        n = 0
        while n < 40 {
            ro = resp_send(fdr, ["SET", "on_replica", "no"])
            if str_contains(ro, "READONLY") {
                break
            }
            sleep_ms(50)
            n = n + 1
        }
        assert(str_contains(ro, "READONLY"))
        let _ = tcp_close(fdm)
        let _ = tcp_close(fdr)
        stop_serve(stopm)
        stop_serve(stopr)
        let _ = sm.join()
        let _ = sr.join()
    }
}

fn wait_nodes(fd: int, want: int) -> int {
    let mut n = 0
    while n < 80 {
        let blob = bulk_str(resp_send(fd, ["CLUSTER", "NODES"]))
        let lines = str_split(blob, "\n")
        let mut c = 0
        let mut i = 0
        while i < len(lines) {
            if str_len(lines[i]) > 5 {
                c = c + 1
            }
            i = i + 1
        }
        if c >= want {
            return 1
        }
        sleep_ms(50)
        n = n + 1
    }
    return 0
}

fn TestLiveClusterCreate() {
    let s0 = atomic_new(0)
    let s1 = atomic_new(0)
    let s2 = atomic_new(0)
    let p0 = 19610
    let p1 = 19611
    let p2 = 19612
    crew t {
        let a = t.kick(boot_cluster(p0, s0, "/tmp/bonodis_c19610"))
        let b = t.kick(boot_cluster(p1, s1, "/tmp/bonodis_c19611"))
        let c = t.kick(boot_cluster(p2, s2, "/tmp/bonodis_c19612"))
        let f0 = wait_connect("127.0.0.1", p0, 80)
        let f1 = wait_connect("127.0.0.1", p1, 80)
        let f2 = wait_connect("127.0.0.1", p2, 80)
        assert(f0 >= 0)
        assert(f1 >= 0)
        assert(f2 >= 0)
        assert_eq_str(resp_send(f0, ["CLUSTER", "MEET", "127.0.0.1", format_int(p1)]), "+OK\r\n")
        assert_eq_str(resp_send(f0, ["CLUSTER", "MEET", "127.0.0.1", format_int(p2)]), "+OK\r\n")
        assert_eq(wait_nodes(f0, 3), 1)
        assert_eq(wait_nodes(f1, 3), 1)
        assert_eq(wait_nodes(f2, 3), 1)
        let parts = cluster_split_slots(3)
        assert_eq(len(parts), 3)
        let d0 = str_index(parts[0], "-")
        let d1 = str_index(parts[1], "-")
        let d2 = str_index(parts[2], "-")
        assert_eq_str(resp_send(f0, ["CLUSTER", "ADDSLOTSRANGE", parts[0][:d0], parts[0][d0 + 1:]]), "+OK\r\n")
        assert_eq_str(resp_send(f1, ["CLUSTER", "ADDSLOTSRANGE", parts[1][:d1], parts[1][d1 + 1:]]), "+OK\r\n")
        assert_eq_str(resp_send(f2, ["CLUSTER", "ADDSLOTSRANGE", parts[2][:d2], parts[2][d2 + 1:]]), "+OK\r\n")
        let mut n = 0
        let mut info = ""
        while n < 40 {
            info = bulk_str(resp_send(f0, ["CLUSTER", "INFO"]))
            if str_contains(info, "cluster_state:ok") {
                break
            }
            sleep_ms(50)
            n = n + 1
        }
        assert(str_contains(info, "cluster_state:ok"))
        let setr = resp_follow(f0, ["SET", "foo", "bar"])
        assert_eq_str(setr, "+OK\r\n")
        let getr = resp_follow(f0, ["GET", "foo"])
        assert(str_contains(getr, "bar"))
        let miss = resp_send(f0, ["GET", "foo"])
        if str_has_prefix(miss, "-MOVED") {
            assert(str_contains(miss, "MOVED"))
        }
        let _ = tcp_close(f0)
        let _ = tcp_close(f1)
        let _ = tcp_close(f2)
        stop_serve(s0)
        stop_serve(s1)
        stop_serve(s2)
        let _ = a.join()
        let _ = b.join()
        let _ = c.join()
    }
}

fn TestLiveReplicaOfFlag() {
    let stopm = atomic_new(0)
