fn TestLiveUnreadCloseSurvives() {
    let stop = atomic_new(0)
    let port = 19496
    crew t {
        let srv = t.kick(boot(port, "", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let mut i = 0
        while i < 40 {
            let _ = tcp_write_all(fd, encode_array(["PING"]))
            i = i + 1
        }
        let _ = tcp_close(fd)
        sleep_ms(200)
        let fd2 = wait_connect("127.0.0.1", port, 40)
        assert(fd2 >= 0)
        assert_eq_str(resp_send(fd2, ["PING"]), "+PONG\r\n")
        let _ = tcp_close(fd2)
        stop_serve(stop)
        let _ = srv.join()
    }
}

