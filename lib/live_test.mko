            sleep_ms(50)
            i = i + 1
        }
        assert(fd >= 0)
        assert_eq_str(resp_send(fd, ["PING"]), "+PONG\r\n")
        assert_eq_str(resp_send(fd, ["SET", "uk", "1"]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["GET", "uk"]), "$1\r\n1\r\n")
