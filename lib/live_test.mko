fn TestLiveTlsPing() {
    let stop = atomic_new(0)
    let port = 19531
    let cert = "/tmp/bonodis_tls.crt"
    let key = "/tmp/bonodis_tls.key"
    let rc = tls_make_self_signed(cert, key, "localhost", 1)
    if rc != 0 {
        return
    }
    crew t {
        let srv = t.kick(boot_tls(port, stop, cert, key))
        let mut i = 0
        let mut fd = -1
        while i < 80 {
            fd = tcp_connect("127.0.0.1", port)
            if fd >= 0 {
                break
            }
            sleep_ms(50)
            i = i + 1
        }
        assert(fd >= 0)
        let _ = tcp_nodelay(fd)
        let cli = tls_client_new_insecure()
        let tc = tls_connect(cli, fd, "localhost")
        assert(tls_conn_fd(tc) >= 0)
        let n = tls_write(tc, encode_array(["PING"]))
        assert(n > 0)
        let r = tls_read(tc, 65536)
        assert(str_contains(r, "PONG"))
        let _ = tls_conn_close(tc)
        let _ = tls_client_free(cli)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveDumpClientNotify() {
    let stop = atomic_new(0)
    let port = 19533
    crew t {
        let srv = t.kick(boot(port, "", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        assert_eq_str(resp_send(fd, ["SET", "{t}k", "v"]), "+OK\r\n")
        let d = resp_send(fd, ["DUMP", "{t}k"])
        assert(str_has_prefix(d, "$"))
        assert_eq_str(resp_send(fd, ["DEL", "{t}k"]), ":1\r\n")
        let payload = bulk_str(d)
        assert_eq_str(resp_send(fd, ["RESTORE", "{t}k", "0", payload]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["GET", "{t}k"]), "$1\r\nv\r\n")
        let cl = resp_send(fd, ["CLIENT", "LIST"])
        assert(str_contains(cl, "id="))
        assert_eq_str(resp_send(fd, ["CONFIG", "SET", "notify-keyspace-events", "KEA"]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["CONFIG", "REWRITE"]), "+OK\r\n")
        let _ = resp_send(fd, ["HSETNX", "{t}h", "f", "1"])
        assert_eq_str(resp_send(fd, ["HSETNX", "{t}h", "f", "2"]), ":0\r\n")
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveMonitorXgroupBitfield() {
    let stop = atomic_new(0)
    let port = 19534
    crew t {
        let srv = t.kick(boot(port, "", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        let xid = resp_send(fd, ["XADD", "xs", "1-0", "f", "v1"])
        assert(str_has_prefix(xid, "$"))
        let gok = resp_send(fd, ["XGROUP", "CREATE", "xs", "g", "0-0"])
        assert_eq_str(gok, "+OK\r\n")
        let xr = resp_send(fd, ["XREADGROUP", "GROUP", "g", "c", "STREAMS", "xs", ">"])
        assert(str_contains(xr, "v1"))
        let cl = resp_send(fd, ["XCLAIM", "xs", "g", "c2", "0", "1-0"])
        assert(str_contains(cl, "v1"))
        let xp = resp_send(fd, ["XPENDING", "xs", "g"])
        assert(str_has_prefix(xp, "*"))
        assert_eq_str(resp_send(fd, ["XACK", "xs", "g", "1-0"]), ":1\r\n")
        let set = resp_send(fd, ["BITFIELD", "bf", "SET", "u8", "0", "5"])
        assert(str_contains(set, ":0"))
        let get = resp_send(fd, ["BITFIELD", "bf", "GET", "u8", "0"])
        assert(str_contains(get, ":5"))
        let _ = resp_send(fd, ["HSET", "h", "f", "v"])
        assert_eq_str(resp_send(fd, ["HGETDEL", "h", "f"]), "$1\r\nv\r\n")
        let _ = resp_send(fd, ["RPUSH", "l", "a"])
        let lp = resp_send(fd, ["LMPOP", "1", "l", "LEFT"])
        assert(str_contains(lp, "a"))
        let fdmon = wait_connect("127.0.0.1", port, 80)
        assert(fdmon >= 0)
        let mok = resp_send(fdmon, ["MONITOR"])
        assert_eq_str(mok, "+OK\r\n")
        let _ = tcp_set_timeout(fdmon, 400)
        assert_eq_str(resp_send(fd, ["SET", "mk", "1"]), "+OK\r\n")
        sleep_ms(250)
        let mut mon = ""
        let mut i = 0
        while i < 8 {
            mon = mon + tcp_read(fdmon)
            if str_contains(mon, "SET") {
                break
            }
            sleep_ms(50)
            i = i + 1
        }
        assert(str_contains(mon, "SET"))
        let _ = tcp_close(fd)
        let _ = tcp_close(fdmon)
        stop_serve(stop)
        let _ = srv.join()
    }
}

