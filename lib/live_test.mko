        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveSaveDump() {
    let stop = atomic_new(0)
    let port = 19520
    let dir = "/tmp/bonodis_save_test"
    let _ = mkdir_all(dir)
    crew t {
        let srv = t.kick(boot_persist(port, stop, dir))
        let fd = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        assert_eq_str(resp_send(fd, ["SET", "snap", "hello"]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["SAVE"]), "+OK\r\n")
        assert(file_exists(dir + "/dump.bonodis"))
        let blob = read_file(dir + "/dump.bonodis")
        assert(str_has_prefix(blob, "BONODIS-DUMP 1"))
        assert(str_contains(blob, "snap"))
        assert(str_contains(blob, "hello"))
        assert(str_has_prefix(resp_send(fd, ["LASTSAVE"]), ":"))
        let inf = bulk_str(resp_send(fd, ["INFO"]))
        assert(str_contains(inf, "failover_quorum:majority"))
        assert_eq_str(resp_send(fd, ["BGREWRITEAOF"]), "+OK\r\n")
        sleep_ms(50)
        assert_eq_str(resp_send(fd, ["GET", "snap"]), "$5\r\nhello\r\n")
        let _ = tcp_close(fd)
        stop_serve(stop)
        let _ = srv.join()
    }
}

