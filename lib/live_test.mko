        let _ = sm.join()
        let _ = sr.join()
    }
}

fn TestLivePubsubAndNewCmds() {
    let stop = atomic_new(0)
    let port = 19513
    crew t {
        let srv = t.kick(boot(port, "", stop))
        let fd = wait_connect("127.0.0.1", port, 80)
        let sub = wait_connect("127.0.0.1", port, 80)
        assert(fd >= 0)
        assert(sub >= 0)
        let _ = tcp_set_timeout(sub, 1000)
        let sr = resp_send(sub, ["SUBSCRIBE", "news"])
        assert(str_contains(sr, "subscribe"))
        let pub = resp_send(fd, ["PUBLISH", "news", "hi"])
        assert(str_has_prefix(pub, ":"))
        assert(not str_eq(pub, ":0\r\n"))
        assert_eq_str(resp_send(fd, ["SET", "g", "1"]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["GETDEL", "g"]), "$1\r\n1\r\n")
        let _ = resp_send(fd, ["SADD", "su", "a", "b"])
        let _ = resp_send(fd, ["SADD", "sv", "b", "c"])
        let un = resp_send(fd, ["SUNION", "su", "sv"])
        assert(str_contains(un, "a"))
        assert(str_contains(un, "c"))
        let _ = resp_send(fd, ["ZADD", "zz", "1", "m"])
        assert(str_contains(resp_send(fd, ["ZRANGEBYSCORE", "zz", "0", "2"]), "m"))
        let _ = resp_send(fd, ["PFADD", "pf", "x", "y"])
        let pc = resp_send(fd, ["PFCOUNT", "pf"])
        assert(str_has_prefix(pc, ":"))
        let fd2 = wait_connect("127.0.0.1", port, 40)
        assert(fd2 >= 0)
        assert_eq_str(resp_send(fd, ["SET", "wk", "1"]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["WATCH", "wk"]), "+OK\r\n")
        assert_eq_str(resp_send(fd2, ["SET", "wk", "2"]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["MULTI"]), "+OK\r\n")
        assert_eq_str(resp_send(fd, ["SET", "wk", "3"]), "+QUEUED\r\n")
        let ex = resp_send(fd, ["EXEC"])
        assert(str_eq(ex, "*-1\r\n") or str_has_prefix(ex, "*-1"))
        let _ = tcp_close(fd2)
        assert_eq_str(resp_send(fd, ["CLIENT", "SETNAME", "c1"]), "+OK\r\n")
        assert(str_contains(resp_send(fd, ["CLIENT", "GETNAME"]), "c1"))
        let sen = resp_send(fd, ["SENTINEL", "GET-MASTER-ADDR-BY-NAME", "mymaster"])
        assert(str_has_prefix(sen, "*2\r\n"))
        assert(str_contains(sen, "127.0.0.1"))
        let masters = resp_send(fd, ["SENTINEL", "MASTERS"])
        assert(str_contains(masters, "mymaster"))
        assert(str_has_prefix(resp_send(fd, ["LASTSAVE"]), ":"))
        assert_eq_str(resp_send(fd, ["READONLY"]), "+OK\r\n")
        let _ = tcp_close(fd)
        let _ = tcp_close(sub)
        stop_serve(stop)
        let _ = srv.join()
    }
}

fn TestLiveDefaultTtl() {
    let stop = atomic_new(0)
    let port = 19512
    crew t {
