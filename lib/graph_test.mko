fn TestGraphFactsLeaseWhyOnly() {
    let mut st = new_store()
    assert_eq_str(st.apply(0, ["RELATE", "{g}a", "{g}b", "knows"]), "+OK\r\n")
    assert_eq_str(st.apply(0, ["RELATE", "{g}b", "{g}c", "knows"]), "+OK\r\n")
    let nb = st.apply(0, ["NEIGHBORS", "{g}a"])
    assert(str_contains(nb, "{g}b"))
    assert(str_contains(nb, "knows"))
    let p = st.apply(0, ["PATH", "{g}a", "{g}c"])
    assert(str_contains(p, "{g}a"))
    assert(str_contains(p, "{g}c"))
    assert_eq_str(st.apply(0, ["FACT", "ADD", "{g}a", "likes", "tea"]), "+OK\r\n")
    let fo = st.apply(0, ["FACT", "OF", "{g}a"])
    assert(str_contains(fo, "likes"))
    assert(str_contains(fo, "tea"))
    let who = st.apply(0, ["FACT", "WHO", "likes", "tea"])
    assert(str_contains(who, "{g}a"))
    let _ = st.apply(0, ["SET", "{g}a", "1"])
    let w = st.apply(0, ["WHY", "{g}a"])
    assert(str_contains(w, "string"))
    assert(str_contains(w, "SET"))
    let tok = st.apply(0, ["LEASE", "{g}lock", "30"])
    assert(str_has_prefix(tok, "$"))
    assert_eq_str(st.apply(0, ["LEASE", "{g}lock", "30"]), "$-1\r\n")
    let payload = bulk_payload(tok)
    assert_eq_str(st.apply(0, ["UNLEASE", "{g}lock", payload]), ":1\r\n")
    let pack = st.apply(0, ["BRAIN", "PACK", "{g}a", "{g}mem"])
    assert(str_contains(pack, "related"))
    assert(str_contains(pack, "likes"))
    assert(str_contains(pack, "knows"))
}

fn TestBelieveAskAttendBudgetCompact() {
    let mut st = new_store()
    assert_eq_str(st.apply(0, ["BELIEVE", "{m}s", "likes", "tea", "80"]), ":80\r\n")
    assert_eq_str(st.apply(0, ["BELIEVE", "{m}s", "likes", "coffee", "40"]), ":40\r\n")
    let ten = st.apply(0, ["TENSIONS", "{m}s"])
    assert(str_contains(ten, "likes"))
    assert(str_contains(ten, "tea"))
    assert(str_contains(ten, "coffee"))
    let who = st.apply(0, ["ASK", "{m}s", "WHO", "likes"])
    assert(str_contains(who, "tea"))
    let q = st.apply(0, ["ASK", "{m}s", "QUERY", "tea"])
    assert(str_contains(q, "tea"))
    assert_eq_str(st.apply(0, ["RELATE", "{m}s", "{m}t", "about"]), "+OK\r\n")
    let hops = st.apply(0, ["ASK", "{m}s", "HOPS", "1"])
    assert(str_contains(hops, "{m}t"))
    assert_eq_str(st.apply(0, ["ATTEND", "{m}s", "{m}t"]), "+OK\r\n")
    let foc = st.apply(0, ["FOCUS", "{m}s", "COUNT", "8"])
    assert(str_contains(foc, "{m}t"))
    let foc2 = st.apply(0, ["FOCUS", "{m}other"])
    assert(not str_contains(foc2, "{m}t"))
    assert_eq_str(st.apply(0, ["BUDGET", "{m}s", "10"]), ":10\r\n")
    assert_eq_str(st.apply(0, ["SPEND", "{m}s", "3"]), ":7\r\n")
    let dead = st.apply(0, ["SPEND", "{m}s", "9"])
    assert(str_contains(dead, "exhausted"))
    assert_eq_str(st.apply(0, ["BRAIN", "REMEMBER", "{m}mem", "a", "user likes strong tea"]), "+OK\r\n")
    assert_eq_str(st.apply(0, ["BRAIN", "REMEMBER", "{m}mem", "b", "user likes tea drinks"]), "+OK\r\n")
    let c = st.apply(0, ["BRAIN", "COMPACT", "{m}mem"])
    assert(str_has_prefix(c, ":"))
}

fn TestTurn() {
    let mut st = new_store()
    let _ = st.apply(0, ["BUDGET", "{demo}sess", "100"])
    let _ = st.apply(0, ["BELIEVE", "{demo}sess", "likes", "tea", "80"])
    let _ = st.apply(0, ["BELIEVE", "{demo}sess", "likes", "coffee", "20"])
    let _ = st.apply(0, ["BRAIN", "REMEMBER", "{demo}mem", "p1", "user prefers dark mode"])
    let t = st.apply(0, ["TURN", "{demo}sess", "{demo}mem", "QUERY", "dark"])
    assert(str_has_prefix(t, "$"))
    assert(str_contains(t, "session:"))
    assert(str_contains(t, "budget:"))
    assert(str_contains(t, "likes:"))
    assert(str_contains(t, "memories"))
    let bt = st.apply(0, ["BRAIN", "TURN", "{demo}sess", "{demo}mem"])
    assert(str_contains(bt, "session:"))
}
