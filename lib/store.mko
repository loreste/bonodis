    let _ = Store_cmd_eval(st, 0, a)
    let _ = Store_cmd_relate(st, 0, a, 1)
    let _ = Store_cmd_relate(st, 0, a, 0)
    let _ = Store_cmd_neighbors(st, 0, a)
    let _ = Store_cmd_path(st, 0, a)
    let _ = Store_cmd_fact(st, 0, a)
    let _ = Store_cmd_why(st, 0, a)
    let _ = Store_cmd_lease(st, 0, a)
    let _ = Store_cmd_unlease(st, 0, a)
    let _ = Store_cmd_leased(st, 0, a)
    Store_scrub_graph(st, "k")
    let _ = Store_lease_live(st, "k")
    let _ = Store_cmd_believe(st, 0, a)
    let _ = Store_cmd_tensions(st, 0, a)
    let _ = Store_cmd_ask(st, 0, a)
    let _ = Store_cmd_attend(st, 0, a)
    let _ = Store_cmd_focus(st, 0, a)
    let _ = Store_cmd_budget(st, 0, a)
    let _ = Store_cmd_spend(st, 0, a)
    let _ = Store_cmd_brain_compact(st, 0, "k")
    let _ = Store_belief_score(st, "k", "p", "o")
    let _ = Store_cmd_turn(st, 0, a)
    let _ = Store_cmd_react(st, 0, a)
    Store_react_fire(st, 0, "k", "v")
    let none: []float = []
    let _, _ = Store_vsim_rank(st, "k", none, "", 1)
    return 0
}
