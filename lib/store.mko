    if str_eq(cmd, "TS.INFO") {
        return self.cmd_tsinfo(db, argv)
    }
    if str_has_prefix(cmd, "CF.") {
        return self.cmd_cf(db, argv)
    }
    if str_has_prefix(cmd, "CMS.") {
        return self.cmd_cms(db, argv)
    }
