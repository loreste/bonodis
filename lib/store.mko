    }
    return r_int(self.list_len(ik))
}

fn Store_cmd_lindex(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("lindex")
    }
    let idx, ok = int_ok(argv[2])
    if ok == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nil()
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    let xs = self.lists[ik]
    let hk = lk_head(ik)
    let mut h = 0
    if len(self.xseq) > 0 and has(self.xseq, hk) {
        h = self.xseq[hk]
    }
    let v, hit = slice_at(xs[h:], idx)
    if hit == 0 {
        return r_nil()
    }
    return r_bulk(v)
}

fn Store_cmd_lset(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("lset")
    }
    let idx, ok = int_ok(argv[2])
    if ok == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nokey()
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    let mut xs = self.lists[ik]
    let hk = lk_head(ik)
    let mut h = 0
    if len(self.xseq) > 0 and has(self.xseq, hk) {
        h = self.xseq[hk]
    }
    let n = len(xs) - h
    let mut i = idx
    if i < 0 {
        i = n + i
    }
    if i < 0 or i >= n {
        return r_err("ERR index out of range")
    }
    xs[h + i] = argv[3]
    self.lists[ik] = xs
    return r_ok()
}

fn Store_cmd_ltrim(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("ltrim")
    }
    let a, ao = int_ok(argv[2])
    let b, bo = int_ok(argv[3])
    if ao == 0 or bo == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_ok()
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    let cur = self.list_norm(ik)
    let xs = slice_trim(cur, a, b)
    if len(xs) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.lists[ik] = xs
    }
    return r_ok()
}

fn Store_ensure_set(mut self: Store, ik: string) -> int {
    let t = self.kind(ik)
    if t == T_NONE {
        self.sets[ik] = make(map[string]int)
        self.types[ik] = T_SET
        return 1
    }
    if t != T_SET {
        return 0
    }
    return 1
}

fn Store_cmd_sadd(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("sadd")
    }
    let ik = ikey(db, argv[1])
    if self.ensure_set(ik) == 0 {
        return r_wrongtype()
    }
    let mut s = self.sets[ik]
    let mut n = 0
    let mut i = 2
    while i < len(argv) {
        if not has(s, argv[i]) {
            s[argv[i]] = 1
            n = n + 1
        }
        i = i + 1
    }
    self.sets[ik] = s
    return r_int(n)
}

fn Store_cmd_srem(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
