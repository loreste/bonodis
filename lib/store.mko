    if len(argv) != 2 {
        return r_arity("llen")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    return r_int(len(self.lists[ik]))
}

fn Store_cmd_lindex(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("lindex")
    }
    let idx, ok = int_ok(argv[2])
    if ok == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nil()
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    let v, hit = slice_at(self.lists[ik], idx)
    if hit == 0 {
        return r_nil()
    }
    return r_bulk(v)
}

fn Store_cmd_lset(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("lset")
    }
    let idx, ok = int_ok(argv[2])
    if ok == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nokey()
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    let mut xs = self.lists[ik]
    let n = len(xs)
    let mut i = idx
    if i < 0 {
        i = n + i
    }
    if i < 0 or i >= n {
        return r_err("ERR index out of range")
    }
    xs[i] = argv[3]
    self.lists[ik] = xs
    return r_ok()
}

fn Store_cmd_ltrim(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("ltrim")
    }
    let a, ao = int_ok(argv[2])
    let b, bo = int_ok(argv[3])
    if ao == 0 or bo == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_ok()
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    let xs = slice_trim(self.lists[ik], a, b)
    if len(xs) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.lists[ik] = xs
    }
    return r_ok()
}

fn Store_ensure_set(mut self: Store, ik: string) -> int {
    let t = self.kind(ik)
    if t == T_NONE {
        self.sets[ik] = make(map[string]int)
        self.types[ik] = T_SET
        return 1
    }
    if t != T_SET {
        return 0
    }
    return 1
}

fn Store_cmd_sadd(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
