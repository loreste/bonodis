    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_SET {
        return r_wrongtype()
    }
    return r_int(len(self.sets[ik]))
}

fn Store_cmd_spop(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 or len(argv) > 3 {
        return r_arity("spop")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        if len(argv) == 3 {
            let none: []string = []
            return r_array_bulks(none)
        }
        return r_nil()
    }
    if t != T_SET {
        return r_wrongtype()
    }
    let mut s = self.sets[ik]
    let mut mems = set_members(s)
    if len(mems) == 0 {
        return r_nil()
    }
    if len(argv) == 2 {
        let i = rand_intn(len(mems))
        let m = mems[i]
        delete(s, m)
        if len(s) == 0 {
            let _ = self.drop_key(ik)
        } else {
            self.sets[ik] = s
        }
        return r_bulk(m)
    }
    let mut n, ok = int_ok(argv[2])
    if ok == 0 {
        return r_notint()
    }
    if n > len(mems) {
        n = len(mems)
    }
    let mut out = make([]string, 0, n)
    let mut i = 0
    while i < n {
        let j = rand_intn(len(mems) - i)
        let m = mems[j]
        out = append(out, m)
        delete(s, m)
        mems[j] = mems[len(mems) - 1 - i]
        i = i + 1
    }
    if len(s) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.sets[ik] = s
    }
    return r_array_bulks(out)
}

fn Store_cmd_srandmember(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 or len(argv) > 3 {
        return r_arity("srandmember")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        if len(argv) == 3 {
            let none: []string = []
            return r_array_bulks(none)
        }
        return r_nil()
    }
    if t != T_SET {
        return r_wrongtype()
    }
    let mems = set_members(self.sets[ik])
    if len(mems) == 0 {
        return r_nil()
    }
    if len(argv) == 2 {
        return r_bulk(mems[rand_intn(len(mems))])
    }
    let mut n, ok = int_ok(argv[2])
    if ok == 0 {
        return r_notint()
    }
    if n < 0 {
        n = 0 - n
        if n > 10000 {
            n = 10000
        }
        let mut out = make([]string, 0, n)
        let mut i = 0
        while i < n {
            out = append(out, mems[rand_intn(len(mems))])
            i = i + 1
        }
        return r_array_bulks(out)
    }
    if n > len(mems) {
        n = len(mems)
    }
    return r_array_bulks(slice_skip_take(mems, 0, n))
}

fn Store_ensure_zset(mut self: Store, ik: string) -> int {
    let t = self.kind(ik)
    if t == T_NONE {
        self.zsets[ik] = make(map[string]string)
        self.types[ik] = T_ZSET
        return 1
    }
    if t != T_ZSET {
        return 0
    }
    return 1
}

fn Store_cmd_zadd(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 or (len(argv) % 2) == 1 {
        return r_arity("zadd")
    }
    let ik = ikey(db, argv[1])
    if self.ensure_zset(ik) == 0 {
        return r_wrongtype()
    }
    let mut z = self.zsets[ik]
    let mut added = 0
    let mut i = 2
    while i + 1 < len(argv) {
        if finite_score(argv[i]) == 0 {
            return r_err("ERR value is not a valid float")
        }
        let _ = parse_float(argv[i])
        if not has(z, argv[i + 1]) {
            added = added + 1
        }
        z[argv[i + 1]] = argv[i]
        i = i + 2
    }
    self.zsets[ik] = z
    return r_int(added)
}

fn Store_cmd_zrem(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("zrem")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let mut z = self.zsets[ik]
    let mut n = 0
    let mut i = 2
    while i < len(argv) {
        if has(z, argv[i]) {
            delete(z, argv[i])
            n = n + 1
        }
        i = i + 1
    }
    if len(z) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.zsets[ik] = z
    }
    return r_int(n)
}

fn Store_cmd_zscore(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("zscore")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nil()
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let z = self.zsets[ik]
    if not has(z, argv[2]) {
        return r_nil()
    }
    return r_bulk(z[argv[2]])
}

fn Store_cmd_zcard(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("zcard")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    return r_int(len(self.zsets[ik]))
}

fn Store_cmd_zrange(mut self: Store, db: int, argv: []string, rev: int) -> string {
    if len(argv) < 4 {
        return r_arity("zrange")
    }
    let a, ao = int_ok(argv[2])
    let b, bo = int_ok(argv[3])
    if ao == 0 or bo == 0 {
        return r_notint()
    }
    let mut withscores = 0
    if len(argv) >= 5 and str_eq(str_to_upper(argv[4]), "WITHSCORES") {
        withscores = 1
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        let none: []string = []
        return r_array_bulks(none)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let mems, scs = z_sorted(self.zsets[ik])
    let n = len(mems)
    let mut start = a
    let mut stop = b
    if start < 0 {
        start = n + start
    }
    if stop < 0 {
        stop = n + stop
    }
    if start < 0 {
        start = 0
    }
    if stop >= n {
        stop = n - 1
    }
    let none: []string = []
    if n == 0 or start > stop or start >= n {
        return r_array_bulks(none)
    }
    let mut items = make([]string, 0, (stop - start + 1) * 2)
    if rev == 1 {
        let mut i = n - 1 - start
        let end = n - 1 - stop
        while i >= end and i >= 0 {
            items = append(items, mems[i])
            if withscores == 1 {
                items = append(items, scs[i])
            }
            i = i - 1
        }
    } else {
        let mut i = start
        while i <= stop {
            items = append(items, mems[i])
            if withscores == 1 {
                items = append(items, scs[i])
            }
            i = i + 1
        }
    }
    return r_array_bulks(items)
}

fn Store_cmd_zrank(mut self: Store, db: int, argv: []string, rev: int) -> string {
    if len(argv) != 3 {
        return r_arity("zrank")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nil()
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let z = self.zsets[ik]
    if not has(z, argv[2]) {
        return r_nil()
    }
    let mems, _ = z_sorted(z)
    let mut i = 0
    while i < len(mems) {
        if str_eq(mems[i], argv[2]) {
            if rev == 1 {
                return r_int(len(mems) - 1 - i)
            }
            return r_int(i)
        }
        i = i + 1
    }
    return r_nil()
}

fn Store_cmd_zincrby(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("zincrby")
    }
    let ik = ikey(db, argv[1])
    if self.ensure_zset(ik) == 0 {
        return r_wrongtype()
    }
    let mut z = self.zsets[ik]
    let mut cur = 0.0
    if has(z, argv[3]) {
        cur = parse_float(z[argv[3]])
    }
    let n = cur + parse_float(argv[2])
    let s = format_float(n, 17)
    z[argv[3]] = s
    self.zsets[ik] = z
    return r_bulk(s)
}

fn Store_cmd_dumpkv(mut self: Store, db: int) -> string {
    let keys = self.collect_keys(db, "*")
    return r_array_bulks(keys)
}

fn Store_cmd_export(mut self: Store, db: int) -> string {
    let keys = self.collect_keys(db, "*")
    let b = str_builder()
    let mut i = 0
    while i < len(keys) {
        let k = keys[i]
        let ik = ikey(db, k)
        let t = self.kind(ik)
        if t == T_STR {
            let mut a = make([]string, 0, 5)
            a = append(a, "SET")
            a = append(a, k)
            a = append(a, self.strs[ik])
            if has(self.expire, ik) {
                a = append(a, "PXAT")
                a = append(a, format_int(self.expire[ik]))
            }
            builder_write(b, encode_array(a))
        } else if t == T_HASH {
            let h = self.hashes[ik]
            let mut a = make([]string, 0, 8)
            a = append(a, "HSET")
            a = append(a, k)
            for f, v in range h {
                a = append(a, f)
                a = append(a, v)
            }
            if len(a) > 2 {
                builder_write(b, encode_array(a))
            }
        } else if t == T_LIST {
            let xs = self.lists[ik]
            if len(xs) > 0 {
                let mut a = make([]string, 0, len(xs) + 2)
                a = append(a, "RPUSH")
                a = append(a, k)
                let mut j = 0
                while j < len(xs) {
                    a = append(a, xs[j])
                    j = j + 1
                }
                builder_write(b, encode_array(a))
            }
        } else if t == T_SET {
            let s = self.sets[ik]
            let mut a = make([]string, 0, 8)
            a = append(a, "SADD")
            a = append(a, k)
            for m, _ in range s {
                a = append(a, m)
            }
            if len(a) > 2 {
                builder_write(b, encode_array(a))
            }
        } else if t == T_ZSET {
            let z = self.zsets[ik]
            let mut a = make([]string, 0, 8)
            a = append(a, "ZADD")
            a = append(a, k)
            for m, sc in range z {
                a = append(a, sc)
                a = append(a, m)
            }
            if len(a) > 2 {
                builder_write(b, encode_array(a))
            }
        } else if t == T_STREAM {
            let xs = self.streams[ik]
            let mut j = 0
            while j < len(xs) {
                let parts = str_split(xs[j], "\u001f")
                let mut a = make([]string, 0, 6)
                a = append(a, "XADD")
                a = append(a, k)
                if len(parts) > 0 {
                    a = append(a, parts[0])
                } else {
                    a = append(a, "*")
                }
                let mut p = 1
                while p < len(parts) {
                    a = append(a, parts[p])
                    p = p + 1
                }
                builder_write(b, encode_array(a))
                j = j + 1
            }
        } else if t == T_VEC {
            let v = self.vecs[ik]
            for elem, packed in range v {
                let mut a = make([]string, 0, 8)
                a = append(a, "VADD")
                a = append(a, k)
                a = append(a, elem)
                let parts = str_split(packed, ",")
                let mut p = 0
                while p < len(parts) {
                    if str_len(parts[p]) > 0 {
                        a = append(a, parts[p])
                    }
                    p = p + 1
                }
                if len(a) > 3 {
                    builder_write(b, encode_array(a))
                }
                if has(self.vtxt[ik], elem) {
                    let mut ta = make([]string, 0, 4)
                    ta = append(ta, "VATTR")
                    ta = append(ta, k)
                    ta = append(ta, elem)
                    ta = append(ta, self.vtxt[ik][elem])
                    builder_write(b, encode_array(ta))
                }
            }
        }
        i = i + 1
    }
    return r_bulk(builder_string(b))
}

fn parse_job(msg: string) -> (string, int, []string, int) {
    let empty: []string = []
    let n = str_len(msg)
    if n == 0 {
        return ("", 0, empty, 0)
    }
    let nl = find_nl(msg, 0)
    if nl < 0 {
        return ("", 0, empty, 0)
    }
    let id = msg[:nl]
    let nl2 = find_nl(msg, nl + 1)
    if nl2 < 0 {
        return (id, 0, empty, 0)
    }
    let db = int_of(msg[nl + 1:nl2])
    let nl3 = find_nl(msg, nl2 + 1)
    if nl3 < 0 {
        return (id, db, empty, 0)
    }
    let argc = int_of(msg[nl2 + 1:nl3])
    let mut pos = nl3 + 1
    let mut argv = make([]string, 0, argc)
    let mut i = 0
    while i < argc {
        let nln = find_nl(msg, pos)
        if nln < 0 {
            return (id, db, empty, 0)
        }
        let ln = int_of(msg[pos:nln])
        pos = nln + 1
        if pos + ln > n {
            return (id, db, empty, 0)
        }
        argv = append(argv, msg[pos:pos + ln])
        pos = pos + ln
        i = i + 1
    }
    return (id, db, argv, 1)
}

fn encode_job(id: string, db: int, argv: []string) -> string {
    let b = str_builder()
    builder_write(b, id)
    builder_write(b, "\n")
    builder_write(b, format_int(db))
    builder_write(b, "\n")
    builder_write(b, format_int(len(argv)))
    builder_write(b, "\n")
    let mut i = 0
    while i < len(argv) {
        builder_write(b, format_int(str_len(argv[i])))
        builder_write(b, "\n")
        builder_write(b, argv[i])
        i = i + 1
    }
    return builder_string(b)
}

fn shard_loop(rx: chan[string], replies: CMap, maxmem: int, defttl: int) -> int {
    let mut st = new_store()
    st.maxmem = maxmem
    st.defttl = defttl
    while true {
        let msg = rx.recv()
        if str_eq(msg, "STOP") {
            break
        }
        let id, db, argv, ok = parse_job(msg)
        if ok == 0 {
            if str_len(id) > 0 {
                cmap_set(replies, id, r_err("ERR bad job"))
            }
            continue
        }
        let out = st.apply(db, argv)
        cmap_set(replies, id, out)
        // fire REACT triggers after write
        let cmd = cmd_name(argv)
        if is_write_cmd(cmd) == 1 and str_len(out) > 0 and str_byte_at(out, 0) != 45 and len(argv) >= 2 {
            let mut rval = ""
            if len(argv) >= 3 {
                rval = argv[2]
            }
            let react_cmds = st.react_collect(db, argv[1], rval)
            if len(react_cmds) > 0 {
                st.xp["\u001eReactFiring\u001e"] = "1"
                let mut prev_result = ""
                let mut ri = 0
                while ri < len(react_cmds) {
                    let mut rargv = react_decode_argv(react_cmds[ri])
                    // substitute $RESULT from previous command
                    if str_len(prev_result) > 0 {
                        let payload = react_result_payload(prev_result)
                        let mut si = 0
                        while si < len(rargv) {
                            if str_contains(rargv[si], "$RESULT") {
                                rargv[si] = react_replace(rargv[si], "$RESULT", payload)
                            }
                            si = si + 1
                        }
                    }
                    if len(rargv) > 0 {
                        prev_result = st.dispatch_cmd(db, rargv)
                    }
                    ri = ri + 1
                }
                st.xp["\u001eReactFiring\u001e"] = ""
            }
        }
    }
    return 0
}

// Keep Store_* symbols in the native signature table so method calls lower.
