    }
    if t != T_HASH {
        return r_wrongtype()
    }
    if has(self.hashes[ik], argv[2]) {
        return r_int(1)
    }
    return r_int(0)
}

fn Store_cmd_hkeys(mut self: Store, db: int, argv: []string, vals: int) -> string {
    if len(argv) != 2 {
        return r_arity("hkeys")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        let none: []string = []
        return r_array_bulks(none)
    }
    if t != T_HASH {
        return r_wrongtype()
    }
    let h = self.hashes[ik]
    let mut items = make([]string, 0, len(h))
    for f, v in range h {
        if vals == 1 {
            items = append(items, v)
        } else {
            items = append(items, f)
        }
    }
    return r_array_bulks(items)
}

fn Store_cmd_hlen(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("hlen")
