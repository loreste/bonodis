pack bonodis

const T_NONE = 0
const T_STR = 1
const T_HASH = 2
const T_LIST = 3
const T_SET = 4
const T_ZSET = 5
const T_STREAM = 6
const T_VEC = 7

struct Store {
    strs: map[string]string
    types: map[string]int
    expire: map[string]int
    hashes: map[string]map[string]string
    lists: map[string][]string
    sets: map[string]map[string]int
    zsets: map[string]map[string]string
    streams: map[string][]string
    xseq: map[string]int
    xg: map[string]string
    xp: map[string]string
    vecs: map[string]map[string]string
    vtxt: map[string]map[string]string
    vdim: map[string]int
    atime: map[string]int
    vers: map[string]int
    ops: int
    used: int
    maxmem: int
    defttl: int
    gen: int
}

fn new_store() -> Store {
    return Store {
        strs: make(map[string]string),
        types: make(map[string]int),
        expire: make(map[string]int),
        hashes: make(map[string]map[string]string),
        lists: make(map[string][]string),
        sets: make(map[string]map[string]int),
        zsets: make(map[string]map[string]string),
        streams: make(map[string][]string),
        xseq: make(map[string]int),
        xg: make(map[string]string),
        xp: make(map[string]string),
        vecs: make(map[string]map[string]string),
        vtxt: make(map[string]map[string]string),
        vdim: make(map[string]int),
        atime: make(map[string]int),
        vers: make(map[string]int),
        ops: 0,
        used: 0,
        maxmem: 0,
        defttl: 0,
        gen: 0,
    }
}

fn str_lt(a: string, b: string) -> int {
    let n = min(str_len(a), str_len(b))
    let mut i = 0
    while i < n {
        let da = str_byte_at(a, i)
        let db = str_byte_at(b, i)
        if da < db {
            return 1
        }
        if da > db {
            return 0
        }
        i = i + 1
    }
    if str_len(a) < str_len(b) {
        return 1
    }
    return 0
}

fn ikey(db: int, key: string) -> string {
    if db == 0 {
        return "/0/" + key
    }
    return "/" + format_int(db) + "/" + key
}

fn ukey(ik: string) -> string {
    if str_len(ik) == 0 or str_byte_at(ik, 0) != 47 {
        return ik
    }
    let rest = ik[1:]
    let i = str_index(rest, "/")
    if i < 0 {
        return ik
    }
    return rest[i + 1:]
}

fn kdb(ik: string) -> int {
    if str_len(ik) == 0 or str_byte_at(ik, 0) != 47 {
        return 0
    }
    let rest = ik[1:]
    let i = str_index(rest, "/")
    if i < 0 {
        return 0
    }
    return int_of(rest[:i])
}

fn slice_pre(xs: []string, v: string) -> []string {
    let mut out = make([]string, 0, len(xs) + 1)
    out = append(out, v)
    let mut i = 0
    while i < len(xs) {
        out = append(out, xs[i])
        i = i + 1
    }
    return out
}

fn slice_at(xs: []string, idx: int) -> (string, int) {
    let n = len(xs)
    let mut i = idx
    if i < 0 {
        i = n + i
    }
    if i < 0 or i >= n {
        return ("", 0)
    }
    return (xs[i], 1)
}

fn slice_range(xs: []string, start: int, stop: int) -> []string {
    let n = len(xs)
    let none: []string = []
    if n == 0 {
        return none
    }
    let mut a = start
    let mut b = stop
    if a < 0 {
        a = n + a
    }
    if b < 0 {
        b = n + b
    }
    if a < 0 {
        a = 0
    }
    if b < 0 {
        return none
    }
    if a >= n {
        return none
    }
    if b >= n {
        b = n - 1
    }
    if a > b {
        return none
    }
    let mut out = make([]string, 0, b - a + 1)
    let mut i = a
    while i <= b {
        out = append(out, xs[i])
        i = i + 1
    }
    return out
}

fn slice_trim(xs: []string, start: int, stop: int) -> []string {
    return slice_range(xs, start, stop)
}

fn set_members(s: map[string]int) -> []string {
    let mut items = make([]string, 0, len(s))
    for m, _ in range s {
        items = append(items, m)
    }
    return items
}

fn z_sorted(h: map[string]string) -> ([]string, []string) {
    let mut mems = make([]string, 0, len(h))
    let mut scs = make([]string, 0, len(h))
    for m, sc in range h {
        mems = append(mems, m)
        scs = append(scs, sc)
    }
    let n = len(mems)
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n - 1 {
            let sj = parse_float(scs[j])
            let sjp = parse_float(scs[j + 1])
            let mut sw = 0
            if sj > sjp {
                sw = 1
            }
            if sj == sjp and str_lt(mems[j + 1], mems[j]) == 1 {
                sw = 1
            }
            if sw == 1 {
                let tm = mems[j]
                mems[j] = mems[j + 1]
                mems[j + 1] = tm
                let ts = scs[j]
                scs[j] = scs[j + 1]
                scs[j + 1] = ts
            }
            j = j + 1
        }
        i = i + 1
    }
    return (mems, scs)
}

fn slice_skip_take(xs: []string, skip: int, take: int) -> []string {
    let n = len(xs)
    let none: []string = []
    if skip >= n or take <= 0 {
        return none
    }
    let mut i = skip
    if i < 0 {
        i = 0
    }
    let mut out = make([]string, 0, take)
    let mut c = 0
    while i < n and c < take {
        out = append(out, xs[i])
        i = i + 1
        c = c + 1
    }
    return out
}


fn Store_charge(mut self: Store, n: int) -> int {
    self.used = self.used + n
    if self.used < 0 {
        self.used = 0
    }
    return self.used
}

fn finite_score(s: string) -> int {
    if str_len(s) == 0 {
        return 0
    }
    let u = str_to_lower(s)
    if str_eq(u, "nan") or str_eq(u, "inf") or str_eq(u, "+inf") or str_eq(u, "-inf") {
        return 0
    }
    let mut i = 0
    if str_byte_at(s, 0) == 43 or str_byte_at(s, 0) == 45 {
        i = 1
    }
    if i >= str_len(s) {
        return 0
    }
    let mut dot = 0
    let mut digits = 0
    while i < str_len(s) {
        let c = str_byte_at(s, i)
        if c == 46 {
            if dot == 1 {
                return 0
            }
            dot = 1
        } else if c >= 48 and c <= 57 {
            digits = 1
        } else if c == 101 or c == 69 {
            return 1
        } else {
            return 0
        }
        i = i + 1
    }
    return digits
}

fn Store_drop_key(mut self: Store, ik: string) -> int {
    if not has(self.types, ik) {
        return 0
    }
    let n = self.payload_bytes(ik)
    let t = self.types[ik]
    if t == T_STR {
        delete(self.strs, ik)
    } else if t == T_HASH {
        delete(self.hashes, ik)
    } else if t == T_LIST {
        delete(self.lists, ik)
    } else if t == T_SET {
        delete(self.sets, ik)
    } else if t == T_ZSET {
        delete(self.zsets, ik)
    } else if t == T_STREAM {
        delete(self.streams, ik)
        delete(self.xseq, ik)
        let pref = ik + "\u001e"
        let mut gks = make([]string, 0, 4)
        for gk, _ in range self.xg {
            if str_has_prefix(gk, pref) {
                gks = append(gks, gk)
            }
        }
        let mut gi = 0
        while gi < len(gks) {
            delete(self.xg, gks[gi])
            delete(self.xp, gks[gi])
            gi = gi + 1
        }
    } else if t == T_VEC {
        delete(self.vecs, ik)
        delete(self.vtxt, ik)
        delete(self.vdim, ik)
    }
    delete(self.types, ik)
    delete(self.expire, ik)
    delete(self.atime, ik)
    self.scrub_graph(ik)
    self.charge(0 - n)
    return 1
}

fn Store_touch(mut self: Store, ik: string) {
    if self.maxmem > 0 or (self.ops & 7) == 0 {
        self.atime[ik] = self.ops
    }
}

fn Store_evict_one(mut self: Store, _n: int) -> int {
    let mut victim = ""
    let mut best = 1000000000
    for ik, _ in range self.types {
        let mut a = 0
        if has(self.atime, ik) {
            a = self.atime[ik]
        }
        if str_eq(victim, "") or a < best {
            victim = ik
            best = a
        }
    }
    if str_eq(victim, "") {
        return 0
    }
    return self.drop_key(victim)
}

fn Store_maybe_evict(mut self: Store, _n: int) -> int {
    if self.maxmem <= 0 {
        return 0
    }
    let _ = self.recount(0)
    let mut n = 0
    while self.used > self.maxmem and n < 1024 {
        if self.evict_one(0) == 0 {
            break
        }
        n = n + 1
    }
    if n > 0 {
        log_evict(n, self.used, self.maxmem)
    }
    return n
}

fn Store_live(mut self: Store, ik: string) -> int {
    if not has(self.types, ik) {
        return 0
    }
    if has(self.expire, ik) {
        if self.expire[ik] <= wall_ms() {
            let _ = self.drop_key(ik)
            return 0
        }
    }
    self.touch(ik)
    return 1
}

fn Store_kind(mut self: Store, ik: string) -> int {
    if self.live(ik) == 0 {
        return T_NONE
    }
    return self.types[ik]
}

fn Store_set_expire_at(mut self: Store, ik: string, at: int) {
    if at <= 0 {
        delete(self.expire, ik)
    } else {
        self.expire[ik] = at
    }
}

fn Store_maybe_defttl(mut self: Store, ik: string) {
    if self.defttl > 0 {
        self.set_expire_at(ik, wall_ms() + self.defttl)
    }
}

fn Store_kver(mut self: Store, ik: string) -> int {
    let mut v = self.gen
    if has(self.vers, ik) {
        v = v + self.vers[ik]
    }
    return v
}

fn Store_note_write(mut self: Store, ik: string) {
    let mut v = 0
    if has(self.vers, ik) {
        v = self.vers[ik]
    }
    self.vers[ik] = v + 1
}

fn Store_bump_argv(mut self: Store, db: int, argv: []string) {
    let cmd = cmd_name(argv)
    if str_eq(cmd, "FLUSHALL") or str_eq(cmd, "FLUSHDB") {
        self.gen = self.gen + 1
        return
    }
    if str_eq(cmd, "MSET") or str_eq(cmd, "MSETNX") {
        let mut i = 1
        while i < len(argv) {
            self.note_write(ikey(db, argv[i]))
            i = i + 2
        }
        return
    }
    if str_eq(cmd, "DEL") or str_eq(cmd, "UNLINK") or str_eq(cmd, "TOUCH") {
        let mut i = 1
        while i < len(argv) {
            self.note_write(ikey(db, argv[i]))
            i = i + 1
        }
        return
    }
    if str_eq(cmd, "RPOPLPUSH") or str_eq(cmd, "MOVE") {
        if len(argv) >= 3 {
            self.note_write(ikey(db, argv[1]))
            if str_eq(cmd, "RPOPLPUSH") {
                self.note_write(ikey(db, argv[2]))
            }
        }
        return
    }
    if str_eq(cmd, "RENAME") or str_eq(cmd, "RENAMENX") or str_eq(cmd, "COPY") or str_eq(cmd, "LMOVE") or str_eq(cmd, "SMOVE") {
        if len(argv) >= 3 {
            self.note_write(ikey(db, argv[1]))
            self.note_write(ikey(db, argv[2]))
        }
        return
    }
    if str_eq(cmd, "BITOP") and len(argv) >= 3 {
        self.note_write(ikey(db, argv[2]))
        return
    }
    if str_eq(cmd, "ZUNIONSTORE") and len(argv) >= 2 {
        self.note_write(ikey(db, argv[1]))
        return
    }
    if len(argv) >= 2 {
        self.note_write(ikey(db, argv[1]))
    }
}

fn Store_cmd_kver(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("kver")
    }
    return r_int(self.kver(ikey(db, argv[1])))
}

fn Store_apply(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) == 0 {
        return r_err("ERR empty command")
    }
    self.ops = self.ops + 1
    if self.maxmem > 0 {
        let _ = self.maybe_evict(0)
    }
    let cmd = cmd_name(argv)
    let out = self.dispatch_cmd(db, argv)
    if self.maxmem > 0 and is_write_cmd(cmd) == 1 {
        let _ = self.maybe_evict(0)
    }
    if is_write_cmd(cmd) == 1 and str_len(out) > 0 {
        if str_byte_at(out, 0) != 45 and not str_eq(out, r_nil()) {
            self.bump_argv(db, argv)
            if len(argv) >= 2 {
                self.xp["\u001eLast\u001e" + ikey(db, argv[1])] = cmd
            }
        }
    }
    return out
}

fn Store_dispatch_cmd(mut self: Store, db: int, argv: []string) -> string {
    let cmd = cmd_name(argv)
    if str_eq(cmd, "GET") {
        return self.cmd_get(db, argv)
    }
    if str_eq(cmd, "SET") {
        return self.cmd_set(db, argv)
    }
    if str_eq(cmd, "SETNX") {
        if len(argv) != 3 {
            return r_arity("setnx")
        }
        return self.cmd_set(db, ["SET", argv[1], argv[2], "NX"])
    }
    if str_eq(cmd, "SETEX") {
        if len(argv) != 4 {
            return r_arity("setex")
        }
        return self.cmd_set(db, ["SET", argv[1], argv[3], "EX", argv[2]])
    }
    if str_eq(cmd, "PSETEX") {
        if len(argv) != 4 {
            return r_arity("psetex")
        }
        return self.cmd_set(db, ["SET", argv[1], argv[3], "PX", argv[2]])
    }
    if str_eq(cmd, "GETSET") {
        return self.cmd_getset(db, argv)
    }
    if str_eq(cmd, "APPEND") {
        return self.cmd_append(db, argv)
    }
    if str_eq(cmd, "STRLEN") {
        return self.cmd_strlen(db, argv)
    }
    if str_eq(cmd, "INCR") {
        if len(argv) != 2 {
            return r_arity("incr")
        }
        return self.cmd_incrby(db, argv[1], 1)
    }
    if str_eq(cmd, "DECR") {
        if len(argv) != 2 {
            return r_arity("decr")
        }
        return self.cmd_incrby(db, argv[1], 0 - 1)
    }
    if str_eq(cmd, "INCRBY") {
        if len(argv) != 3 {
            return r_arity("incrby")
        }
        let n, ok = int_ok(argv[2])
        if ok == 0 {
            return r_notint()
        }
        return self.cmd_incrby(db, argv[1], n)
    }
    if str_eq(cmd, "DECRBY") {
        if len(argv) != 3 {
            return r_arity("decrby")
        }
        let n, ok = int_ok(argv[2])
        if ok == 0 {
            return r_notint()
        }
        return self.cmd_incrby(db, argv[1], 0 - n)
    }
    if str_eq(cmd, "MGET") {
        return self.cmd_mget(db, argv)
    }
    if str_eq(cmd, "MSET") {
        return self.cmd_mset(db, argv, 0)
    }
    if str_eq(cmd, "MSETNX") {
        return self.cmd_mset(db, argv, 1)
    }
    if str_eq(cmd, "DEL") or str_eq(cmd, "UNLINK") {
        return self.cmd_del(db, argv)
    }
    if str_eq(cmd, "EXISTS") {
        return self.cmd_exists(db, argv)
    }
    if str_eq(cmd, "TYPE") {
        return self.cmd_type(db, argv)
    }
    if str_eq(cmd, "EXPIRE") {
        return self.cmd_expire(db, argv, 1000)
    }
    if str_eq(cmd, "PEXPIRE") {
        return self.cmd_expire(db, argv, 1)
    }
    if str_eq(cmd, "EXPIREAT") {
        return self.cmd_expireat(db, argv, 1000)
    }
    if str_eq(cmd, "PEXPIREAT") {
        return self.cmd_expireat(db, argv, 1)
    }
    if str_eq(cmd, "TTL") {
        return self.cmd_ttl(db, argv, 1000)
    }
    if str_eq(cmd, "PTTL") {
        return self.cmd_ttl(db, argv, 1)
    }
    if str_eq(cmd, "PERSIST") {
        return self.cmd_persist(db, argv)
    }
    if str_eq(cmd, "RENAME") {
        return self.cmd_rename(db, argv, 0)
    }
    if str_eq(cmd, "RENAMENX") {
        return self.cmd_rename(db, argv, 1)
    }
    if str_eq(cmd, "KEYS") {
        return self.cmd_keys(db, argv)
    }
    if str_eq(cmd, "__SCANKEYS") {
        let mut pat = "*"
        if len(argv) >= 2 {
            pat = argv[1]
        }
        return r_array_bulks(self.collect_keys(db, pat))
    }
    if str_eq(cmd, "HOTKEYS") {
        return self.cmd_hotkeys(db, argv)
    }
    if str_eq(cmd, "SCAN") {
        return self.cmd_scan(db, argv)
    }
    if str_eq(cmd, "RANDOMKEY") {
        return self.cmd_randomkey(db)
    }
    if str_eq(cmd, "DBSIZE") {
        return r_int(self.cmd_dbsize(db))
    }
    if str_eq(cmd, "FLUSHDB") {
        return self.cmd_flush(db, 0)
    }
    if str_eq(cmd, "FLUSHALL") {
        return self.cmd_flush(db, 1)
    }
    if str_eq(cmd, "HSET") {
        return self.cmd_hset(db, argv, 0)
    }
    if str_eq(cmd, "HMSET") {
        return self.cmd_hset(db, argv, 1)
    }
    if str_eq(cmd, "HGET") {
        return self.cmd_hget(db, argv)
    }
    if str_eq(cmd, "HMGET") {
        return self.cmd_hmget(db, argv)
    }
    if str_eq(cmd, "HGETALL") {
        return self.cmd_hgetall(db, argv)
    }
    if str_eq(cmd, "HDEL") {
        return self.cmd_hdel(db, argv)
    }
    if str_eq(cmd, "HEXISTS") {
        return self.cmd_hexists(db, argv)
    }
    if str_eq(cmd, "HKEYS") {
        return self.cmd_hkeys(db, argv, 0)
    }
    if str_eq(cmd, "HVALS") {
        return self.cmd_hkeys(db, argv, 1)
    }
    if str_eq(cmd, "HLEN") {
        return self.cmd_hlen(db, argv)
    }
    if str_eq(cmd, "HINCRBY") {
        return self.cmd_hincrby(db, argv)
    }
    if str_eq(cmd, "LPUSH") {
        return self.cmd_lpush(db, argv, 0)
    }
    if str_eq(cmd, "RPUSH") {
        return self.cmd_lpush(db, argv, 1)
    }
    if str_eq(cmd, "LPOP") {
        return self.cmd_lpop(db, argv, 0)
    }
    if str_eq(cmd, "RPOP") {
        return self.cmd_lpop(db, argv, 1)
    }
    if str_eq(cmd, "LRANGE") {
        return self.cmd_lrange(db, argv)
    }
    if str_eq(cmd, "LLEN") {
        return self.cmd_llen(db, argv)
    }
    if str_eq(cmd, "LINDEX") {
        return self.cmd_lindex(db, argv)
    }
    if str_eq(cmd, "LSET") {
        return self.cmd_lset(db, argv)
    }
    if str_eq(cmd, "LTRIM") {
        return self.cmd_ltrim(db, argv)
    }
    if str_eq(cmd, "SADD") {
        return self.cmd_sadd(db, argv)
    }
    if str_eq(cmd, "SREM") {
        return self.cmd_srem(db, argv)
    }
    if str_eq(cmd, "SISMEMBER") {
        return self.cmd_sismember(db, argv)
    }
    if str_eq(cmd, "SMEMBERS") {
        return self.cmd_smembers(db, argv)
    }
    if str_eq(cmd, "SCARD") {
        return self.cmd_scard(db, argv)
    }
    if str_eq(cmd, "SPOP") {
        return self.cmd_spop(db, argv)
    }
    if str_eq(cmd, "SRANDMEMBER") {
        return self.cmd_srandmember(db, argv)
    }
    if str_eq(cmd, "ZADD") {
        return self.cmd_zadd(db, argv)
    }
    if str_eq(cmd, "ZREM") {
        return self.cmd_zrem(db, argv)
    }
    if str_eq(cmd, "ZSCORE") {
        return self.cmd_zscore(db, argv)
    }
    if str_eq(cmd, "ZCARD") {
        return self.cmd_zcard(db, argv)
    }
    if str_eq(cmd, "ZRANGE") {
        return self.cmd_zrange(db, argv, 0)
    }
    if str_eq(cmd, "ZREVRANGE") {
        return self.cmd_zrange(db, argv, 1)
    }
    if str_eq(cmd, "ZRANK") {
        return self.cmd_zrank(db, argv, 0)
    }
    if str_eq(cmd, "ZREVRANK") {
        return self.cmd_zrank(db, argv, 1)
    }
    if str_eq(cmd, "ZINCRBY") {
        return self.cmd_zincrby(db, argv)
    }
    if str_eq(cmd, "DUMPKV") {
        return self.cmd_dumpkv(db)
    }
    if str_eq(cmd, "SETBIT") {
        return self.cmd_setbit(db, argv)
    }
    if str_eq(cmd, "GETBIT") {
        return self.cmd_getbit(db, argv)
    }
    if str_eq(cmd, "BITCOUNT") {
        return self.cmd_bitcount(db, argv)
    }
    if str_eq(cmd, "GEOADD") {
        return self.cmd_geoadd(db, argv)
    }
    if str_eq(cmd, "GEODIST") {
        return self.cmd_geodist(db, argv)
    }
    if str_eq(cmd, "GEOPOS") {
        return self.cmd_geopos(db, argv)
    }
    if str_eq(cmd, "GEORADIUS") {
        return self.cmd_georadius(db, argv)
    }
    if str_eq(cmd, "EVAL") {
        return self.cmd_eval(db, argv)
    }
    if str_eq(cmd, "XADD") {
        return self.cmd_xadd(db, argv)
    }
    if str_eq(cmd, "XLEN") {
