fn Store_cmd_get(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("get")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nil()
    }
    if t != T_STR {
        return r_wrongtype()
    }
    return r_bulk(self.strs[ik])
}

fn Store_cmd_set(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("set")
    }
    let key = argv[1]
    let val = argv[2]
    let ik = ikey(db, key)
    let mut nx = 0
    let mut xx = 0
    let mut geto = 0
    let mut keepttl = 0
    let mut set_exp = 0
    let mut at = 0
    let mut i = 3
    while i < len(argv) {
        let o = str_to_upper(argv[i])
        if str_eq(o, "NX") {
            nx = 1
            i = i + 1
        } else if str_eq(o, "XX") {
            xx = 1
            i = i + 1
        } else if str_eq(o, "GET") {
            geto = 1
            i = i + 1
        } else if str_eq(o, "KEEPTTL") {
            keepttl = 1
            i = i + 1
        } else if str_eq(o, "EX") or str_eq(o, "PX") or str_eq(o, "EXAT") or str_eq(o, "PXAT") {
            if i + 1 >= len(argv) {
                return r_syntax()
            }
            let n, ok = int_ok(argv[i + 1])
            if ok == 0 {
                return r_notint()
            }
            if str_eq(o, "EX") {
                at = wall_ms() + n * 1000
            } else if str_eq(o, "PX") {
                at = wall_ms() + n
            } else if str_eq(o, "EXAT") {
                at = n * 1000
            } else {
                at = n
            }
            set_exp = 1
            i = i + 2
        } else {
            return r_syntax()
        }
    }
    if nx == 1 and xx == 1 {
        return r_syntax()
    }
    if keepttl == 1 and set_exp == 1 {
        return r_syntax()
    }
    let exists = self.live(ik)
    if nx == 1 and exists == 1 {
        if geto == 1 {
            if self.types[ik] != T_STR {
                return r_wrongtype()
            }
            return r_bulk(self.strs[ik])
        }
        return r_nil()
    }
    if xx == 1 and exists == 0 {
        return r_nil()
    }
    let mut old = ""
    let mut had = 0
    if geto == 1 {
        if exists == 1 {
            if self.types[ik] != T_STR {
                return r_wrongtype()
            }
            old = self.strs[ik]
            had = 1
        }
    }
    let mut old_ttl = 0
    if keepttl == 1 and exists == 1 {
        if has(self.expire, ik) {
            old_ttl = self.expire[ik]
        }
    }
    if exists == 1 {
        let _ = self.drop_key(ik)
    }
    self.strs[ik] = val
    self.types[ik] = T_STR
    self.charge(str_len(key) + str_len(val))
    if keepttl == 1 {
        if old_ttl > 0 {
            self.set_expire_at(ik, old_ttl)
        }
    } else if set_exp == 1 {
        self.set_expire_at(ik, at)
    } else {
        self.maybe_defttl(ik)
    }
    let _ = self.maybe_evict(0)
    if geto == 1 {
        if had == 1 {
            return r_bulk(old)
        }
        return r_nil()
    }
    return r_ok()
}

fn Store_cmd_getset(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("getset")
    }
    return self.cmd_set(db, ["SET", argv[1], argv[2], "GET"])
}

fn Store_cmd_append(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("append")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        self.strs[ik] = argv[2]
        self.types[ik] = T_STR
        self.maybe_defttl(ik)
        return r_int(str_len(argv[2]))
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let nv = self.strs[ik] + argv[2]
    self.strs[ik] = nv
    return r_int(str_len(nv))
}

fn Store_cmd_strlen(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("strlen")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_STR {
        return r_wrongtype()
    }
    return r_int(str_len(self.strs[ik]))
}

fn Store_cmd_incrby(mut self: Store, db: int, key: string, delta: int) -> string {
    let ik = ikey(db, key)
    let t = self.kind(ik)
    if t == T_NONE {
        self.strs[ik] = format_int(delta)
        self.types[ik] = T_STR
        self.maybe_defttl(ik)
        return r_int(delta)
    }
    if t != T_STR {
        return r_wrongtype()
    }
    let cur, ok = int_ok(self.strs[ik])
    if ok == 0 {
        return r_notint()
    }
    if would_overflow_add(cur, delta) == 1 {
        return r_err("ERR increment or decrement would overflow")
    }
    let n = cur + delta
    self.strs[ik] = format_int(n)
    return r_int(n)
}

fn Store_cmd_mget(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("mget")
    }
    let mut items = make([]string, 0, len(argv) - 1)
    let mut hit = make([]int, 0, len(argv) - 1)
    let mut i = 1
    while i < len(argv) {
        let ik = ikey(db, argv[i])
        let t = self.kind(ik)
        if t == T_STR {
            items = append(items, self.strs[ik])
            hit = append(hit, 1)
        } else {
            items = append(items, "")
            hit = append(hit, 0)
        }
        i = i + 1
    }
    return r_array_opt(items, hit)
}

fn Store_cmd_mset(mut self: Store, db: int, argv: []string, nx: int) -> string {
    if len(argv) < 3 or (len(argv) % 2) == 0 {
        return r_arity("mset")
    }
    if nx == 1 {
        let mut i = 1
        while i < len(argv) {
            if self.live(ikey(db, argv[i])) == 1 {
                return r_int(0)
            }
            i = i + 2
        }
    }
    let mut i = 1
    while i + 1 < len(argv) {
        let _ = self.cmd_set(db, ["SET", argv[i], argv[i + 1]])
        i = i + 2
    }
    if nx == 1 {
        return r_int(1)
    }
    return r_ok()
}

fn Store_cmd_del(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("del")
    }
    let mut n = 0
    let mut i = 1
    while i < len(argv) {
        let ik = ikey(db, argv[i])
        if self.live(ik) == 1 {
            n = n + self.drop_key(ik)
        }
        i = i + 1
    }
    return r_int(n)
}

fn Store_cmd_exists(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("exists")
    }
    let mut n = 0
    let mut i = 1
    while i < len(argv) {
        if self.live(ikey(db, argv[i])) == 1 {
            n = n + 1
        }
        i = i + 1
    }
    return r_int(n)
}

fn Store_cmd_type(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("type")
    }
    let t = self.kind(ikey(db, argv[1]))
    if t == T_NONE {
        return r_simple("none")
    }
    if t == T_STR {
        return r_simple("string")
    }
    if t == T_HASH {
        return r_simple("hash")
    }
    if t == T_LIST {
        return r_simple("list")
    }
    if t == T_SET {
        return r_simple("set")
    }
    if t == T_ZSET {
        return r_simple("zset")
    }
    if t == T_STREAM {
        return r_simple("stream")
    }
    if t == T_VEC {
        return r_simple("vector")
    }
    return r_simple("none")
}

fn Store_cmd_expire(mut self: Store, db: int, argv: []string, mul: int) -> string {
    if len(argv) < 3 {
        return r_arity("expire")
    }
    let n, ok = int_ok(argv[2])
    if ok == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    if self.live(ik) == 0 {
        return r_int(0)
    }
    let mut nx = 0
    let mut xx = 0
    let mut gt = 0
    let mut lt = 0
    let mut ai = 3
    while ai < len(argv) {
        let o = str_to_upper(argv[ai])
        if str_eq(o, "NX") {
            nx = 1
        } else if str_eq(o, "XX") {
            xx = 1
        } else if str_eq(o, "GT") {
            gt = 1
        } else if str_eq(o, "LT") {
            lt = 1
        }
        ai = ai + 1
    }
    let mut hasx = 0
    if has(self.expire, ik) {
        hasx = 1
    }
    if nx == 1 and hasx == 1 {
        return r_int(0)
    }
    if xx == 1 and hasx == 0 {
        return r_int(0)
    }
    let mut nxt = wall_ms() + n * mul
    if n <= 0 {
        nxt = wall_ms()
    }
    if gt == 1 and hasx == 1 and nxt <= self.expire[ik] {
        return r_int(0)
    }
    if lt == 1 and hasx == 1 and nxt >= self.expire[ik] {
        return r_int(0)
    }
    if n <= 0 {
        let _ = self.drop_key(ik)
        return r_int(1)
    }
    self.set_expire_at(ik, nxt)
    return r_int(1)
}

fn Store_cmd_expireat(mut self: Store, db: int, argv: []string, mul: int) -> string {
    if len(argv) != 3 {
        return r_arity("expireat")
    }
    let n, ok = int_ok(argv[2])
    if ok == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    if self.live(ik) == 0 {
        return r_int(0)
    }
    let at = n * mul
    if at <= wall_ms() {
        let _ = self.drop_key(ik)
        return r_int(1)
    }
    self.set_expire_at(ik, at)
    return r_int(1)
}

fn Store_cmd_ttl(mut self: Store, db: int, argv: []string, div: int) -> string {
    if len(argv) != 2 {
        return r_arity("ttl")
    }
    let ik = ikey(db, argv[1])
    if self.live(ik) == 0 {
        return r_int(0 - 2)
    }
    if not has(self.expire, ik) {
        return r_int(0 - 1)
    }
    let left = self.expire[ik] - wall_ms()
    if left < 0 {
        return r_int(0 - 2)
    }
    if div == 1 {
        return r_int(left)
    }
    return r_int(left / 1000)
}

fn Store_cmd_persist(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("persist")
    }
    let ik = ikey(db, argv[1])
    if self.live(ik) == 0 {
        return r_int(0)
    }
    if not has(self.expire, ik) {
        return r_int(0)
    }
    delete(self.expire, ik)
    return r_int(1)
}

fn Store_cmd_rename(mut self: Store, db: int, argv: []string, nx: int) -> string {
    if len(argv) != 3 {
        return r_arity("rename")
    }
    let src = ikey(db, argv[1])
    let dst = ikey(db, argv[2])
    if self.live(src) == 0 {
        return r_nokey()
    }
    if str_eq(argv[1], argv[2]) {
        return r_ok()
    }
    if nx == 1 and self.live(dst) == 1 {
        return r_int(0)
    }
    let t = self.types[src]
    if self.live(dst) == 1 {
        let _ = self.drop_key(dst)
    }
    self.types[dst] = t
    if t == T_STR {
        self.strs[dst] = self.strs[src]
    } else if t == T_HASH {
        self.hashes[dst] = self.hashes[src]
    } else if t == T_LIST {
        self.lists[dst] = self.lists[src]
    } else if t == T_SET {
        self.sets[dst] = self.sets[src]
    } else if t == T_ZSET {
        self.zsets[dst] = self.zsets[src]
    }
    if has(self.expire, src) {
        self.expire[dst] = self.expire[src]
    }
    let _ = self.drop_key(src)
    if nx == 1 {
        return r_int(1)
    }
    return r_ok()
}

fn Store_collect_keys(mut self: Store, db: int, pat: string) -> []string {
    return self.collect_keys_lim(db, pat, 0)
}

fn Store_collect_keys_lim(mut self: Store, db: int, pat: string, cap: int) -> []string {
    let mut raw = make([]string, 0, 8)
    for ik, _ in range self.types {
        raw = append(raw, ik)
    }
    let mut out = make([]string, 0, len(raw))
    let mut i = 0
    while i < len(raw) {
        let ik = raw[i]
        if kdb(ik) == db {
            if self.live(ik) == 1 {
                let k = ukey(ik)
                if str_eq(pat, "*") or glob_match(pat, k) == 1 {
                    out = append(out, k)
                    if cap > 0 and len(out) > cap {
                        return out
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

fn Store_cmd_keys(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("keys")
    }
    let ks = self.collect_keys_lim(db, argv[1], KEYS_HARD_LIMIT)
    if len(ks) > KEYS_HARD_LIMIT {
        return r_err("ERR KEYS refused: too many keys, use SCAN")
    }
    return r_array_bulks(ks)
}

fn Store_cmd_hotkeys(mut self: Store, db: int, argv: []string) -> string {
    let mut n = 10
    if len(argv) >= 2 {
        let c, ok = int_ok(argv[1])
        if ok == 1 and c > 0 {
            n = c
        }
    }
    if n > 32 {
        n = 32
    }
    let mut ks = self.collect_keys(db, "*")
    let mut hits = make([]int, 0, len(ks))
    let mut i = 0
    while i < len(ks) {
        let ik = ikey(db, ks[i])
        let mut a = 0
        if has(self.atime, ik) {
            a = self.atime[ik]
        }
        hits = append(hits, a)
        i = i + 1
    }
    let nk = len(ks)
    let mut p = 0
    while p < nk {
        let mut j = 0
        while j < nk - 1 {
            if hits[j] < hits[j + 1] {
                let tk = ks[j]
                ks[j] = ks[j + 1]
                ks[j + 1] = tk
                let th = hits[j]
                hits[j] = hits[j + 1]
                hits[j + 1] = th
            }
            j = j + 1
        }
        p = p + 1
    }
    if n > nk {
        n = nk
    }
    let mut out = make([]string, 0, n * 2)
    i = 0
    while i < n {
        out = append(out, ks[i])
        out = append(out, format_int(hits[i]))
        i = i + 1
    }
    return r_array_bulks(out)
}

fn Store_cmd_scan(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 {
        return r_arity("scan")
    }
    let mut cursor, cok = int_ok(argv[1])
    if cok == 0 {
        cursor = 0
    }
    let mut pat = "*"
    let mut count = 10
    let mut i = 2
    while i + 1 < len(argv) {
        let o = str_to_upper(argv[i])
        if str_eq(o, "MATCH") {
            pat = argv[i + 1]
        } else if str_eq(o, "COUNT") {
            let n, ok = int_ok(argv[i + 1])
            if ok == 1 and n > 0 {
                count = n
            }
        }
        i = i + 2
    }
    let all = self.collect_keys(db, pat)
    let chunk = slice_skip_take(all, cursor, count)
    let mut next = cursor + len(chunk)
    if next >= len(all) {
        next = 0
    }
    return r_scan(format_int(next), chunk)
}

fn Store_cmd_randomkey(mut self: Store, db: int) -> string {
    let all = self.collect_keys(db, "*")
    if len(all) == 0 {
        return r_nil()
    }
    let mut i = rand_intn(len(all))
    if i < 0 {
        i = 0
    }
    if i >= len(all) {
        i = 0
    }
    return r_bulk(all[i])
}

fn Store_cmd_dbsize(mut self: Store, db: int) -> int {
    return len(self.collect_keys(db, "*"))
}

fn Store_cmd_flush(mut self: Store, db: int, all: int) -> string {
    let mut drop: []string = []
    for ik, _ in range self.types {
        drop = append(drop, ik)
    }
    let mut filtered: []string = []
    let mut di = 0
    while di < len(drop) {
        if all == 1 or kdb(drop[di]) == db {
            filtered = append(filtered, drop[di])
        }
        di = di + 1
    }
    drop = filtered
    let mut i = 0
    while i < len(drop) {
        let _ = self.drop_key(drop[i])
        i = i + 1
    }
    return r_ok()
}

fn Store_ensure_hash(mut self: Store, ik: string) -> int {
    let t = self.kind(ik)
    if t == T_NONE {
        self.hashes[ik] = make(map[string]string)
        self.types[ik] = T_HASH
        return 1
    }
    if t != T_HASH {
        return 0
    }
    return 1
}

fn Store_cmd_hset(mut self: Store, db: int, argv: []string, as_ok: int) -> string {
    if len(argv) < 4 or (len(argv) % 2) == 1 {
        return r_arity("hset")
    }
    let ik = ikey(db, argv[1])
    if self.ensure_hash(ik) == 0 {
        return r_wrongtype()
    }
    let mut h = self.hashes[ik]
    let mut added = 0
    let mut i = 2
    while i + 1 < len(argv) {
        if not has(h, argv[i]) {
            added = added + 1
        }
        h[argv[i]] = argv[i + 1]
        i = i + 2
    }
    self.hashes[ik] = h
    if as_ok == 1 {
        return r_ok()
    }
    return r_int(added)
}

fn Store_cmd_hget(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("hget")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nil()
    }
    if t != T_HASH {
        return r_wrongtype()
    }
    let h = self.hashes[ik]
    if not has(h, argv[2]) {
        return r_nil()
    }
    return r_bulk(h[argv[2]])
}

fn Store_cmd_hmget(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("hmget")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t != T_NONE and t != T_HASH {
        return r_wrongtype()
    }
    let mut items = make([]string, 0, len(argv) - 2)
    let mut hit = make([]int, 0, len(argv) - 2)
    let mut i = 2
    while i < len(argv) {
        if t == T_HASH {
            let h = self.hashes[ik]
            if has(h, argv[i]) {
                items = append(items, h[argv[i]])
                hit = append(hit, 1)
            } else {
                items = append(items, "")
                hit = append(hit, 0)
            }
        } else {
            items = append(items, "")
            hit = append(hit, 0)
        }
        i = i + 1
    }
    return r_array_opt(items, hit)
}

fn Store_cmd_hgetall(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("hgetall")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        let none: []string = []
        return r_array_bulks(none)
    }
    if t != T_HASH {
        return r_wrongtype()
    }
    let h = self.hashes[ik]
    let mut items = make([]string, 0, len(h) * 2)
    for f, v in range h {
        items = append(items, f)
        items = append(items, v)
    }
    return r_array_bulks(items)
}

fn Store_cmd_hdel(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("hdel")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_HASH {
        return r_wrongtype()
    }
    let mut h = self.hashes[ik]
    let mut n = 0
    let mut i = 2
    while i < len(argv) {
        if has(h, argv[i]) {
            delete(h, argv[i])
            n = n + 1
        }
        i = i + 1
    }
    if len(h) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.hashes[ik] = h
    }
    return r_int(n)
}

fn Store_cmd_hexists(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("hexists")
    }
    let ik = ikey(db, argv[1])
