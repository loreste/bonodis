pack bonodis

const T_NONE = 0
const T_STR = 1
const T_HASH = 2
const T_LIST = 3
const T_SET = 4
const T_ZSET = 5
const T_STREAM = 6
const T_VEC = 7

struct Store {
    strs: map[string]string
    types: map[string]int
    expire: map[string]int
    hashes: map[string]map[string]string
    lists: map[string][]string
    sets: map[string]map[string]int
    zsets: map[string]map[string]string
    streams: map[string][]string
    xseq: map[string]int
    xg: map[string]string
    xp: map[string]string
    vecs: map[string]map[string]string
    vtxt: map[string]map[string]string
    vdim: map[string]int
    atime: map[string]int
    vers: map[string]int
    ops: int
    used: int
    maxmem: int
    defttl: int
    gen: int
}

fn new_store() -> Store {
    return Store {
        strs: make(map[string]string),
        types: make(map[string]int),
        expire: make(map[string]int),
        hashes: make(map[string]map[string]string),
        lists: make(map[string][]string),
        sets: make(map[string]map[string]int),
        zsets: make(map[string]map[string]string),
        streams: make(map[string][]string),
        xseq: make(map[string]int),
        xg: make(map[string]string),
        xp: make(map[string]string),
        vecs: make(map[string]map[string]string),
        vtxt: make(map[string]map[string]string),
        vdim: make(map[string]int),
        atime: make(map[string]int),
        vers: make(map[string]int),
        ops: 0,
        used: 0,
        maxmem: 0,
        defttl: 0,
        gen: 0,
    }
}

#[no_alloc]
fn str_lt(a: string, b: string) -> int {
    let n = min(str_len(a), str_len(b))
    let mut i = 0
    while i < n {
        let da = str_byte_at(a, i)
        let db = str_byte_at(b, i)
        if da < db {
            return 1
        }
        if da > db {
            return 0
        }
        i = i + 1
    }
    if str_len(a) < str_len(b) {
        return 1
    }
    return 0
}

fn ikey(db: int, key: string) -> string {
    if db == 0 {
        return "/0/" + key
    }
    return "/" + fmt_int_fast(db) + "/" + key
}

fn ukey(ik: string) -> string {
    let n = str_len(ik)
    if n < 3 or str_byte_at(ik, 0) != 47 {
        return ik
    }
    if str_byte_at(ik, 2) == 47 {
        return ik[3:]
    }
    let mut i = 1
    while i < n {
        if str_byte_at(ik, i) == 47 {
            return ik[i + 1:]
        }
        i = i + 1
    }
    return ik
}

#[no_alloc]
fn ukey_len(ik: string) -> int {
    let n = str_len(ik)
    if n < 3 or str_byte_at(ik, 0) != 47 {
        return n
    }
    if str_byte_at(ik, 2) == 47 {
        return n - 3
    }
    let mut i = 1
    while i < n {
        if str_byte_at(ik, i) == 47 {
            return n - (i + 1)
        }
        i = i + 1
    }
    return n
}

#[no_alloc]
fn kdb(ik: string) -> int {
    let n = str_len(ik)
    if n < 3 or str_byte_at(ik, 0) != 47 {
        return 0
    }
    if str_byte_at(ik, 2) == 47 {
        let b = str_byte_at(ik, 1)
        if b >= 48 and b <= 57 {
            return b - 48
        }
    }
    let mut acc = 0
    let mut i = 1
    while i < n {
        let b = str_byte_at(ik, i)
        if b == 47 {
            return acc
        }
        if b < 48 or b > 57 {
            return 0
        }
        acc = acc * 10 + (b - 48)
        i = i + 1
    }
    return 0
}

fn slice_pre(xs: []string, v: string) -> []string {
    let mut out = make([]string, 0, len(xs) + 1)
    out = append(out, v)
    let mut i = 0
    while i < len(xs) {
        out = append(out, xs[i])
        i = i + 1
    }
    return out
}

fn slice_at(xs: []string, idx: int) -> (string, int) {
    let n = len(xs)
    let mut i = idx
    if i < 0 {
        i = n + i
    }
    if i < 0 or i >= n {
        return ("", 0)
    }
    return (xs[i], 1)
}

fn slice_range(xs: []string, start: int, stop: int) -> []string {
    let n = len(xs)
    let none: []string = []
    if n == 0 {
        return none
    }
    let mut a = start
    let mut b = stop
    if a < 0 {
        a = n + a
    }
    if b < 0 {
        b = n + b
    }
    if a < 0 {
        a = 0
    }
    if b < 0 {
        return none
    }
    if a >= n {
        return none
    }
    if b >= n {
        b = n - 1
    }
    if a > b {
        return none
    }
    let mut out = make([]string, 0, b - a + 1)
    let mut i = a
    while i <= b {
        out = append(out, xs[i])
        i = i + 1
    }
    return out
}

fn slice_trim(xs: []string, start: int, stop: int) -> []string {
    return slice_range(xs, start, stop)
}

fn set_members(s: map[string]int) -> []string {
    let mut items = make([]string, 0, len(s))
    for m, _ in range s {
        items = append(items, m)
    }
    return items
}

fn sort_strings(mut xs: []string) -> []string {
    let n = len(xs)
    if n <= 1 {
        return xs
    }
    let gaps = [701, 301, 132, 57, 23, 10, 4, 1]
    let mut gi = 0
    while gi < len(gaps) {
        let gap = gaps[gi]
        if gap < n {
            let mut i = gap
            while i < n {
                let tv = xs[i]
                let mut j = i
                while j >= gap and str_lt(tv, xs[j - gap]) == 1 {
                    xs[j] = xs[j - gap]
                    j = j - gap
                }
                xs[j] = tv
                i = i + 1
            }
        }
        gi = gi + 1
    }
    return xs
}

fn hk_has(ik: string) -> string {
    return "\u001eHhas\u001e" + ik
}

fn hk_exp(ik: string, field: string) -> string {
    return "\u001eHexp\u001e" + ik + "\u001e" + field
}

fn lk_head(ik: string) -> string {
    return "\u001eLhead\u001e" + ik
}

fn Store_list_len(mut self: Store, ik: string) -> int {
    if not has(self.lists, ik) {
        return 0
    }
    let xs = self.lists[ik]
    let hk = lk_head(ik)
    let mut h = 0
    if len(self.xseq) > 0 and has(self.xseq, hk) {
        h = self.xseq[hk]
    }
    if h >= len(xs) {
        return 0
    }
    return len(xs) - h
}

fn Store_list_norm(mut self: Store, ik: string) -> []string {
    let mut xs = self.lists[ik]
    let hk = lk_head(ik)
    if len(self.xseq) > 0 and has(self.xseq, hk) {
        let h = self.xseq[hk]
        delete(self.xseq, hk)
        if h > 0 {
            if h >= len(xs) {
                let empty: []string = []
                xs = empty
            } else {
                xs = xs[h:]
            }
            self.lists[ik] = xs
        }
    }
    return xs
}

fn z_sorted(h: map[string]string) -> ([]string, []string) {
    let cap = len(h)
    let mut mems = make([]string, 0, cap)
    let mut scs = make([]string, 0, cap)
    let mut fscs = make([]float, 0, cap)
    for m, sc in range h {
        mems = append(mems, m)
        scs = append(scs, sc)
        fscs = append(fscs, parse_float(sc))
    }
    let n = len(mems)
    if n <= 1 {
        return (mems, scs)
    }
    let gaps = [701, 301, 132, 57, 23, 10, 4, 1]
    let mut gi = 0
    while gi < len(gaps) {
        let gap = gaps[gi]
        if gap < n {
            let mut i = gap
            while i < n {
                let tm = mems[i]
                let ts = scs[i]
                let tf = fscs[i]
                let mut j = i
                while j >= gap {
                    let pf = fscs[j - gap]
                    let mut move_it = 0
                    if pf > tf {
                        move_it = 1
                    } else if pf == tf and str_lt(tm, mems[j - gap]) == 1 {
                        move_it = 1
                    }
                    if move_it == 0 {
                        break
                    }
                    mems[j] = mems[j - gap]
                    scs[j] = scs[j - gap]
                    fscs[j] = pf
                    j = j - gap
                }
                mems[j] = tm
                scs[j] = ts
                fscs[j] = tf
                i = i + 1
            }
        }
        gi = gi + 1
    }
    return (mems, scs)
}

fn slice_skip_take(xs: []string, skip: int, take: int) -> []string {
    let n = len(xs)
    let none: []string = []
    if skip >= n or take <= 0 {
        return none
    }
    let mut i = skip
    if i < 0 {
        i = 0
    }
    let mut out = make([]string, 0, take)
    let mut c = 0
    while i < n and c < take {
        out = append(out, xs[i])
        i = i + 1
        c = c + 1
    }
    return out
}


fn Store_charge(mut self: Store, n: int) -> int {
    self.used = self.used + n
    if self.used < 0 {
        self.used = 0
    }
    return self.used
}

fn finite_score(s: string) -> int {
    if str_len(s) == 0 {
        return 0
    }
    let u = str_to_lower(s)
    if str_eq(u, "nan") or str_eq(u, "inf") or str_eq(u, "+inf") or str_eq(u, "-inf") or str_eq(u, "infinity") or str_eq(u, "+infinity") or str_eq(u, "-infinity") {
        return 0
    }
    let mut i = 0
    if str_byte_at(s, 0) == 43 or str_byte_at(s, 0) == 45 {
        i = 1
    }
    if i >= str_len(s) {
        return 0
    }
    let mut dot = 0
    let mut digits = 0
    while i < str_len(s) {
        let c = str_byte_at(s, i)
        if c == 46 {
            if dot == 1 {
                return 0
            }
            dot = 1
        } else if c >= 48 and c <= 57 {
            digits = 1
        } else if c == 101 or c == 69 {
            if digits == 0 {
                return 0
            }
            i = i + 1
            if i < str_len(s) and (str_byte_at(s, i) == 43 or str_byte_at(s, i) == 45) {
                i = i + 1
            }
            if i >= str_len(s) {
                return 0
            }
            while i < str_len(s) {
                let ec = str_byte_at(s, i)
                if ec < 48 or ec > 57 {
                    return 0
                }
                i = i + 1
            }
            return 1
        } else {
            return 0
        }
        i = i + 1
    }
    return digits
}

fn Store_drop_key(mut self: Store, ik: string) -> int {
    if not has(self.types, ik) {
        return 0
    }
    let n = self.payload_bytes(ik)
    let t = self.types[ik]
    if t == T_STR {
        delete(self.strs, ik)
    } else if t == T_HASH {
        if len(self.xseq) > 0 and has(self.xseq, hk_has(ik)) {
            if has(self.hashes, ik) {
                let h = self.hashes[ik]
                for f, _ in range h {
                    delete(self.xseq, hk_exp(ik, f))
                }
            }
            delete(self.xseq, hk_has(ik))
        }
        delete(self.hashes, ik)
    } else if t == T_LIST {
        delete(self.lists, ik)
        if len(self.xseq) > 0 {
            delete(self.xseq, lk_head(ik))
        }
    } else if t == T_SET {
        if len(self.xseq) > 0 and has(self.xseq, sk_has(ik)) {
            if has(self.sets, ik) {
                for m, _ in range self.sets[ik] {
                    delete(self.xseq, sk_exp(ik, m))
                }
            }
            delete(self.xseq, sk_has(ik))
        }
        delete(self.sets, ik)
    } else if t == T_ZSET {
        if len(self.xseq) > 0 and has(self.xseq, zk_has(ik)) {
            if has(self.zsets, ik) {
                for m, _ in range self.zsets[ik] {
                    delete(self.xseq, zk_exp(ik, m))
                }
            }
            delete(self.xseq, zk_has(ik))
        }
        delete(self.zsets, ik)
    } else if t == T_STREAM {
        delete(self.streams, ik)
        delete(self.xseq, ik)
        let pref = ik + "\u001e"
        let mut gks = make([]string, 0, 4)
        for gk, _ in range self.xg {
            if str_has_prefix(gk, pref) {
                gks = append(gks, gk)
            }
        }
        let mut gi = 0
        while gi < len(gks) {
            delete(self.xg, gks[gi])
            delete(self.xp, gks[gi])
            gi = gi + 1
        }
    } else if t == T_VEC {
        delete(self.vecs, ik)
        delete(self.vtxt, ik)
        delete(self.vdim, ik)
    }
    delete(self.types, ik)
    delete(self.expire, ik)
    delete(self.atime, ik)
    self.scrub_graph(ik)
    self.charge(0 - n)
    return 1
}

fn Store_touch(mut self: Store, ik: string) {
    if self.maxmem > 0 or (self.ops & 7) == 0 {
        self.atime[ik] = self.ops
    }
}

fn Store_active_expire(mut self: Store, limit: int) -> int {
    if len(self.expire) == 0 {
        return 0
    }
    let now = wall_ms()
    let mut drop = make([]string, 0, 8)
    let mut scanned = 0
    let max_scan = limit * 2
    for ik, at in range self.expire {
        if at <= now {
            drop = append(drop, ik)
            if len(drop) >= limit {
                break
            }
        }
        scanned = scanned + 1
        if scanned >= max_scan {
            break
        }
    }
    let mut i = 0
    while i < len(drop) {
        if len(self.xp) > 0 and has(self.xp, REACT_NAMES) {
            self.xp["\u001eReactExpKey\u001e"] = ukey(drop[i])
            self.xseq["\u001eReactExpDb\u001e"] = kdb(drop[i])
        }
        let _ = self.drop_key(drop[i])
        i = i + 1
    }
    return len(drop)
}

fn Store_evict_one(mut self: Store, _n: int) -> int {
    let mut victim = ""
    let mut best = 1000000000
    let mut sampled = 0
    let now = wall_ms()
    for ik, _ in range self.types {
        if len(self.expire) > 0 and has(self.expire, ik) {
            if self.expire[ik] <= now {
                victim = ik
                break
            }
        }
        let mut a = 0
        if has(self.atime, ik) {
            a = self.atime[ik]
        }
        if str_eq(victim, "") or a < best {
            victim = ik
            best = a
        }
        sampled = sampled + 1
        if sampled >= 16 {
            break
        }
    }
    if str_eq(victim, "") {
        return 0
    }
    return self.drop_key(victim)
}

fn Store_maybe_evict(mut self: Store, _n: int) -> int {
    if self.maxmem <= 0 or self.used <= self.maxmem {
        return 0
    }
    if len(self.expire) > 0 {
        let _ = self.active_expire(32)
    }
    let _ = self.recount(0)
    if self.used <= self.maxmem {
        return 0
    }
    let mut n = 0
    while self.used > self.maxmem and n < 1024 {
        if self.evict_one(0) == 0 {
            break
        }
        n = n + 1
    }
    if n > 0 {
        log_evict(n, self.used, self.maxmem)
    }
    return n
}

fn Store_hash_sweep(mut self: Store, ik: string) -> int {
    if not has(self.hashes, ik) {
        delete(self.xseq, hk_has(ik))
        return 0
    }
    let now = wall_ms()
    let mut h = self.hashes[ik]
    let mut drop = make([]string, 0, 4)
    let mut rem_exp = 0
    for f, _ in range h {
        let ek = hk_exp(ik, f)
        if has(self.xseq, ek) {
            if self.xseq[ek] <= now {
                drop = append(drop, f)
            } else {
                rem_exp = rem_exp + 1
            }
        }
    }
    if len(drop) > 0 {
        let mut i = 0
        while i < len(drop) {
            delete(h, drop[i])
            delete(self.xseq, hk_exp(ik, drop[i]))
            i = i + 1
        }
        if rem_exp == 0 {
            delete(self.xseq, hk_has(ik))
        }
        if len(h) == 0 {
            let _ = self.drop_key(ik)
            return 0
        }
        self.hashes[ik] = h
    } else if rem_exp == 0 {
        delete(self.xseq, hk_has(ik))
    }
    return 1
}

fn Store_set_sweep(mut self: Store, ik: string) -> int {
    if not has(self.sets, ik) {
        delete(self.xseq, sk_has(ik))
        return 0
    }
    let now = wall_ms()
    let mut s = self.sets[ik]
    let mut drop = make([]string, 0, 4)
    let mut rem_exp = 0
    for m, _ in range s {
        let ek = sk_exp(ik, m)
        if has(self.xseq, ek) {
            if self.xseq[ek] <= now {
                drop = append(drop, m)
            } else {
                rem_exp = rem_exp + 1
            }
        }
    }
    if len(drop) > 0 {
        let mut i = 0
        while i < len(drop) {
            delete(s, drop[i])
            delete(self.xseq, sk_exp(ik, drop[i]))
            i = i + 1
        }
        if rem_exp == 0 {
            delete(self.xseq, sk_has(ik))
        }
        if len(s) == 0 {
            let _ = self.drop_key(ik)
            return 0
        }
        self.sets[ik] = s
    } else if rem_exp == 0 {
        delete(self.xseq, sk_has(ik))
    }
    return 1
}

fn Store_zset_sweep(mut self: Store, ik: string) -> int {
    if not has(self.zsets, ik) {
        delete(self.xseq, zk_has(ik))
        return 0
    }
    let now = wall_ms()
    let mut z = self.zsets[ik]
    let mut drop = make([]string, 0, 4)
    let mut rem_exp = 0
    for m, _ in range z {
        let ek = zk_exp(ik, m)
        if has(self.xseq, ek) {
            if self.xseq[ek] <= now {
                drop = append(drop, m)
            } else {
                rem_exp = rem_exp + 1
            }
        }
    }
    if len(drop) > 0 {
        let mut i = 0
        while i < len(drop) {
            delete(z, drop[i])
            delete(self.xseq, zk_exp(ik, drop[i]))
            i = i + 1
        }
        if rem_exp == 0 {
            delete(self.xseq, zk_has(ik))
        }
        if len(z) == 0 {
            let _ = self.drop_key(ik)
            return 0
        }
        self.zsets[ik] = z
    } else if rem_exp == 0 {
        delete(self.xseq, zk_has(ik))
    }
    return 1
}

fn Store_live(mut self: Store, ik: string) -> int {
    if not has(self.types, ik) {
        return 0
    }
    if len(self.expire) > 0 and has(self.expire, ik) {
        if self.expire[ik] <= wall_ms() {
            if len(self.xp) > 0 and has(self.xp, REACT_NAMES) {
                self.xp["\u001eReactExpKey\u001e"] = ukey(ik)
                self.xseq["\u001eReactExpDb\u001e"] = kdb(ik)
            }
            let _ = self.drop_key(ik)
            return 0
        }
    }
    if len(self.xseq) > 0 {
        let t = self.types[ik]
        if t == T_HASH and has(self.xseq, hk_has(ik)) {
            if self.hash_sweep(ik) == 0 {
                return 0
            }
        } else if t == T_SET and has(self.xseq, sk_has(ik)) {
            if self.set_sweep(ik) == 0 {
                return 0
            }
        } else if t == T_ZSET and has(self.xseq, zk_has(ik)) {
            if self.zset_sweep(ik) == 0 {
                return 0
            }
        }
    }
    self.touch(ik)
    return 1
}

fn Store_kind(mut self: Store, ik: string) -> int {
    if self.live(ik) == 0 {
        return T_NONE
    }
    return self.types[ik]
}

fn Store_set_expire_at(mut self: Store, ik: string, at: int) {
    if at <= 0 {
        delete(self.expire, ik)
    } else {
        self.expire[ik] = at
    }
}

fn Store_maybe_defttl(mut self: Store, ik: string) {
    if self.defttl > 0 {
        self.set_expire_at(ik, wall_ms() + self.defttl)
    }
}

fn Store_kver(mut self: Store, ik: string) -> int {
    let mut v = self.gen
    if has(self.vers, ik) {
        v = v + self.vers[ik]
    }
    return v
}

fn Store_note_write(mut self: Store, ik: string) {
    let mut v = 0
    if has(self.vers, ik) {
        v = self.vers[ik]
    }
    self.vers[ik] = v + 1
}

fn Store_bump_argv(mut self: Store, db: int, argv: []string) {
    let cmd = cmd_name(argv)
    if str_eq(cmd, "FLUSHALL") or str_eq(cmd, "FLUSHDB") {
        self.gen = self.gen + 1
        return
    }
    if str_eq(cmd, "MSET") or str_eq(cmd, "MSETNX") {
        let mut i = 1
        while i < len(argv) {
            self.note_write(ikey(db, argv[i]))
            i = i + 2
        }
        return
    }
    if str_eq(cmd, "DEL") or str_eq(cmd, "UNLINK") or str_eq(cmd, "TOUCH") {
        let mut i = 1
        while i < len(argv) {
            self.note_write(ikey(db, argv[i]))
            i = i + 1
        }
        return
    }
    if str_eq(cmd, "RPOPLPUSH") or str_eq(cmd, "MOVE") {
        if len(argv) >= 3 {
            self.note_write(ikey(db, argv[1]))
            if str_eq(cmd, "RPOPLPUSH") {
                self.note_write(ikey(db, argv[2]))
            }
        }
        return
    }
    if str_eq(cmd, "RENAME") or str_eq(cmd, "RENAMENX") or str_eq(cmd, "COPY") or str_eq(cmd, "LMOVE") or str_eq(cmd, "SMOVE") {
        if len(argv) >= 3 {
            self.note_write(ikey(db, argv[1]))
            self.note_write(ikey(db, argv[2]))
        }
        return
    }
    if str_eq(cmd, "BITOP") and len(argv) >= 3 {
        self.note_write(ikey(db, argv[2]))
        return
    }
    if str_eq(cmd, "ZUNIONSTORE") and len(argv) >= 2 {
        self.note_write(ikey(db, argv[1]))
        return
    }
    if len(argv) >= 2 {
        self.note_write(ikey(db, argv[1]))
    }
}

fn Store_cmd_kver(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("kver")
    }
    return r_int(self.kver(ikey(db, argv[1])))
}

fn Store_apply(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) == 0 {
        return r_err("ERR empty command")
    }
    self.ops = self.ops + 1
    if (self.ops & 63) == 0 and len(self.expire) > 0 {
        let _ = self.active_expire(16)
    }
    let cmd = cmd_name(argv)
    let w = is_write_cmd(cmd)
    let mut b_before = 0
    let mut used_before = self.used
    let mut track_ik = ""
    if self.maxmem > 0 and w == 1 and len(argv) >= 2 {
        track_ik = ikey(db, argv[1])
        b_before = self.payload_bytes(track_ik)
    }
    let out = self.dispatch_cmd(db, argv)
    if self.maxmem > 0 and w == 1 {
        if str_eq(cmd, "FLUSHALL") {
            self.used = 0
        } else if str_eq(cmd, "FLUSHDB") or str_eq(cmd, "MSET") or str_eq(cmd, "MSETNX") or str_eq(cmd, "DEL") or str_eq(cmd, "UNLINK") or str_eq(cmd, "RENAME") or str_eq(cmd, "RENAMENX") or str_eq(cmd, "COPY") {
            let _ = self.recount(0)
        } else if str_len(track_ik) > 0 {
            let b_after = self.payload_bytes(track_ik)
            let mut next_used = used_before + (b_after - b_before)
            if next_used < 0 {
                next_used = 0
            }
            self.used = next_used
        }
        let _ = self.maybe_evict(0)
    }
    if w == 1 and str_len(out) > 0 {
        if str_byte_at(out, 0) != 45 and not str_eq(out, r_nil()) {
            self.bump_argv(db, argv)
            if len(argv) >= 2 {
                let ik1 = ikey(db, argv[1])
                if has(self.types, ik1) {
                    self.xp["\u001eLast\u001e" + ik1] = cmd
                }
            }
        }
    }
    return out
}

fn Store_dispatch_cmd(mut self: Store, db: int, argv: []string) -> string {
    let cmd = cmd_name(argv)
    if str_eq(cmd, "GET") {
        return self.cmd_get(db, argv)
    }
    if str_eq(cmd, "SET") {
        return self.cmd_set(db, argv)
    }
    if str_eq(cmd, "SETNX") {
        if len(argv) != 3 {
            return r_arity("setnx")
        }
        return self.cmd_set(db, ["SET", argv[1], argv[2], "NX"])
    }
    if str_eq(cmd, "SETEX") {
        if len(argv) != 4 {
            return r_arity("setex")
        }
        return self.cmd_set(db, ["SET", argv[1], argv[3], "EX", argv[2]])
    }
    if str_eq(cmd, "PSETEX") {
        if len(argv) != 4 {
            return r_arity("psetex")
        }
        return self.cmd_set(db, ["SET", argv[1], argv[3], "PX", argv[2]])
    }
    if str_eq(cmd, "GETSET") {
        return self.cmd_getset(db, argv)
    }
    if str_eq(cmd, "APPEND") {
        return self.cmd_append(db, argv)
    }
    if str_eq(cmd, "STRLEN") {
        return self.cmd_strlen(db, argv)
    }
    if str_eq(cmd, "INCR") {
        if len(argv) != 2 {
            return r_arity("incr")
        }
        return self.cmd_incrby(db, argv[1], 1)
    }
    if str_eq(cmd, "DECR") {
        if len(argv) != 2 {
            return r_arity("decr")
        }
        return self.cmd_incrby(db, argv[1], 0 - 1)
    }
    if str_eq(cmd, "INCRBY") {
        if len(argv) != 3 {
            return r_arity("incrby")
        }
        let n, ok = int_ok(argv[2])
        if ok == 0 {
            return r_notint()
        }
        return self.cmd_incrby(db, argv[1], n)
    }
    if str_eq(cmd, "DECRBY") {
        if len(argv) != 3 {
            return r_arity("decrby")
        }
        let n, ok = int_ok(argv[2])
        if ok == 0 {
            return r_notint()
        }
        return self.cmd_incrby(db, argv[1], 0 - n)
    }
    if str_eq(cmd, "MGET") {
        return self.cmd_mget(db, argv)
    }
    if str_eq(cmd, "MSET") {
        return self.cmd_mset(db, argv, 0)
    }
    if str_eq(cmd, "MSETNX") {
        return self.cmd_mset(db, argv, 1)
    }
    if str_eq(cmd, "DEL") or str_eq(cmd, "UNLINK") {
        return self.cmd_del(db, argv)
    }
    if str_eq(cmd, "EXISTS") {
        return self.cmd_exists(db, argv)
    }
    if str_eq(cmd, "TYPE") {
        return self.cmd_type(db, argv)
    }
    if str_eq(cmd, "EXPIRE") {
        return self.cmd_expire(db, argv, 1000)
    }
    if str_eq(cmd, "PEXPIRE") {
        return self.cmd_expire(db, argv, 1)
    }
    if str_eq(cmd, "EXPIREAT") {
        return self.cmd_expireat(db, argv, 1000)
    }
    if str_eq(cmd, "PEXPIREAT") {
