    let mut s = self.sets[ik]
    let mut n = 0
    let mut i = 2
    while i < len(argv) {
        if not has(s, argv[i]) {
            s[argv[i]] = 1
            n = n + 1
        }
        i = i + 1
    }
    self.sets[ik] = s
    return r_int(n)
}

