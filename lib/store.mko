}

fn Store_cmd_hincrby(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("hincrby")
    }
    let delta, dok = int_ok(argv[3])
    if dok == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    if self.ensure_hash(ik) == 0 {
        return r_wrongtype()
    }
    let mut h = self.hashes[ik]
    let mut cur = 0
    if has(h, argv[2]) {
        let n, ok = int_ok(h[argv[2]])
        if ok == 0 {
            return r_notint()
        }
        cur = n
    }
    if would_overflow_add(cur, delta) == 1 {
        return r_err("ERR increment or decrement would overflow")
    }
    let n = cur + delta
    h[argv[2]] = format_int(n)
    self.hashes[ik] = h
    return r_int(n)
}

fn Store_ensure_list(mut self: Store, ik: string) -> int {
    let t = self.kind(ik)
    if t == T_NONE {
        let xs: []string = []
        self.lists[ik] = xs
        self.types[ik] = T_LIST
        return 1
    }
    if t != T_LIST {
        return 0
    }
    return 1
}

fn Store_cmd_lpush(mut self: Store, db: int, argv: []string, right: int) -> string {
    if len(argv) < 3 {
        return r_arity("lpush")
    }
    let ik = ikey(db, argv[1])
    if self.ensure_list(ik) == 0 {
        return r_wrongtype()
    }
    let mut xs = self.lists[ik]
    let mut i = 2
    while i < len(argv) {
        if right == 1 {
            xs = append(xs, argv[i])
        } else {
            xs = slice_pre(xs, argv[i])
        }
        i = i + 1
    }
    self.lists[ik] = xs
    return r_int(len(xs))
}

fn Store_cmd_lpop(mut self: Store, db: int, argv: []string, right: int) -> string {
    if len(argv) < 2 or len(argv) > 3 {
        return r_arity("lpop")
    }
    let mut count = 1
    let mut with_count = 0
    if len(argv) == 3 {
        let n, ok = int_ok(argv[2])
        if ok == 0 {
            return r_notint()
        }
        count = n
        with_count = 1
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        if with_count == 1 {
            let none: []string = []
            return r_array_bulks(none)
        }
        return r_nil()
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    let xs = self.lists[ik]
    if len(xs) == 0 {
        return r_nil()
    }
    if with_count == 1 {
        let mut n = count
        if n > len(xs) {
            n = len(xs)
        }
        let mut out = make([]string, 0, n)
        let mut rest = xs
        let mut i = 0
        while i < n {
            if right == 1 {
                out = append(out, rest[len(rest) - 1])
                rest = rest[:len(rest) - 1]
            } else {
                out = append(out, rest[0])
                rest = rest[1:]
            }
            i = i + 1
        }
        if len(rest) == 0 {
            let _ = self.drop_key(ik)
        } else {
            self.lists[ik] = rest
        }
        return r_array_bulks(out)
    }
    let mut rest = xs
    let mut v = ""
    if right == 1 {
        v = rest[len(rest) - 1]
        rest = rest[:len(rest) - 1]
    } else {
        v = rest[0]
        rest = rest[1:]
    }
    if len(rest) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.lists[ik] = rest
    }
    return r_bulk(v)
}

fn Store_cmd_lrange(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("lrange")
    }
    let a, ao = int_ok(argv[2])
    let b, bo = int_ok(argv[3])
    if ao == 0 or bo == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        let none: []string = []
        return r_array_bulks(none)
    }
    if t != T_LIST {
        return r_wrongtype()
    }
    return r_array_bulks(slice_range(self.lists[ik], a, b))
}

