}

fn Store_cmd_spop(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 or len(argv) > 3 {
        return r_arity("spop")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        if len(argv) == 3 {
            let none: []string = []
            return r_array_bulks(none)
        }
        return r_nil()
    }
    if t != T_SET {
        return r_wrongtype()
    }
    let mut s = self.sets[ik]
    let mut mems = set_members(s)
    if len(mems) == 0 {
        return r_nil()
    }
    if len(argv) == 2 {
        let i = rand_intn(len(mems))
        let m = mems[i]
        delete(s, m)
        if len(s) == 0 {
            let _ = self.drop_key(ik)
        } else {
            self.sets[ik] = s
        }
        return r_bulk(m)
    }
    let mut n, ok = int_ok(argv[2])
    if ok == 0 or n < 0 {
        return r_err("ERR value is out of range, must be positive")
    }
    if n > len(mems) {
        n = len(mems)
    }
    let mut out = make([]string, 0, n)
    let mut i = 0
    while i < n {
        let j = rand_intn(len(mems) - i)
        let m = mems[j]
        out = append(out, m)
        delete(s, m)
        mems[j] = mems[len(mems) - 1 - i]
        i = i + 1
    }
    if len(s) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.sets[ik] = s
    }
    return r_array_bulks(out)
}

fn Store_cmd_srandmember(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 2 or len(argv) > 3 {
        return r_arity("srandmember")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        if len(argv) == 3 {
            let none: []string = []
            return r_array_bulks(none)
        }
        return r_nil()
    }
    if t != T_SET {
        return r_wrongtype()
    }
    let mut mems = set_members(self.sets[ik])
    if len(mems) == 0 {
        return r_nil()
    }
    if len(argv) == 2 {
        return r_bulk(mems[rand_intn(len(mems))])
    }
    let mut n, ok = int_ok(argv[2])
    if ok == 0 {
        return r_notint()
    }
    if n < 0 {
        n = 0 - n
        if n > 10000 {
            n = 10000
        }
        let mut out = make([]string, 0, n)
        let mut i = 0
        while i < n {
            out = append(out, mems[rand_intn(len(mems))])
            i = i + 1
        }
        return r_array_bulks(out)
    }
    if n > len(mems) {
        n = len(mems)
    }
    let mut out = make([]string, 0, n)
    let mut i = 0
    while i < n {
        let j = rand_intn(len(mems) - i)
        out = append(out, mems[j])
        mems[j] = mems[len(mems) - 1 - i]
        i = i + 1
    }
    return r_array_bulks(out)
}

fn Store_ensure_zset(mut self: Store, ik: string) -> int {
    let t = self.kind(ik)
    if t == T_NONE {
        self.zsets[ik] = make(map[string]string)
        self.types[ik] = T_ZSET
        return 1
    }
    if t != T_ZSET {
        return 0
    }
    return 1
}

fn Store_cmd_zadd(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 4 {
        return r_arity("zadd")
    }
    let mut nx = 0
    let mut xx = 0
    let mut gt = 0
    let mut lt = 0
    let mut ch = 0
    let mut incr = 0
    let mut i = 2
    while i < len(argv) {
        let o = str_to_upper(argv[i])
        if str_eq(o, "NX") {
            nx = 1
            i = i + 1
        } else if str_eq(o, "XX") {
            xx = 1
            i = i + 1
        } else if str_eq(o, "GT") {
            gt = 1
            i = i + 1
        } else if str_eq(o, "LT") {
            lt = 1
            i = i + 1
        } else if str_eq(o, "CH") {
            ch = 1
            i = i + 1
        } else if str_eq(o, "INCR") {
            incr = 1
            i = i + 1
        } else {
            break
        }
    }
    if nx == 1 and xx == 1 {
        return r_err("ERR XX and NX options at the same time are not compatible")
    }
    if (gt == 1 and lt == 1) or (nx == 1 and (gt == 1 or lt == 1)) {
        return r_err("ERR GT, LT, and/or NX options at the same time are not compatible")
    }
    let rem = len(argv) - i
    if rem < 2 or (rem % 2) != 0 {
        return r_syntax()
    }
    if incr == 1 {
        if rem != 2 {
            return r_err("ERR INCR option supports a single increment-element pair")
        }
        if finite_score(argv[i]) == 0 {
            return r_err("ERR value is not a valid float")
        }
        let ik = ikey(db, argv[1])
        let t = self.kind(ik)
        if t != T_NONE and t != T_ZSET {
            return r_wrongtype()
        }
        let exists = if t == T_ZSET and has(self.zsets[ik], argv[i + 1]) { 1 } else { 0 }
        if (nx == 1 and exists == 1) or (xx == 1 and exists == 0) {
            return r_nil()
        }
        return self.cmd_zincrby(db, ["ZINCRBY", argv[1], argv[i], argv[i + 1]])
    }
    let mut vi = i
    while vi + 1 < len(argv) {
        if finite_score(argv[vi]) == 0 {
            return r_err("ERR value is not a valid float")
        }
        vi = vi + 2
    }
    let ik = ikey(db, argv[1])
    if self.ensure_zset(ik) == 0 {
        return r_wrongtype()
    }
    let mut z = self.zsets[ik]
    let mut added = 0
    let mut changed = 0
    while i + 1 < len(argv) {
        let sc_str = argv[i]
        let mem = argv[i + 1]
        let new_sc = parse_float(sc_str)
        if has(z, mem) {
            if nx == 0 {
                let old_sc = parse_float(z[mem])
                let mut allow = 1
                if gt == 1 and new_sc <= old_sc {
                    allow = 0
                }
                if lt == 1 and new_sc >= old_sc {
                    allow = 0
                }
                if allow == 1 {
                    if new_sc != old_sc {
                        changed = changed + 1
                    }
                    z[mem] = sc_str
                }
            }
        } else {
            if xx == 0 {
                z[mem] = sc_str
                added = added + 1
                changed = changed + 1
            }
        }
        i = i + 2
    }
    if len(z) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.zsets[ik] = z
    }
    if ch == 1 {
        return r_int(changed)
    }
    return r_int(added)
}

fn Store_cmd_zrem(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) < 3 {
        return r_arity("zrem")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let mut z = self.zsets[ik]
    let mut n = 0
    let mut i = 2
    while i < len(argv) {
        if has(z, argv[i]) {
            delete(z, argv[i])
            n = n + 1
        }
        i = i + 1
    }
    if len(z) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.zsets[ik] = z
    }
    return r_int(n)
}

fn Store_cmd_zscore(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 3 {
        return r_arity("zscore")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_nil()
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let z = self.zsets[ik]
    if not has(z, argv[2]) {
        return r_nil()
    }
    return r_bulk(z[argv[2]])
}

fn Store_cmd_zcard(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 2 {
        return r_arity("zcard")
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        return r_int(0)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    return r_int(len(self.zsets[ik]))
}

fn Store_cmd_zrange(mut self: Store, db: int, argv: []string, rev: int) -> string {
    if len(argv) < 4 {
        return r_arity("zrange")
    }
    let mut withscores = 0
    let mut byscore = 0
    let mut bylex = 0
    let mut is_rev = rev
    let mut has_limit = 0
    let mut lim_off = 0
    let mut lim_cnt = -1
    let mut fi = 4
    while fi < len(argv) {
        let u = str_to_upper(argv[fi])
        if str_eq(u, "WITHSCORES") {
            withscores = 1
            fi = fi + 1
        } else if str_eq(u, "BYSCORE") {
            byscore = 1
            fi = fi + 1
        } else if str_eq(u, "BYLEX") {
            bylex = 1
            fi = fi + 1
        } else if str_eq(u, "REV") {
            is_rev = 1
            fi = fi + 1
        } else if str_eq(u, "LIMIT") and fi + 2 < len(argv) {
            let lo, loo = int_ok(argv[fi + 1])
            let lc, lco = int_ok(argv[fi + 2])
            if loo == 0 or lco == 0 {
                return r_notint()
            }
            has_limit = 1
            lim_off = lo
            lim_cnt = lc
            fi = fi + 3
        } else {
            return r_syntax()
        }
    }
    if byscore == 1 and bylex == 1 {
        return r_syntax()
    }
    if byscore == 1 {
        let mut sub = make([]string, 0, 8)
        if is_rev == 1 {
            sub = append(sub, "ZREVRANGEBYSCORE")
        } else {
            sub = append(sub, "ZRANGEBYSCORE")
        }
        sub = append(sub, argv[1])
        sub = append(sub, argv[2])
        sub = append(sub, argv[3])
        if withscores == 1 {
            sub = append(sub, "WITHSCORES")
        }
        if has_limit == 1 {
            sub = append(sub, "LIMIT")
            sub = append(sub, fmt_int_fast(lim_off))
            sub = append(sub, fmt_int_fast(lim_cnt))
        }
        if is_rev == 1 {
            return self.cmd_zrevrangebyscore(db, sub)
        }
        return self.cmd_zrangebyscore(db, sub)
    }
    if bylex == 1 {
        if withscores == 1 {
            return r_syntax()
        }
        let mut sub = make([]string, 0, 7)
        if is_rev == 1 {
            sub = append(sub, "ZREVRANGEBYLEX")
        } else {
            sub = append(sub, "ZRANGEBYLEX")
        }
        sub = append(sub, argv[1])
        sub = append(sub, argv[2])
        sub = append(sub, argv[3])
        if has_limit == 1 {
            sub = append(sub, "LIMIT")
            sub = append(sub, fmt_int_fast(lim_off))
            sub = append(sub, fmt_int_fast(lim_cnt))
        }
        return self.cmd_zrangebylex(db, sub, is_rev)
    }
    if has_limit == 1 {
        return r_err("ERR syntax error, LIMIT is only supported in combination with either BYSCORE or BYLEX")
    }
    let a, ao = int_ok(argv[2])
    let b, bo = int_ok(argv[3])
    if ao == 0 or bo == 0 {
        return r_notint()
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        let none: []string = []
        return r_array_bulks(none)
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let mems, scs = z_sorted(self.zsets[ik])
    let n = len(mems)
    let mut start = a
    let mut stop = b
    if start < 0 {
        start = n + start
    }
    if stop < 0 {
        stop = n + stop
    }
    if start < 0 {
        start = 0
    }
    if stop >= n {
        stop = n - 1
    }
    let none: []string = []
    if n == 0 or start > stop or start >= n {
        return r_array_bulks(none)
    }
    let mut items = make([]string, 0, (stop - start + 1) * 2)
    if is_rev == 1 {
        let mut i = n - 1 - start
        let end = n - 1 - stop
        while i >= end and i >= 0 {
            items = append(items, mems[i])
            if withscores == 1 {
                items = append(items, scs[i])
            }
            i = i - 1
        }
    } else {
        let mut i = start
        while i <= stop {
            items = append(items, mems[i])
            if withscores == 1 {
                items = append(items, scs[i])
            }
            i = i + 1
        }
    }
    return r_array_bulks(items)
}

fn Store_cmd_zrank(mut self: Store, db: int, argv: []string, rev: int) -> string {
    if len(argv) < 3 or len(argv) > 4 {
        return r_arity("zrank")
    }
    let mut withscore = 0
    if len(argv) == 4 {
        if str_eq(str_to_upper(argv[3]), "WITHSCORE") {
            withscore = 1
        } else {
            return r_syntax()
        }
    }
    let ik = ikey(db, argv[1])
    let t = self.kind(ik)
    if t == T_NONE {
        if withscore == 1 {
            return "*-1\r\n"
        }
        return r_nil()
    }
    if t != T_ZSET {
        return r_wrongtype()
    }
    let z = self.zsets[ik]
    if not has(z, argv[2]) {
        if withscore == 1 {
            return "*-1\r\n"
        }
        return r_nil()
    }
    let mems, scs = z_sorted(z)
    let mut i = 0
    while i < len(mems) {
        if str_eq(mems[i], argv[2]) {
            let mut rnk = i
            if rev == 1 {
                rnk = len(mems) - 1 - i
            }
            if withscore == 1 {
                return "*2\r\n" + r_int(rnk) + r_bulk(scs[i])
            }
            return r_int(rnk)
        }
        i = i + 1
    }
    return r_nil()
}

fn Store_cmd_zincrby(mut self: Store, db: int, argv: []string) -> string {
    if len(argv) != 4 {
        return r_arity("zincrby")
    }
    if finite_score(argv[2]) == 0 {
        return r_err("ERR value is not a valid float")
    }
    let ik = ikey(db, argv[1])
    if self.ensure_zset(ik) == 0 {
        return r_wrongtype()
    }
    let mut z = self.zsets[ik]
    let mut cur = 0.0
    if has(z, argv[3]) {
        cur = parse_float(z[argv[3]])
    }
    let n = cur + parse_float(argv[2])
    let s = format_float(n, 17)
    z[argv[3]] = s
    self.zsets[ik] = z
    return r_bulk(s)
}

fn Store_cmd_dumpkv(mut self: Store, db: int) -> string {
    let keys = self.collect_keys(db, "*")
    return r_array_bulks(keys)
}

fn Store_cmd_export(mut self: Store, db: int) -> string {
    let keys = self.collect_keys(db, "*")
    let b = str_builder()
    let mut i = 0
    while i < len(keys) {
        builder_write(b, self.export_one(db, keys[i]))
        i = i + 1
    }
    return r_bulk(builder_string(b))
}

fn parse_job(msg: string) -> (string, int, []string, int) {
    let empty: []string = []
    let n = str_len(msg)
    if n == 0 {
        return ("", 0, empty, 0)
    }
    let nl = find_nl(msg, 0)
    if nl < 0 {
        return ("", 0, empty, 0)
    }
    let id = msg[:nl]
    let nl2 = find_nl(msg, nl + 1)
    if nl2 < 0 {
        return (id, 0, empty, 0)
    }
    let db = int_of(msg[nl + 1:nl2])
    let nl3 = find_nl(msg, nl2 + 1)
    if nl3 < 0 {
        return (id, db, empty, 0)
    }
    let argc = int_of(msg[nl2 + 1:nl3])
    let mut pos = nl3 + 1
    let mut argv = make([]string, 0, argc)
    let mut i = 0
    while i < argc {
        let nln = find_nl(msg, pos)
        if nln < 0 {
            return (id, db, empty, 0)
        }
        let ln = int_of(msg[pos:nln])
        pos = nln + 1
        if pos + ln > n {
            return (id, db, empty, 0)
        }
        argv = append(argv, msg[pos:pos + ln])
        pos = pos + ln
        i = i + 1
    }
    return (id, db, argv, 1)
}

fn encode_job(id: string, db: int, argv: []string) -> string {
    let b = str_builder()
    builder_write(b, id)
    builder_write(b, "\n")
    builder_write(b, fmt_int_fast(db))
    builder_write(b, "\n")
    builder_write(b, fmt_int_fast(len(argv)))
    builder_write(b, "\n")
    let mut i = 0
    while i < len(argv) {
        builder_write(b, fmt_int_fast(str_len(argv[i])))
        builder_write(b, "\n")
        builder_write(b, argv[i])
        i = i + 1
    }
    return builder_string(b)
}

fn Store_exec_one(mut self: Store, db: int, argv: []string) -> string {
    let out = self.apply(db, argv)
    // fire REACT triggers after write, delete, or expire
    if len(self.xp) > 0 and has(self.xp, REACT_NAMES) {
        if has(self.xp, "\u001eReactExpKey\u001e") and str_len(self.xp["\u001eReactExpKey\u001e"]) > 0 {
            let exp_key = self.xp["\u001eReactExpKey\u001e"]
            let exp_db = self.xseq["\u001eReactExpDb\u001e"]
            self.xp["\u001eReactExpKey\u001e"] = ""
            self.xp["\u001eReactCurEvt\u001e"] = "EXPIRE"
            let ecmds = self.react_collect(exp_db, exp_key, "")
            if len(ecmds) > 0 {
                self.xp["\u001eReactFiring\u001e"] = "1"
                let mut prev_res = ""
                let mut ei = 0
                while ei < len(ecmds) {
                    let mut eargv = react_decode_argv(ecmds[ei])
                    if str_len(prev_res) > 0 {
                        let epay = react_result_payload(prev_res)
                        let mut esi = 0
                        while esi < len(eargv) {
                            if str_contains(eargv[esi], "$RESULT") {
                                eargv[esi] = react_replace(eargv[esi], "$RESULT", epay)
                            }
                            esi = esi + 1
                        }
                    }
                    if len(eargv) > 0 {
                        prev_res = self.dispatch_cmd(exp_db, eargv)
                    }
                    ei = ei + 1
                }
                self.xp["\u001eReactFiring\u001e"] = ""
            }
        }
        if len(argv) >= 2 and str_len(out) > 0 and str_byte_at(out, 0) != 45 {
            let cname = cmd_name(argv)
            let gkey = "\u001eReactGlobs\u001e" + fmt_int_fast(db)
            if is_write_cmd(cname) == 1 and (has(self.xp, REACT_IDX + ikey(db, argv[1])) or (has(self.xp, gkey) and str_len(self.xp[gkey]) > 0)) {
                let mut rval = ""
                if len(argv) >= 3 {
                    rval = argv[2]
                }
                if str_eq(cname, "DEL") or str_eq(cname, "UNLINK") or str_eq(cname, "GETDEL") or str_eq(cname, "HGETDEL") or str_eq(cname, "CAD") or str_eq(cname, "DELEX") {
                    self.xp["\u001eReactCurEvt\u001e"] = "DELETE"
                } else {
                    self.xp["\u001eReactCurEvt\u001e"] = "WRITE"
                }
                let react_cmds = self.react_collect(db, argv[1], rval)
                if len(react_cmds) > 0 {
                    self.xp["\u001eReactFiring\u001e"] = "1"
                    let mut prev_result = ""
                    let mut ri = 0
                    while ri < len(react_cmds) {
                        let mut rargv = react_decode_argv(react_cmds[ri])
                        if str_len(prev_result) > 0 {
                            let payload = react_result_payload(prev_result)
                            let mut si = 0
                            while si < len(rargv) {
                                if str_contains(rargv[si], "$RESULT") {
                                    rargv[si] = react_replace(rargv[si], "$RESULT", payload)
                                }
                                si = si + 1
                            }
                        }
                        if len(rargv) > 0 {
                            prev_result = self.dispatch_cmd(db, rargv)
                        }
                        ri = ri + 1
                    }
                    self.xp["\u001eReactFiring\u001e"] = ""
                }
            }
        }
    }
    return out
}

fn shard_loop(rx: chan[string], replies: CMap, maxmem: int, defttl: int) -> int {
    let mut st = new_store()
    st.maxmem = maxmem
    st.defttl = defttl
    while true {
        let msg = rx.recv()
        if str_eq(msg, "STOP") {
            break
        }
        let id, db, argv, ok = parse_job(msg)
        if ok == 0 {
            if str_len(id) > 0 {
                cmap_set(replies, id, r_err("ERR bad job"))
            }
            continue
        }
        if len(argv) >= 2 and str_eq(argv[0], "__BATCH") {
            let b = str_builder()
            let mut bi = 1
            while bi < len(argv) {
                let n = int_of(argv[bi])
                if n <= 0 or bi + 1 + n > len(argv) {
                    break
                }
                let mut sub = make([]string, 0, n)
                let mut bj = 0
                while bj < n {
                    sub = append(sub, argv[bi + 1 + bj])
                    bj = bj + 1
                }
                bi = bi + 1 + n
                if len(sub) == 3 and str_eq(cmd_name(sub), "LPUSH") and (len(st.xp) == 0 or not has(st.xp, REACT_NAMES)) {
                    let lkey = sub[1]
                    let mut m_argv = make([]string, 0, 16)
                    m_argv = append(m_argv, "LPUSH")
                    m_argv = append(m_argv, lkey)
                    m_argv = append(m_argv, sub[2])
                    let mut m_cnt = 1
                    while bi < len(argv) {
                        let n2 = int_of(argv[bi])
                        if n2 != 3 or bi + 4 > len(argv) {
                            break
                        }
                        if not str_eq(str_to_upper(argv[bi + 1]), "LPUSH") or not str_eq(argv[bi + 2], lkey) {
                            break
                        }
                        m_argv = append(m_argv, argv[bi + 3])
                        m_cnt = m_cnt + 1
                        bi = bi + 4
                    }
                    if m_cnt > 1 {
                        let lr = st.exec_one(db, m_argv)
                        if str_has_prefix(lr, ":") {
                            let end_len = parse_int_reply(lr)
                            let start_len = end_len - m_cnt + 1
                            let mut li = 0
                            while li < m_cnt {
                                builder_write(b, r_int(start_len + li))
                                li = li + 1
                            }
                            continue
                        }
                    }
                }
                builder_write(b, st.exec_one(db, sub))
            }
            cmap_set(replies, id, builder_string(b))
            continue
        }
        let out = st.exec_one(db, argv)
        cmap_set(replies, id, out)
    }
    return 0
}

// Keep Store_* symbols in the native signature table so method calls lower.
fn touch_store_methods() -> int {
    let mut st = new_store()
    let a = ["GET", "k", "v", "0"]
    let _ = Store_drop_key(st, "k")
    let _ = Store_live(st, "k")
    let _ = Store_kind(st, "k")
    Store_set_expire_at(st, "k", 0)
    let _ = Store_apply(st, 0, a)
    let _ = Store_cmd_get(st, 0, a)
    let _ = Store_cmd_set(st, 0, a)
    let _ = Store_cmd_getset(st, 0, a)
    let _ = Store_cmd_append(st, 0, a)
    let _ = Store_cmd_strlen(st, 0, a)
    let _ = Store_cmd_incrby(st, 0, "k", 1)
    let _ = Store_cmd_mget(st, 0, a)
    let _ = Store_cmd_mset(st, 0, a, 0)
    let _ = Store_cmd_del(st, 0, a)
    let _ = Store_cmd_exists(st, 0, a)
    let _ = Store_cmd_type(st, 0, a)
    let _ = Store_cmd_expire(st, 0, a, 1000)
    let _ = Store_cmd_expireat(st, 0, a, 1000)
    let _ = Store_cmd_ttl(st, 0, a, 1000)
    let _ = Store_cmd_persist(st, 0, a)
    let _ = Store_cmd_rename(st, 0, a, 0)
    let _ = Store_collect_keys(st, 0, "*")
    let _ = Store_collect_keys_lim(st, 0, "*", 8)
    let _ = Store_cmd_keys(st, 0, a)
    let _ = Store_cmd_hotkeys(st, 0, a)
    Store_maybe_defttl(st, "k")
    let _ = Store_cmd_scan(st, 0, a)
    let _ = Store_cmd_randomkey(st, 0)
    let _ = Store_cmd_dbsize(st, 0)
    let _ = Store_cmd_flush(st, 0, 0)
    let _ = Store_ensure_hash(st, "k")
    let _ = Store_cmd_hset(st, 0, a, 0)
    let _ = Store_cmd_hget(st, 0, a)
    let _ = Store_cmd_hmget(st, 0, a)
    let _ = Store_cmd_hgetall(st, 0, a)
    let _ = Store_cmd_hdel(st, 0, a)
    let _ = Store_cmd_hexists(st, 0, a)
    let _ = Store_cmd_hkeys(st, 0, a, 0)
    let _ = Store_cmd_hlen(st, 0, a)
    let _ = Store_cmd_hincrby(st, 0, a)
    let _ = Store_ensure_list(st, "k")
    let _ = Store_cmd_lpush(st, 0, a, 0)
    let _ = Store_cmd_lpop(st, 0, a, 0)
