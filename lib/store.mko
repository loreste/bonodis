    let mut i = 2
    while i < len(argv) {
        if has(s, argv[i]) {
            delete(s, argv[i])
            n = n + 1
        }
        i = i + 1
    }
    if len(s) == 0 {
        let _ = self.drop_key(ik)
    } else {
        self.sets[ik] = s
    }
    return r_int(n)
}

